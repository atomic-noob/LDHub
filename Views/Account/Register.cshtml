@model LDHub.Models.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Create Account — DENR L&D Hub";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css" />

    <style>
        :root {
            --denr-dark: #0b5d43;
            --denr-green: #117554;
            --denr-mid: #4bb543;
            --denr-light: #9bec00;

            --glass-bg: rgba(255,255,255,.075);
            --glass-border: rgba(255,255,255,.14);
            --text-muted: rgba(255,255,255,.62);
            --danger: #ff7373;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;

            background:
                linear-gradient(
                    rgba(4, 35, 25, .68),
                    rgba(4, 35, 25, .80)
                ),
                url('/dist/img/denrbg.jpg')
                center center / cover no-repeat fixed;
        }

        /* =========================================================
           PAGE
        ========================================================= */

        .registration-page {
            min-height: 100vh;
        }

        .registration-row {
            min-height: 100vh;
            margin: 0;
        }

        /* =========================================================
           LEFT PANEL
        ========================================================= */

        .left-panel {
            position: sticky;
            top: 0;

            min-height: 100vh;
            height: 100vh;

            padding: 55px 48px;

            display: flex;
            flex-direction: column;
            justify-content: center;

            color: #fff;

            background:
                linear-gradient(
                    145deg,
                    rgba(11,93,67,.94),
                    rgba(17,117,84,.90),
                    rgba(75,181,67,.78)
                );

            border-right: 1px solid rgba(255,255,255,.12);

            box-shadow:
                15px 0 40px rgba(0,0,0,.12);

            overflow: hidden;
        }

        .left-panel::before {
            content: "";
            position: absolute;

            width: 280px;
            height: 280px;

            border-radius: 50%;

            background: rgba(155,236,0,.10);

            top: -90px;
            right: -100px;
        }

        .left-panel::after {
            content: "";
            position: absolute;

            width: 220px;
            height: 220px;

            border-radius: 50%;

            background: rgba(255,255,255,.06);

            bottom: -100px;
            left: -80px;
        }

        .left-content {
            position: relative;
            z-index: 2;
        }

        /* Brand */

        .brand {
            display: flex;
            align-items: center;

            margin-bottom: 45px;
        }

        .brand-logo {
            width: 62px;
            height: 62px;

            border-radius: 50%;
            object-fit: cover;

            border: 3px solid rgba(255,255,255,.78);

            box-shadow:
                0 8px 22px rgba(0,0,0,.18);

            margin-right: 15px;
        }

        .brand-title {
            font-size: 1.35rem;
            font-weight: 800;

            letter-spacing: .4px;

            line-height: 1.2;
        }

        .brand-subtitle {
            display: block;

            margin-top: 3px;

            font-size: .76rem;
            font-weight: 500;

            color: rgba(255,255,255,.73);
        }

        /* Introduction */

        .left-panel h1 {
            font-size: 2.25rem;
            font-weight: 800;

            line-height: 1.25;

            margin-bottom: 17px;
        }

        .hero-text {
            max-width: 470px;

            color: rgba(255,255,255,.82);

            font-size: .96rem;
            line-height: 1.75;

            margin-bottom: 32px;
        }

        /* Benefits */

        .benefits {
            margin-top: 5px;
        }

        .benefit-item {
            display: flex;
            align-items: center;

            padding: 12px 14px;

            margin-bottom: 10px;

            border-radius: 12px;

            background: rgba(255,255,255,.075);

            border: 1px solid rgba(255,255,255,.08);

            transition: .25s ease;
        }

        .benefit-item:hover {
            transform: translateX(5px);

            background: rgba(255,255,255,.11);
        }

        .benefit-icon {
            width: 42px;
            height: 42px;

            flex-shrink: 0;

            border-radius: 11px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-right: 13px;

            background: rgba(255,255,255,.14);

            color: #caff56;

            font-size: 1rem;
        }

        .benefit-text strong {
            display: block;

            font-size: .91rem;
            font-weight: 700;
        }

        .benefit-text span {
            display: block;

            margin-top: 2px;

            font-size: .78rem;

            color: rgba(255,255,255,.65);
        }

        /* Login */

        .login-box {
            margin-top: 35px;

            padding-top: 20px;

            border-top: 1px solid rgba(255,255,255,.13);

            font-size: .88rem;

            color: rgba(255,255,255,.72);
        }

        .login-box a {
            margin-left: 4px;

            color: #caff56;

            font-weight: 700;

            text-decoration: none;
        }

        .login-box a:hover {
            color: #fff;
            text-decoration: underline;
        }

        /* =========================================================
           RIGHT PANEL
        ========================================================= */

        .right-panel {
            min-height: 100vh;

            padding: 45px 55px 60px;

            background: rgba(7,24,17,.34);

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .registration-container {
            width: 100%;
            max-width: 1050px;

            margin: 0 auto;
        }

        /* Header */

        .form-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;

            gap: 20px;

            margin-bottom: 27px;
        }

        .form-header h2 {
            margin: 0 0 7px;

            color: #fff;

            font-size: 1.75rem;
            font-weight: 800;
        }

        .form-header p {
            margin: 0;

            color: var(--text-muted);

            font-size: .89rem;
            line-height: 1.6;
        }

        .secure-badge {
            flex-shrink: 0;

            display: inline-flex;
            align-items: center;

            padding: 8px 12px;

            border-radius: 50px;

            background: rgba(75,181,67,.13);

            border: 1px solid rgba(155,236,0,.22);

            color: #aaf338;

            font-size: .75rem;
            font-weight: 600;
        }

        .secure-badge i {
            margin-right: 6px;
        }

        /* =========================================================
           FORM CARD
        ========================================================= */

        .form-card {
            padding: 30px;

            border-radius: 20px;

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.085),
                    rgba(255,255,255,.035)
                );

            border: 1px solid rgba(255,255,255,.13);

            box-shadow:
                0 20px 45px rgba(0,0,0,.15);
        }

        /* =========================================================
           SECTION
        ========================================================= */

        .form-section {
            margin-bottom: 28px;
        }

        .form-section:last-of-type {
            margin-bottom: 15px;
        }

        .section-heading {
            display: flex;
            align-items: center;

            gap: 10px;

            margin-bottom: 17px;
        }

        .section-icon {
            width: 35px;
            height: 35px;

            display: flex;
            align-items: center;
            justify-content: center;

            flex-shrink: 0;

            border-radius: 9px;

            color: #c5ff54;

            background: rgba(75,181,67,.13);

            border: 1px solid rgba(155,236,0,.15);
        }

        .section-title {
            color: #c5ff54;

            font-size: .78rem;
            font-weight: 800;

            text-transform: uppercase;
            letter-spacing: 1.4px;

            white-space: nowrap;
        }

        .section-line {
            flex-grow: 1;

            height: 1px;

            background:
                linear-gradient(
                    90deg,
                    rgba(155,236,0,.15),
                    rgba(255,255,255,.03)
                );
        }

        /* =========================================================
           INPUTS
        ========================================================= */

        .glass-field {
            margin-bottom: 16px;
        }

        .glass-field label {
            display: block;

            margin-bottom: 6px;

            color: rgba(255,255,255,.76);

            font-size: .81rem;
            font-weight: 600;
        }

        .required-star {
            color: #ff7777;

            margin-left: 2px;
        }

        .glass-control {
            width: 100%;
            min-height: 45px;

            padding: 10px 13px !important;

            border-radius: 9px !important;

            background: rgba(255,255,255,.065) !important;

            border: 1px solid rgba(255,255,255,.13) !important;

            color: #fff !important;

            font-size: .88rem !important;

            transition:
                border-color .2s ease,
                background .2s ease,
                box-shadow .2s ease;
        }

        .glass-control:hover {
            border-color: rgba(255,255,255,.23) !important;
        }

        .glass-control:focus {
            background: rgba(255,255,255,.10) !important;

            border-color: rgba(75,181,67,.90) !important;

            box-shadow:
                0 0 0 3px rgba(75,181,67,.14) !important;

            outline: none !important;
        }

        .glass-control::placeholder {
            color: rgba(255,255,255,.30) !important;
        }

        select.glass-control option {
            background: #153126;

            color: #fff;
        }

        select.glass-control:disabled {
            cursor: not-allowed;

            opacity: .55;
        }

        /* Input group */

        .password-wrapper {
            position: relative;
        }

        .password-wrapper .glass-control {
            padding-right: 48px !important;
        }

        .password-toggle {
            position: absolute;

            top: 50%;
            right: 6px;

            transform: translateY(-50%);

            width: 38px;
            height: 36px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 0;
            outline: 0;

            border-radius: 7px;

            background: transparent;

            color: rgba(255,255,255,.48);

            cursor: pointer;
        }

        .password-toggle:hover {
            background: rgba(255,255,255,.07);

            color: #a9ef3c;
        }

        /* =========================================================
           PROFILE PHOTO
        ========================================================= */

        .photo-card {
            display: flex;
            align-items: center;

            gap: 24px;

            padding: 22px;

            margin-bottom: 22px;

            border-radius: 15px;

            background:
                linear-gradient(
                    135deg,
                    rgba(75,181,67,.08),
                    rgba(255,255,255,.035)
                );

            border: 1px solid rgba(155,236,0,.14);
        }

        .photo-preview-wrapper {
            position: relative;

            width: 115px;
            height: 115px;

            flex-shrink: 0;
        }

        .photo-preview {
            width: 115px;
            height: 115px;

            border-radius: 50%;

            object-fit: cover;

            background: rgba(255,255,255,.08);

            border: 4px solid rgba(155,236,0,.50);

            box-shadow:
                0 8px 25px rgba(0,0,0,.22);
        }

        .camera-badge {
            position: absolute;

            right: 2px;
            bottom: 4px;

            width: 35px;
            height: 35px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            color: #fff;

            background:
                linear-gradient(
                    135deg,
                    var(--denr-light),
                    var(--denr-mid),
                    var(--denr-green)
                );

            border: 3px solid #183428;

            box-shadow:
                0 4px 10px rgba(0,0,0,.18);
        }

        .photo-content {
            min-width: 0;

            flex-grow: 1;
        }

        .photo-title {
            display: block;

            color: #fff;

            font-size: .94rem;
            font-weight: 700;

            margin-bottom: 4px;
        }

        .photo-description {
            color: rgba(255,255,255,.54);

            font-size: .79rem;
            line-height: 1.6;

            margin-bottom: 12px;
        }

        .photo-actions {
            display: flex;
            align-items: center;

            flex-wrap: wrap;

            gap: 10px;
        }

        .btn-photo {
            display: inline-flex;
            align-items: center;

            padding: 9px 15px;

            margin: 0;

            border-radius: 8px;

            background: rgba(75,181,67,.16);

            border: 1px solid rgba(155,236,0,.25);

            color: #bdf547;

            font-size: .8rem;
            font-weight: 700;

            cursor: pointer;

            transition: .2s ease;
        }

        .btn-photo:hover {
            transform: translateY(-1px);

            background: rgba(75,181,67,.26);

            color: #fff;
        }

        .btn-remove-photo {
            display: none;

            border: 0;

            background: transparent;

            color: #ff8686;

            font-size: .78rem;

            cursor: pointer;
        }

        .btn-remove-photo:hover {
            color: #ffb0b0;
            text-decoration: underline;
        }

        .photo-file-name {
            display: block;

            max-width: 100%;

            margin-top: 9px;

            color: rgba(255,255,255,.43);

            font-size: .74rem;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* =========================================================
           PASSWORD STRENGTH
        ========================================================= */

        .password-strength {
            margin-top: 8px;
        }

        .strength-track {
            width: 100%;
            height: 5px;

            overflow: hidden;

            border-radius: 30px;

            background: rgba(255,255,255,.09);
        }

        .strength-fill {
            width: 0;
            height: 100%;

            border-radius: 30px;

            transition:
                width .25s ease,
                background .25s ease;
        }

        .strength-info {
            display: flex;
            justify-content: space-between;

            margin-top: 5px;

            font-size: .71rem;

            color: rgba(255,255,255,.43);
        }

        /* Confirm status */

        .password-match {
            display: block;

            min-height: 17px;

            margin-top: 5px;

            font-size: .73rem;
        }

        /* =========================================================
           VALIDATION
        ========================================================= */

        .field-validation-error,
        .text-danger {
            display: block;

            margin-top: 5px;

            color: var(--danger) !important;

            font-size: .75rem;
        }

        .input-validation-error {
            border-color: rgba(255,103,103,.65) !important;

            box-shadow:
                0 0 0 2px rgba(255,103,103,.08) !important;
        }

        /* =========================================================
           ALERTS
        ========================================================= */

        .glass-alert {
            display: flex;
            align-items: flex-start;

            padding: 13px 15px;

            margin-bottom: 20px;

            border-radius: 10px;

            font-size: .84rem;
        }

        .glass-alert i {
            margin-top: 2px;
            margin-right: 9px;
        }

        .glass-alert-error {
            color: #ff9c9c;

            background: rgba(220,53,69,.12);

            border: 1px solid rgba(255,107,107,.20);
        }

        .glass-alert-success {
            color: #bfff55;

            background: rgba(75,181,67,.12);

            border: 1px solid rgba(155,236,0,.18);
        }

        /* =========================================================
           SUBMIT
        ========================================================= */

        .submission-area {
            padding-top: 8px;
        }

        .btn-submit {
            width: 100%;

            min-height: 51px;

            display: flex;
            align-items: center;
            justify-content: center;

            gap: 9px;

            border: none;
            border-radius: 11px;

            color: #fff;

            background:
                linear-gradient(
                    135deg,
                    #77cf23,
                    #42aa43,
                    #117554
                );

            font-size: .95rem;
            font-weight: 700;

            box-shadow:
                0 8px 22px rgba(75,181,67,.25);

            cursor: pointer;

            transition: .25s ease;
        }

        .btn-submit:hover:not(:disabled) {
            transform: translateY(-2px);

            box-shadow:
                0 12px 28px rgba(75,181,67,.32);
        }

        .btn-submit:disabled {
            cursor: not-allowed;

            opacity: .72;
        }

        .registration-note {
            margin: 15px 0 0;

            text-align: center;

            color: rgba(255,255,255,.45);

            font-size: .77rem;

            line-height: 1.5;
        }

        .registration-note i {
            color: rgba(155,236,0,.7);

            margin-right: 4px;
        }

        /* =========================================================
           MOBILE LOGIN
        ========================================================= */

        .mobile-login {
            display: none;

            margin-top: 20px;

            text-align: center;

            color: rgba(255,255,255,.55);

            font-size: .82rem;
        }

        .mobile-login a {
            color: #aaf03e;

            font-weight: 700;
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 1199px) {

            .left-panel {
                padding: 45px 35px;
            }

            .right-panel {
                padding: 40px;
            }

            .left-panel h1 {
                font-size: 2rem;
            }
        }

        @@media (max-width: 991px) {

            .left-panel {
                display: none;
            }

            .right-panel {
                padding: 35px 25px 50px;

                background: rgba(6,25,17,.60);
            }

            .mobile-login {
                display: block;
            }
        }

        @@media (max-width: 767px) {

            .form-card {
                padding: 22px 18px;
            }

            .form-header {
                display: block;
            }

            .secure-badge {
                margin-top: 15px;
            }

            .photo-card {
                align-items: flex-start;
            }
        }

        @@media (max-width: 575px) {

            .right-panel {
                padding: 25px 14px 40px;
            }

            .form-header h2 {
                font-size: 1.45rem;
            }

            .form-card {
                padding: 19px 15px;
                border-radius: 15px;
            }

            .photo-card {
                flex-direction: column;
                align-items: center;

                text-align: center;
            }

            .photo-actions {
                justify-content: center;
            }

            .photo-content {
                width: 100%;
            }

            .section-title {
                font-size: .72rem;
            }
        }
    </style>
</head>

<body>

<div class="container-fluid registration-page p-0">

    <div class="row registration-row no-gutters">

        @* =====================================================
           LEFT PANEL
        ===================================================== *@

        <div class="col-lg-4 left-panel">

            <div class="left-content">

                <div class="brand">

                    <img src="~/dist/img/denrlogo.jpg"
                         class="brand-logo"
                         alt="DENR Logo" />

                    <div>
                        <div class="brand-title">
                            DENR L&amp;D Hub
                        </div>

                        <span class="brand-subtitle">
                            Learning &amp; Development Portal
                        </span>
                    </div>

                </div>

                <h1>
                    Grow your skills.<br />
                    Build your future.
                </h1>

                <p class="hero-text">
                    Join the DENR Learning and Development Hub and gain
                    access to training programs, assessments, learning
                    materials, and professional development opportunities.
                </p>

                <div class="benefits">

                    <div class="benefit-item">

                        <div class="benefit-icon">
                            <i class="fas fa-graduation-cap"></i>
                        </div>

                        <div class="benefit-text">
                            <strong>Learning Programs</strong>
                            <span>
                                Access DENR training programs and learning modules.
                            </span>
                        </div>

                    </div>

                    <div class="benefit-item">

                        <div class="benefit-icon">
                            <i class="fas fa-clipboard-check"></i>
                        </div>

                        <div class="benefit-text">
                            <strong>Online Assessments</strong>
                            <span>
                                Complete pre-tests, post-tests and other assessments.
                            </span>
                        </div>

                    </div>

                    <div class="benefit-item">

                        <div class="benefit-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>

                        <div class="benefit-text">
                            <strong>Track Development</strong>
                            <span>
                                Monitor your training history and learning progress.
                            </span>
                        </div>

                    </div>

                    <div class="benefit-item">

                        <div class="benefit-icon">
                            <i class="fas fa-award"></i>
                        </div>

                        <div class="benefit-text">
                            <strong>Training Certificates</strong>
                            <span>
                                Keep your completed learning credentials organized.
                            </span>
                        </div>

                    </div>

                </div>

                <div class="login-box">

                    Already registered?

                    <a href="@Url.Action("Login", "Home")">
                        Sign in to your account
                        <i class="fas fa-arrow-right ml-1"></i>
                    </a>

                </div>

            </div>

        </div>


        @* =====================================================
           RIGHT PANEL
        ===================================================== *@

        <div class="col-lg-8 right-panel">

            <div class="registration-container">

                <div class="form-header">

                    <div>

                        <h2>
                            <i class="fas fa-user-plus mr-2"
                               style="color:#74ce39;"></i>

                            Create Your Account
                        </h2>

                        <p>
                            Complete the registration form below.
                            Your account will be reviewed by an administrator
                            before activation.
                        </p>

                    </div>

                    <div class="secure-badge">
                        <i class="fas fa-shield-alt"></i>
                        Secure Registration
                    </div>

                </div>


                @* =================================================
                   ALERTS
                ================================================= *@

                @if (TempData["Error"] != null)
                {
                    <div class="glass-alert glass-alert-error">

                        <i class="fas fa-exclamation-circle"></i>

                        <div>
                            @TempData["Error"]
                        </div>

                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="glass-alert glass-alert-success">

                        <i class="fas fa-check-circle"></i>

                        <div>
                            @TempData["Success"]
                        </div>

                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="glass-alert glass-alert-error">

                        <i class="fas fa-exclamation-triangle"></i>

                        <div>
                            Please review the highlighted fields and correct
                            the information before submitting.
                        </div>

                    </div>
                }


                <div class="form-card">

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post"
                          enctype="multipart/form-data"
                          id="registrationForm">

                        @Html.AntiForgeryToken()


                        @* =================================================
                           PROFILE PHOTO
                        ================================================= *@

                        <div class="form-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fas fa-camera"></i>
                                </div>

                                <div class="section-title">
                                    Profile Photo
                                </div>

                                <div class="section-line"></div>

                            </div>

                            <div class="photo-card">

                                <div class="photo-preview-wrapper">

                                    <img id="photoPreview"
                                         class="photo-preview"
                                         src="~/dist/img/default-user.png"
                                         alt="Profile photo preview"
                                         onerror="this.src='https://via.placeholder.com/115?text=Photo';" />

                                    <div class="camera-badge">
                                        <i class="fas fa-camera"></i>
                                    </div>

                                </div>

                                <div class="photo-content">

                                    <span class="photo-title">
                                        Add your profile picture
                                    </span>

                                    <div class="photo-description">
                                        Upload a clear and recent photo.
                                        Accepted formats are JPG, JPEG, PNG and WEBP.
                                        Maximum file size is 5 MB.
                                    </div>

                                    <div class="photo-actions">

                                        <label for="photoInput"
                                               class="btn-photo">

                                            <i class="fas fa-cloud-upload-alt mr-2"></i>
                                            Choose Photo

                                        </label>

                                        <button type="button"
                                                class="btn-remove-photo"
                                                id="removePhoto">

                                            <i class="fas fa-times mr-1"></i>
                                            Remove

                                        </button>

                                    </div>

                                    <input asp-for="Photo"
                                           id="photoInput"
                                           type="file"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                           hidden />

                                    <span id="photoFileName"
                                          class="photo-file-name">
                                        No photo selected
                                    </span>

                                    <span asp-validation-for="Photo"
                                          class="text-danger"></span>

                                </div>

                            </div>

                        </div>


                        @* =================================================
                           PERSONAL INFORMATION
                        ================================================= *@

                        <div class="form-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fas fa-user"></i>
                                </div>

                                <div class="section-title">
                                    Personal Information
                                </div>

                                <div class="section-line"></div>

                            </div>


                            <div class="row">

                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="FirstName">
                                            First Name
                                            <span class="required-star">*</span>
                                        </label>

                                        <input asp-for="FirstName"
                                               class="form-control glass-control"
                                               placeholder="e.g. Juan"
                                               autocomplete="given-name" />

                                        <span asp-validation-for="FirstName"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="MiddleName">
                                            Middle Name
                                        </label>

                                        <input asp-for="MiddleName"
                                               class="form-control glass-control"
                                               placeholder="e.g. Santos"
                                               autocomplete="additional-name" />

                                        <span asp-validation-for="MiddleName"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="LastName">
                                            Last Name
                                            <span class="required-star">*</span>
                                        </label>

                                        <input asp-for="LastName"
                                               class="form-control glass-control"
                                               placeholder="e.g. Dela Cruz"
                                               autocomplete="family-name" />

                                        <span asp-validation-for="LastName"
                                              class="text-danger"></span>

                                    </div>

                                </div>

                            </div>


                            <div class="row">

                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="Gender">
                                            Gender
                                            <span class="required-star">*</span>
                                        </label>

                                        <select asp-for="Gender"
                                                class="form-control glass-control">

                                            <option value="">
                                                -- Select Gender --
                                            </option>

                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                            <option value="Other">Other</option>

                                            <option value="Prefer not to say">
                                                Prefer not to say
                                            </option>

                                        </select>

                                        <span asp-validation-for="Gender"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="Age">
                                            Age
                                            <span class="required-star">*</span>
                                        </label>

                                        <input asp-for="Age"
                                               type="number"
                                               min="18"
                                               max="100"
                                               class="form-control glass-control"
                                               placeholder="e.g. 25" />

                                        <span asp-validation-for="Age"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="ContactNumber">
                                            Contact Number
                                            <span class="required-star">*</span>
                                        </label>

                                        <input asp-for="ContactNumber"
                                               class="form-control glass-control"
                                               placeholder="09XXXXXXXXX"
                                               autocomplete="tel"
                                               maxlength="15" />

                                        <span asp-validation-for="ContactNumber"
                                              class="text-danger"></span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        @* =================================================
                           WORK INFORMATION
                        ================================================= *@

                        <div class="form-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fas fa-building"></i>
                                </div>

                                <div class="section-title">
                                    Work Information
                                </div>

                                <div class="section-line"></div>

                            </div>


                            <div class="row">

                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="RegionId">
                                            Region
                                            <span class="required-star">*</span>
                                        </label>

                                        <select asp-for="RegionId"
                                                id="regionSelect"
                                                class="form-control glass-control">

                                            <option value="">
                                                -- Select Region --
                                            </option>

                                            @foreach (
                                                var region in
                                                ViewBag.Regions
                                                as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                                                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>()
                                            )
                                            {
                                                <option value="@region.Value">
                                                    @region.Text
                                                </option>
                                            }

                                        </select>

                                        <span asp-validation-for="RegionId"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="OfficeId">
                                            Office
                                            <span class="required-star">*</span>
                                        </label>

                                        <select asp-for="OfficeId"
                                                id="officeSelect"
                                                class="form-control glass-control"
                                                disabled>

                                            <option value="">
                                                -- Select Office --
                                            </option>

                                        </select>

                                        <span asp-validation-for="OfficeId"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="DivisionId">
                                            Division
                                            <span class="required-star">*</span>
                                        </label>

                                        <select asp-for="DivisionId"
                                                id="divisionSelect"
                                                class="form-control glass-control"
                                                disabled>

                                            <option value="">
                                                -- Select Division --
                                            </option>

                                        </select>

                                        <span asp-validation-for="DivisionId"
                                              class="text-danger"></span>

                                    </div>

                                </div>

                            </div>


                            <div class="row">

                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="Position">
                                            Position
                                            <span class="required-star">*</span>
                                        </label>

                                        <input asp-for="Position"
                                               class="form-control glass-control"
                                               placeholder="e.g. Forester II" />

                                        <span asp-validation-for="Position"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="Designation">
                                            Designation
                                        </label>

                                        <input asp-for="Designation"
                                               class="form-control glass-control"
                                               placeholder="e.g. Division Chief" />

                                        <span asp-validation-for="Designation"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-4">

                                    <div class="glass-field">

                                        <label asp-for="SalaryGrade">
                                            Salary Grade
                                        </label>

                                        <input asp-for="SalaryGrade"
                                               type="number"
                                               min="1"
                                               max="33"
                                               class="form-control glass-control"
                                               placeholder="e.g. 18" />

                                        <span asp-validation-for="SalaryGrade"
                                              class="text-danger"></span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        @* =================================================
                           ACCOUNT CREDENTIALS
                        ================================================= *@

                        <div class="form-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fas fa-shield-alt"></i>
                                </div>

                                <div class="section-title">
                                    Account Credentials
                                </div>

                                <div class="section-line"></div>

                            </div>


                            <div class="row">

                                <div class="col-md-12">

                                    <div class="glass-field">

                                        <label asp-for="Email">
                                            Email Address
                                            <span class="required-star">*</span>
                                        </label>

                                        <input asp-for="Email"
                                               type="email"
                                               class="form-control glass-control"
                                               placeholder="juan.delacruz@denr.gov.ph"
                                               autocomplete="email" />

                                        <span asp-validation-for="Email"
                                              class="text-danger"></span>

                                    </div>

                                </div>

                            </div>


                            <div class="row">

                                <div class="col-md-6">

                                    <div class="glass-field">

                                        <label asp-for="Password">
                                            Password
                                            <span class="required-star">*</span>
                                        </label>

                                        <div class="password-wrapper">

                                            <input asp-for="Password"
                                                   id="passwordInput"
                                                   type="password"
                                                   class="form-control glass-control"
                                                   placeholder="Enter password"
                                                   autocomplete="new-password" />

                                            <button type="button"
                                                    class="password-toggle"
                                                    data-target="#passwordInput"
                                                    aria-label="Show password">

                                                <i class="fas fa-eye"></i>

                                            </button>

                                        </div>

                                        <div class="password-strength">

                                            <div class="strength-track">
                                                <div class="strength-fill"
                                                     id="strengthFill"></div>
                                            </div>

                                            <div class="strength-info">

                                                <span id="strengthText">
                                                    Enter a password
                                                </span>

                                                <span>
                                                    Min. 8 characters
                                                </span>

                                            </div>

                                        </div>

                                        <span asp-validation-for="Password"
                                              class="text-danger"></span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="glass-field">

                                        <label asp-for="ConfirmPassword">
                                            Confirm Password
                                            <span class="required-star">*</span>
                                        </label>

                                        <div class="password-wrapper">

                                            <input asp-for="ConfirmPassword"
                                                   id="confirmInput"
                                                   type="password"
                                                   class="form-control glass-control"
                                                   placeholder="Re-enter password"
                                                   autocomplete="new-password" />

                                            <button type="button"
                                                    class="password-toggle"
                                                    data-target="#confirmInput"
                                                    aria-label="Show confirm password">

                                                <i class="fas fa-eye"></i>

                                            </button>

                                        </div>

                                        <span id="passwordMatch"
                                              class="password-match"></span>

                                        <span asp-validation-for="ConfirmPassword"
                                              class="text-danger"></span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        @* =================================================
                           SUBMIT
                        ================================================= *@

                        <div class="submission-area">

                            <button type="submit"
                                    id="submitButton"
                                    class="btn-submit">

                                <i class="fas fa-user-check"></i>

                                <span id="submitButtonText">
                                    Submit Registration
                                </span>

                            </button>

                            <p class="registration-note">

                                <i class="fas fa-info-circle"></i>

                                Your registration will be submitted for
                                administrator review. You will be able to
                                access the L&amp;D Hub once your account
                                has been approved and activated.

                            </p>

                        </div>

                    </form>

                </div>


                <div class="mobile-login">

                    Already have an account?

                    <a href="@Url.Action("Login", "Home")">
                        Sign in here
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/plugins/jquery-validation/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>


<script>
$(function () {

    // =========================================================
    // URLs
    // =========================================================

    const getOfficesUrl =
        '@Url.Action("GetOffices", "Account")';

    const getDivisionsUrl =
        '@Url.Action("GetDivisions", "Account")';


    // =========================================================
    // VALUES TO RESTORE AFTER SERVER-SIDE VALIDATION
    // =========================================================

    const initialRegionId =
        $('#regionSelect').val();

    const initialOfficeId =
        '@(Model?.OfficeId ?? 0)';

    const initialDivisionId =
        '@(Model?.DivisionId ?? 0)';


    // =========================================================
    // PROFILE PHOTO
    // =========================================================

    const defaultPhoto =
        '@Url.Content("~/dist/img/default-user.png")';

    $('#photoInput').on('change', function () {

        const file = this.files && this.files[0];

        if (!file) {
            resetPhoto();
            return;
        }

        const validTypes = [
            'image/jpeg',
            'image/png',
            'image/webp'
        ];

        const maxSize =
            5 * 1024 * 1024;

        if (!validTypes.includes(file.type)) {

            alert(
                'Please select a JPG, JPEG, PNG or WEBP image.'
            );

            resetPhoto();

            return;
        }

        if (file.size > maxSize) {

            alert(
                'The selected profile photo exceeds the 5 MB limit.'
            );

            resetPhoto();

            return;
        }

        const reader =
            new FileReader();

        reader.onload = function (event) {

            $('#photoPreview').attr(
                'src',
                event.target.result
            );

        };

        reader.readAsDataURL(file);

        $('#photoFileName').text(
            file.name
        );

        $('#removePhoto').show();

    });


    $('#removePhoto').on('click', function () {
        resetPhoto();
    });


    function resetPhoto() {

        $('#photoInput').val('');

        $('#photoPreview').attr(
            'src',
            defaultPhoto
        );

        $('#photoFileName').text(
            'No photo selected'
        );

        $('#removePhoto').hide();
    }


    // =========================================================
    // PASSWORD SHOW / HIDE
    // =========================================================

    $('.password-toggle').on('click', function () {

        const target =
            $($(this).data('target'));

        const icon =
            $(this).find('i');

        const isPassword =
            target.attr('type') === 'password';

        target.attr(
            'type',
            isPassword ? 'text' : 'password'
        );

        icon.toggleClass(
            'fa-eye fa-eye-slash'
        );

    });


    // =========================================================
    // PASSWORD STRENGTH
    // =========================================================

    $('#passwordInput').on('input', function () {

        const value =
            $(this).val();

        let strength = 0;

        if (value.length >= 8)
            strength++;

        if (/[a-z]/.test(value) &&
            /[A-Z]/.test(value))
            strength++;

        if (/[0-9]/.test(value))
            strength++;

        if (/[^A-Za-z0-9]/.test(value))
            strength++;


        let text = 'Enter a password';
        let color = 'transparent';

        switch (strength) {

            case 1:
                text = 'Weak';
                color = '#ff7373';
                break;

            case 2:
                text = 'Fair';
                color = '#f6b73c';
                break;

            case 3:
                text = 'Good';
                color = '#9bec00';
                break;

            case 4:
                text = 'Strong';
                color = '#4bb543';
                break;
        }


        if (value.length === 0) {

            $('#strengthFill').css({
                width: '0%',
                background: 'transparent'
            });

            $('#strengthText')
                .css('color', 'rgba(255,255,255,.43)')
                .text('Enter a password');

        }
        else {

            $('#strengthFill').css({
                width: (strength * 25) + '%',
                background: color
            });

            $('#strengthText')
                .css('color', color)
                .text(text);
        }

        checkPasswordMatch();

    });


    // =========================================================
    // CONFIRM PASSWORD MATCH
    // =========================================================

    $('#confirmInput').on(
        'input',
        checkPasswordMatch
    );


    function checkPasswordMatch() {

        const password =
            $('#passwordInput').val();

        const confirm =
            $('#confirmInput').val();

        const label =
            $('#passwordMatch');

        if (!confirm) {

            label.text('');

            return;
        }

        if (password === confirm) {

            label
                .css('color', '#9bec00')
                .html(
                    '<i class="fas fa-check-circle mr-1"></i>Passwords match'
                );

        }
        else {

            label
                .css('color', '#ff7373')
                .html(
                    '<i class="fas fa-times-circle mr-1"></i>Passwords do not match'
                );
        }

    }


    // =========================================================
    // REGION → OFFICE
    // =========================================================

    $('#regionSelect').on('change', function () {

        const regionId =
            $(this).val();

        clearOffice();
        clearDivision();

        if (!regionId)
            return;

        loadOffices(
            regionId,
            null
        );

    });


    function loadOffices(
        regionId,
        selectedOfficeId
    ) {

        const officeSelect =
            $('#officeSelect');

        officeSelect
            .prop('disabled', true)
            .html(
                '<option value="">Loading offices...</option>'
            );


        $.getJSON(
            getOfficesUrl,
            {
                regionId: regionId
            }
        )
        .done(function (data) {

            officeSelect.html(
                '<option value="">-- Select Office --</option>'
            );


            $.each(
                data,
                function (_, office) {

                    const option =
                        $('<option></option>')
                            .val(office.value)
                            .text(office.text);

                    if (
                        selectedOfficeId &&
                        String(office.value) ===
                        String(selectedOfficeId)
                    ) {
                        option.prop(
                            'selected',
                            true
                        );
                    }

                    officeSelect.append(
                        option
                    );

                }
            );


            officeSelect.prop(
                'disabled',
                false
            );


            if (
                selectedOfficeId &&
                selectedOfficeId !== '0'
            ) {

                loadDivisions(
                    selectedOfficeId,
                    initialDivisionId
                );

            }

        })
        .fail(function () {

            officeSelect
                .html(
                    '<option value="">Unable to load offices</option>'
                )
                .prop(
                    'disabled',
                    true
                );

        });

    }


    // =========================================================
    // OFFICE → DIVISION
    // =========================================================

    $('#officeSelect').on('change', function () {

        const officeId =
            $(this).val();

        clearDivision();

        if (!officeId)
            return;

        loadDivisions(
            officeId,
            null
        );

    });


    function loadDivisions(
        officeId,
        selectedDivisionId
    ) {

        const divisionSelect =
            $('#divisionSelect');

        divisionSelect
            .prop('disabled', true)
            .html(
                '<option value="">Loading divisions...</option>'
            );


        $.getJSON(
            getDivisionsUrl,
            {
                officeId: officeId
            }
        )
        .done(function (data) {

            divisionSelect.html(
                '<option value="">-- Select Division --</option>'
            );


            $.each(
                data,
                function (_, division) {

                    const option =
                        $('<option></option>')
                            .val(division.value)
                            .text(division.text);

                    if (
                        selectedDivisionId &&
                        String(division.value) ===
                        String(selectedDivisionId)
                    ) {
                        option.prop(
                            'selected',
                            true
                        );
                    }

                    divisionSelect.append(
                        option
                    );

                }
            );


            divisionSelect.prop(
                'disabled',
                false
            );

        })
        .fail(function () {

            divisionSelect
                .html(
                    '<option value="">Unable to load divisions</option>'
                )
                .prop(
                    'disabled',
                    true
                );

        });

    }


    function clearOffice() {

        $('#officeSelect')
            .html(
                '<option value="">-- Select Office --</option>'
            )
            .prop(
                'disabled',
                true
            );

    }


    function clearDivision() {

        $('#divisionSelect')
            .html(
                '<option value="">-- Select Division --</option>'
            )
            .prop(
                'disabled',
                true
            );

    }


    // =========================================================
    // RESTORE CASCADING VALUES AFTER VALIDATION ERROR
    // =========================================================

    if (initialRegionId) {

        loadOffices(
            initialRegionId,
            initialOfficeId
        );

    }


    // =========================================================
    // CONTACT NUMBER
    // =========================================================

    $('#ContactNumber').on('input', function () {

        let value =
            $(this).val();

        value =
            value.replace(
                /[^0-9+]/g,
                ''
            );

        $(this).val(
            value
        );

    });


    // =========================================================
    // FORM SUBMISSION
    // =========================================================

    $('#registrationForm').on(
        'submit',
        function () {

            if (
                $(this).valid &&
                !$(this).valid()
            ) {
                return;
            }


            const submitButton =
                $('#submitButton');

            submitButton.prop(
                'disabled',
                true
            );


            $('#submitButtonText').text(
                'Submitting Registration...'
            );


            submitButton
                .find('i')
                .removeClass(
                    'fa-user-check'
                )
                .addClass(
                    'fa-spinner fa-spin'
                );

        }
    );

});
</script>

</body>
</html>