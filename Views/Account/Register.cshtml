@model LDHub.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Register — DENR L&D Hub";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
   <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
<link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
<link rel="stylesheet" href="~/css/auth.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            background: url('/dist/img/denrbg.jpg') center center / cover no-repeat fixed;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-wrapper {
            min-height: 100vh;
            background: rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: stretch;
        }

        /* ── Left Panel ── */
        .left-panel {
            background: linear-gradient(135deg, rgba(17,117,84,0.85), rgba(75,181,67,0.75));
            backdrop-filter: blur(10px);
            color: white;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 100vh;
        }
        .left-panel .brand {
            display: flex;
            align-items: center;
            margin-bottom: 40px;
        }
        .left-panel .brand img {
            width: 55px; height: 55px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,.5);
            margin-right: 15px;
        }
        .left-panel .brand span {
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: .5px;
        }
        .left-panel h2 {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 15px;
            line-height: 1.3;
        }
        .left-panel p {
            font-size: .97rem;
            opacity: .88;
            line-height: 1.7;
            margin-bottom: 35px;
        }
        .left-panel .benefit-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 18px;
        }
        .left-panel .benefit-icon {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: rgba(255,255,255,.2);
            display: flex; align-items: center; justify-content: center;
            font-size: .9rem;
            margin-right: 12px;
            flex-shrink: 0;
            margin-top: 2px;
        }
        .left-panel .benefit-text strong { display: block; font-size: .95rem; }
        .left-panel .benefit-text span  { font-size: .85rem; opacity: .8; }
        .left-panel .login-link {
            margin-top: 40px;
            font-size: .9rem;
            opacity: .85;
        }
        .left-panel .login-link a {
            color: #9BEC00;
            font-weight: 700;
            text-decoration: none;
        }
        .left-panel .login-link a:hover { text-decoration: underline; }

        /* ── Right Panel (Form) ── */
        .right-panel {
            padding: 40px 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(20px);
        }

        .form-header {
            margin-bottom: 30px;
        }
        .form-header h3 {
            font-size: 1.6rem;
            font-weight: 800;
            color: white;
            margin-bottom: 5px;
        }
        .form-header p {
            color: rgba(255,255,255,.6);
            font-size: .9rem;
        }

        /* Section labels */
        .form-section-label {
            color: #9BEC00;
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 12px;
            margin-top: 20px;
            display: flex;
            align-items: center;
        }
        .form-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: rgba(255,255,255,.1);
            margin-left: 10px;
        }

        /* Glass inputs */
        .glass-field {
            margin-bottom: 14px;
        }
        .glass-field label {
            color: rgba(255,255,255,.7);
            font-size: .82rem;
            margin-bottom: 5px;
            display: block;
        }
        .glass-field .form-control,
        .glass-field .form-select,
        .glass-field select {
            background: rgba(255,255,255,0.08) !important;
            border: 1px solid rgba(255,255,255,0.15) !important;
            border-radius: 8px !important;
            color: white !important;
            padding: 10px 14px !important;
            font-size: .9rem !important;
            transition: all .3s;
            width: 100%;
        }
        .glass-field .form-control:focus,
        .glass-field select:focus {
            background: rgba(255,255,255,0.12) !important;
            border-color: #4BB543 !important;
            box-shadow: 0 0 0 3px rgba(75,181,67,0.2) !important;
            outline: none !important;
            color: white !important;
        }
        .glass-field .form-control::placeholder { color: rgba(255,255,255,.35) !important; }
        .glass-field select option { background: #1a2e1a; color: white; }

        /* Validation */
        .glass-field .text-danger { font-size: .78rem; color: #ff6b6b !important; }
        .glass-field .field-validation-error { color: #ff6b6b !important; font-size: .78rem; }

        /* Submit button */
        .btn-glass-submit {
            background: linear-gradient(135deg, #9BEC00, #4BB543, #117554) !important;
            border: none !important;
            border-radius: 10px !important;
            color: white !important;
            font-size: 1rem !important;
            font-weight: 700 !important;
            padding: 13px !important;
            width: 100% !important;
            margin-top: 20px;
            transition: all .3s !important;
            box-shadow: 0 4px 15px rgba(75,181,67,.4) !important;
            cursor: pointer;
        }
        .btn-glass-submit:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 25px rgba(75,181,67,.5) !important;
        }

        /* Alert */
        .glass-alert {
            background: rgba(220,53,69,0.15);
            border: 1px solid rgba(220,53,69,.3);
            border-radius: 8px;
            color: #ff6b6b;
            padding: 10px 15px;
            font-size: .88rem;
            margin-bottom: 16px;
        }
        .glass-alert-success {
            background: rgba(75,181,67,0.15);
            border: 1px solid rgba(75,181,67,.3);
            color: #9BEC00;
        }

        /* Password strength */
        .password-strength {
            margin-top: 5px;
        }
        .strength-bar {
            height: 4px;
            border-radius: 2px;
            background: rgba(255,255,255,.1);
            margin-bottom: 4px;
            overflow: hidden;
        }
        .strength-fill {
            height: 100%;
            border-radius: 2px;
            transition: all .3s;
            width: 0%;
        }
        .strength-text { font-size: .75rem; color: rgba(255,255,255,.5); }

        /* Responsive */
        @@media (max-width: 991px) {
            .left-panel { display: none; }
            .right-panel { padding: 30px 25px; }
        }
        @@media (max-width: 575px) {
            .right-panel { padding: 20px 15px; }
        }
    </style>
</head>
<body>
<div class="register-wrapper">
    <div class="container-fluid p-0">
        <div class="row g-0 min-vh-100">

            @* ── LEFT PANEL ── *@
            <div class="col-lg-4 left-panel">
                <div class="brand">
                    <img src="~/dist/img/denrlogo.jpg" alt="DENR Logo" />
                    <span>DENR L&D Hub</span>
                </div>

                <h2>Join the DENR Learning Community</h2>
                <p>
                    Register to access training programs, learning modules,
                    and professional development resources designed for DENR employees.
                </p>

                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fas fa-book-open"></i></div>
                    <div class="benefit-text">
                        <strong>Access Training Modules</strong>
                        <span>Lectures, activities, quizzes and reading materials</span>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fas fa-file-alt"></i></div>
                    <div class="benefit-text">
                        <strong>Take Pre &amp; Post Tests</strong>
                        <span>Track your learning progress with assessments</span>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fas fa-certificate"></i></div>
                    <div class="benefit-text">
                        <strong>Earn Certificates</strong>
                        <span>Get certified upon completing your training</span>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon"><i class="fas fa-chart-line"></i></div>
                    <div class="benefit-text">
                        <strong>Track Your Progress</strong>
                        <span>Monitor your development journey in real time</span>
                    </div>
                </div>

                <div class="login-link">
                    Already have an account?
                    <a href="@Url.Action("Login", "Home")">Sign in here</a>
                </div>
            </div>

            @* ── RIGHT PANEL (FORM) ── *@
            <div class="col-lg-8 right-panel">

                <div class="form-header">
                    <h3><i class="fas fa-user-plus mr-2" style="color:#4BB543;"></i>Create Your Account</h3>
                    <p>Fill in your details below. Your account will be reviewed by an administrator before activation.</p>
                </div>

                @* Alerts *@
                @if (TempData["Error"] != null)
                {
                    <div class="glass-alert">
                        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="glass-alert glass-alert-success">
                        <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                    </div>
                }
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="glass-alert">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        Please fix the errors below before submitting.
                    </div>
                }

                <form asp-action="Register" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    @* ── Personal Information ── *@
                    <div class="form-section-label">
                        <i class="fas fa-user mr-2"></i>Personal Information
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>First Name <span style="color:#ff6b6b;">*</span></label>
                                <input asp-for="FirstName" class="form-control"
                                       placeholder="Juan" autocomplete="given-name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Middle Name</label>
                                <input asp-for="MiddleName" class="form-control"
                                       placeholder="Santos" autocomplete="additional-name" />
                                <span asp-validation-for="MiddleName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Last Name <span style="color:#ff6b6b;">*</span></label>
                                <input asp-for="LastName" class="form-control"
                                       placeholder="Dela Cruz" autocomplete="family-name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Gender <span style="color:#ff6b6b;">*</span></label>
                                <select asp-for="Gender" class="form-control">
                                    <option value="">-- Select --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                    <option value="Prefer not to say">Prefer not to say</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Age <span style="color:#ff6b6b;">*</span></label>
                                <input asp-for="Age" type="number" min="18" max="100"
                                       class="form-control" placeholder="25" />
                                <span asp-validation-for="Age" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Contact Number <span style="color:#ff6b6b;">*</span></label>
                                <input asp-for="ContactNumber" class="form-control"
                                       placeholder="09XXXXXXXXX" autocomplete="tel" />
                                <span asp-validation-for="ContactNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    @* ── Work Information ── *@
                    <div class="form-section-label">
                        <i class="fas fa-building mr-2"></i>Work Information
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Region <span style="color:#ff6b6b;">*</span></label>
                               <select asp-for="RegionId" class="form-control" id="regionSelect">
                                    <option value="">-- Select Region --</option>
                                    @foreach (var r in ViewBag.Regions as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                                    {
                                        <option value="@r.Value">@r.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="RegionId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Office <span style="color:#ff6b6b;">*</span></label>
                                <select asp-for="OfficeId" class="form-control" id="officeSelect">
                                    <option value="">-- Select Office --</option>
                                </select>
                                <span asp-validation-for="OfficeId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Division <span style="color:#ff6b6b;">*</span></label>
                                <select asp-for="DivisionId" class="form-control" id="divisionSelect">
                                    <option value="">-- Select Division --</option>
                                </select>
                                <span asp-validation-for="DivisionId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    @* ── Add these 3 fields in the Work Information row ── *@
                    <div class="row">
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Position <span style="color:#ff6b6b;">*</span></label>
                                <input asp-for="Position" class="form-control" placeholder="e.g. Forester II" />
                                <span asp-validation-for="Position" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Designation</label>
                                <input asp-for="Designation" class="form-control" placeholder="e.g. Division Chief" />
                                <span asp-validation-for="Designation" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="glass-field">
                                <label>Salary Grade</label>
                                <input asp-for="SalaryGrade" type="number" class="form-control" placeholder="e.g. 18" />
                                <span asp-validation-for="SalaryGrade" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    @* ── Account Credentials ── *@
                    <div class="form-section-label">
                        <i class="fas fa-lock mr-2"></i>Account Credentials
                    </div>
                    <div class="row">
                       <div class="col-md-12">
                            <div class="glass-field">
                                <label>Email Address <span style="color:#ff6b6b;">*</span></label>
                                <input asp-for="Email" type="email" class="form-control"
                                    placeholder="juan.delacruz@denr.gov.ph"
                                    autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                        
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="glass-field">
                                <label>Password <span style="color:#ff6b6b;">*</span></label>
                                <input asp-for="Password" type="password" class="form-control"
                                       placeholder="••••••••" id="passwordInput"
                                       autocomplete="new-password" />
                                <div class="password-strength">
                                    <div class="strength-bar">
                                        <div class="strength-fill" id="strengthFill"></div>
                                    </div>
                                    <span class="strength-text" id="strengthText">Enter a password</span>
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="glass-field">
                                <label>Confirm Password <span style="color:#ff6b6b;">*</span></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control"
                                       placeholder="••••••••" id="confirmInput"
                                       autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-glass-submit">
                        <i class="fas fa-user-plus mr-2"></i>Submit Registration
                    </button>

                    <p class="text-center mt-3" style="color:rgba(255,255,255,.5); font-size:.82rem;">
                        <i class="fas fa-info-circle mr-1"></i>
                        Your account will be reviewed by an administrator before you can log in.
                    </p>

                </form>
            </div>

        </div>
    </div>
</div>
<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/plugins/jquery-validation/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
$(function () {

    // ── Password strength indicator ──
    $('#passwordInput').on('input', function () {
        var val      = $(this).val();
        var strength = 0;
        var text     = '';
        var color    = '';

        if (val.length >= 8)  strength++;
        if (/[A-Z]/.test(val)) strength++;
        if (/[0-9]/.test(val)) strength++;
        if (/[^A-Za-z0-9]/.test(val)) strength++;

        switch (strength) {
            case 0: case 1:
                text = 'Weak'; color = '#ff6b6b'; break;
            case 2:
                text = 'Fair'; color = '#ffa500'; break;
            case 3:
                text = 'Good'; color = '#9BEC00'; break;
            case 4:
                text = 'Strong'; color = '#4BB543'; break;
        }

        $('#strengthFill').css({
            'width': (strength * 25) + '%',
            'background': color
        });
        $('#strengthText').css('color', color).text(text);
    });

    // ── Region → Office cascade ──
    $('#regionSelect').on('change', function () {
        var regionId = $(this).val();
        $('#officeSelect').html('<option value="">-- Select Office --</option>');
        $('#divisionSelect').html('<option value="">-- Select Division --</option>');
        if (!regionId) return;

        $.getJSON('/Account/GetOffices?regionId=' + regionId, function (data) {
            $.each(data, function (i, office) {
                $('#officeSelect').append(
                    '<option value="' + office.value + '">' + office.text + '</option>'
                );
            });
        });
    });

    // ── Office → Division cascade ──
    $('#officeSelect').on('change', function () {
        var officeId = $(this).val();
        $('#divisionSelect').html('<option value="">-- Select Division --</option>');
        if (!officeId) return;

        $.getJSON('/Account/GetDivisions?officeId=' + officeId, function (data) {
            $.each(data, function (i, div) {
                $('#divisionSelect').append(
                    '<option value="' + div.value + '">' + div.text + '</option>'
                );
            });
        });
    });

});
</script>
</body>
</html>
