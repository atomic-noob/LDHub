@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";

    var totalEmployees     = ViewBag.TotalEmployees     as int? ?? 0;
    var totalTrainings     = ViewBag.TotalTrainings     as int? ?? 0;
    var activeTrainings    = ViewBag.ActiveTrainings    as int? ?? 0;
    var completedTrainings = ViewBag.CompletedTrainings as int? ?? 0;
    var pendingCount       = ViewBag.PendingCount       as int? ?? 0;
    var totalSME           = ViewBag.TotalSME           as int? ?? 0;
    var totalUsers         = ViewBag.TotalUsers         as int? ?? 0;
    var passingRate        = ViewBag.PassingRate        as double? ?? 0;
    var passedCount        = ViewBag.PassedCount        as int? ?? 0;
    var failedCount        = ViewBag.FailedCount        as int? ?? 0;
    var totalAttempts      = ViewBag.TotalAttempts      as int? ?? 0;
    var scheduledCount     = ViewBag.ScheduledCount     as int? ?? 0;
    var ongoingCount       = ViewBag.OngoingCount       as int? ?? 0;
    var endedCount         = ViewBag.EndedCount         as int? ?? 0;
    var recentTrainings    = ViewBag.RecentTrainings    as List<LDHub.Models.Training> ?? new List<LDHub.Models.Training>();
    var recentPending      = ViewBag.RecentPending      as List<LDHub.Models.PendingParticipant> ?? new List<LDHub.Models.PendingParticipant>();
}

@section Styles {
    <style>
        .welcome-banner {
            background: linear-gradient(135deg,#117554,#4BB543);
            color:white; border-radius:10px; padding:22px 28px;
            margin-bottom:25px; box-shadow:0 4px 15px rgba(75,181,67,.3);
        }
        .welcome-banner h4 { font-weight:800; margin-bottom:3px; }
        .welcome-banner p  { opacity:.85; margin-bottom:0; font-size:.92rem; }

        .kpi-card {
            background: #ffffff;
            border-radius:10px; padding:18px 20px;
            box-shadow: 0 4px 16px rgba(17,117,84,0.10), 0 1px 4px rgba(250,204,21,0.08);
            margin-bottom:20px;
            display:flex; align-items:center; justify-content:space-between;
            border-left: 4px solid #4BB543;
            transition: box-shadow 0.25s, transform 0.25s;
        }
        .kpi-card:hover {
            box-shadow: 0 8px 24px rgba(17,117,84,0.15), 0 2px 8px rgba(250,204,21,0.12);
            transform: translateY(-2px);
        }
        .kpi-card .num   { font-size:2.2rem; font-weight:800; line-height:1; color:#1b3a2d; }
        .kpi-card .label { font-size:.82rem; color:#6c757d; margin-top:4px; }
        .kpi-card .icon  { font-size:2.8rem; color:#4BB543; opacity:.2; }

        .chart-card { border-radius:10px; box-shadow:0 2px 10px rgba(0,0,0,.08); margin-bottom:20px; }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">Admin Dashboard</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @* Welcome Banner *@
        <div class="welcome-banner">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h4><i class="fas fa-shield-alt mr-2"></i>Welcome, @ViewBag.UserName!</h4>
                    <p>
                        <i class="fas fa-calendar mr-1"></i>
                        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                        &nbsp;|&nbsp; DENR L&amp;D Hub — Administrator Portal
                    </p>
                </div>
                <i class="fas fa-user-shield fa-3x" style="opacity:.3;"></i>
            </div>
        </div>

       @* KPI Cards Row 1 *@
<div class="row">
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@totalEmployees</div><div class="label">Total Employees</div></div>
            <i class="fas fa-users icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@totalTrainings</div><div class="label">Total Trainings</div></div>
            <i class="fas fa-book icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@activeTrainings</div><div class="label">Ongoing Trainings</div></div>
            <i class="fas fa-spinner icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@pendingCount</div><div class="label">Pending Approvals</div></div>
            <i class="fas fa-user-clock icon"></i>
        </div>
    </div>
</div>

@* KPI Cards Row 2 *@
<div class="row">
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@totalSME</div><div class="label">External SME</div></div>
            <i class="fas fa-chalkboard-teacher icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@completedTrainings</div><div class="label">Completed Trainings</div></div>
            <i class="fas fa-check-circle icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@passingRate%</div><div class="label">Overall Passing Rate</div></div>
            <i class="fas fa-chart-line icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@totalUsers</div><div class="label">Total Users</div></div>
            <i class="fas fa-id-card icon"></i>
        </div>
    </div>
</div>

        @* Charts Row 1 *@
        <div class="row">
            @* Monthly Trainings Bar Chart *@
            <div class="col-lg-8">
                <div class="card chart-card">
                    <div class="card-header ">
                        <h3 class="card-title">
                            <i class="fas fa-bar-chart mr-2"></i>Monthly Trainings (@DateTime.Now.Year)
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="monthlyTrainingsChart" height="120"></canvas>
                    </div>
                </div>
            </div>

            @* Training Status Pie Chart *@
            <div class="col-lg-4">
                <div class="card chart-card">
                    <div class="card-header ">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-2"></i>Training Status
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="trainingStatusChart" height="200"></canvas>
                        <div class="mt-3 text-center" style="font-size:.82rem;">
                        <span class="mr-3"><span style="color:#9BEC00;">●</span> Scheduled (@scheduledCount)</span>
                        <span class="mr-3"><span style="color:#4BB543;">●</span> Ongoing (@ongoingCount)</span>
                        <span><span style="color:#117554;">●</span> Ended (@endedCount)</span>
                    </div>
                    </div>
                </div>
            </div>
        </div>

        @* Charts Row 2 *@
        <div class="row">
            @* Employee Registrations Line Chart *@
            <div class="col-lg-6">
                <div class="card chart-card">
                    <div class="card-header ">
                        <h3 class="card-title">
                            <i class="fas fa-chart-line mr-2"></i>Employee Registrations (@DateTime.Now.Year)
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="registrationsChart" height="160"></canvas>
                    </div>
                </div>
            </div>

            @* Pass vs Fail Pie Chart *@
            <div class="col-lg-3">
                <div class="card chart-card">
                    <div class="card-header ">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-2"></i>Pass vs Fail
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (totalAttempts == 0)
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2" style="opacity:.3;"></i>
                                <p class="small">No test attempts yet.</p>
                            </div>
                        }
                        else
                        {
                            <canvas id="passFailChart" height="200"></canvas>
                          <div class="mt-3 text-center" style="font-size:.82rem;">
    <span class="mr-3"><span style="color:#4BB543;">●</span> Passed (@passedCount)</span>
    <span><span style="color:#117554;">●</span> Failed (@failedCount)</span>
</div>
                        }
                    </div>
                </div>
            </div>

            @* Participants per Region *@
            <div class="col-lg-3">
                <div class="card chart-card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-map mr-2"></i>Employees by Region
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="regionChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>

        @* Tables Row *@
        <div class="row">

            @* Recent Trainings *@
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header ">
                        <h3 class="card-title">
                            <i class="fas fa-book mr-2"></i>Recent Trainings
                        </h3>
                        <div class="card-tools">
                           <a asp-controller="Training" asp-action="Index" class="btn btn-sm btn-outline-success">
    <i class="fas fa-list mr-1"></i> View All
</a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (!recentTrainings.Any())
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2" style="opacity:.3;"></i>
                                <p>No trainings yet.</p>
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Training</th>
                                        <th>Region</th>
                                        <th>Date</th>
                                        <th>Participants</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in recentTrainings)
                                    {
                                        var now2   = DateTime.Now;
                                        var status = "Scheduled";
                                        var badge  = "badge-info";
                                        if (t.StartDate.HasValue && t.EndDate.HasValue)
                                        {
                                            if (now2 >= t.StartDate && now2 <= t.EndDate)
                                            { status = "Ongoing";   badge = "badge-success"; }
                                            else if (now2 > t.EndDate)
                                            { status = "Completed"; badge = "badge-secondary"; }
                                        }
                                        <tr>
                                            <td>
                                                <strong>@t.TrainingTitle</strong>
                                                <small class="text-muted d-block">@t.TrainingCode</small>
                                            </td>
                                            <td><small>@(t.Region?.RegionName ?? "—")</small></td>
                                            <td>
                                                <small>
                                                    @(t.StartDate?.ToString("MMM dd") ?? "TBD") —
                                                    @(t.EndDate?.ToString("MMM dd, yyyy") ?? "TBD")
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-light border">
                                                    @t.TrainingParticipants.Count
                                                </span>
                                            </td>
                                            <td><span class="badge @badge">@status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            @* Pending Approvals *@
            <div class="col-lg-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-header ">
                        <h3 class="card-title">
                            <i class="fas fa-user-clock mr-2"></i>Pending Approvals
                            @if (pendingCount > 0)
                            {
                                <span class="badge badge-warning ml-1">@pendingCount</span>
                            }
                        </h3>
                        <div class="card-tools">
                            <a asp-controller="Admin" asp-action="PendingEmployees" class="btn btn-sm btn-outline-success">
    View All
</a>
                        </div>
                    </div>
                    <div class="card-body p-2">
                        @if (!recentPending.Any())
                        {
                            <div class="text-center text-muted py-3">
                                <i class="fas fa-check-circle text-success fa-2x mb-2"></i>
                                <p class="mb-0 small">No pending approvals!</p>
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var p in recentPending)
                                {
                                    <li class="list-group-item py-2 px-2 border-0">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <strong style="font-size:.85rem;">@p.FirstName @p.LastName</strong>
                                                <small class="text-muted d-block">@p.Email</small>
                                            </div>
                                            <small class="text-muted">@p.CreatedAt.ToString("MMM dd")</small>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
<script src="~/plugins/chart.js/Chart.min.js"></script>
<script>
  var GREEN       = '#4BB543';
var GREEN_DARK  = '#2d7a4f';
var GREEN_LIGHT = '#9BEC00';
var BLUE        = '#0984e3';
var GRAY        = '#6c757d';
var RED         = '#d63031';
    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    // ── Monthly Trainings Bar Chart ──
  new Chart(document.getElementById('monthlyTrainingsChart'), {
    type: 'bar',
    data: {
        labels: months,
        datasets: [{
            label: 'Trainings Created',
            data: @Html.Raw(ViewBag.MonthlyTrainings),
            backgroundColor: function(context) {
                var ctx = context.chart.ctx;
                var gradient = ctx.createLinearGradient(0, 0, 0, 300);
                gradient.addColorStop(0, '#4BB543');
                gradient.addColorStop(1, '#117554');
                return gradient;
            },
            borderRadius: 6
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
    }
});
    // ── Training Status Pie Chart ──
   new Chart(document.getElementById('trainingStatusChart'), {
    type: 'doughnut',
    data: {
        labels: ['Scheduled', 'Ongoing', 'Ended'],
        datasets: [{
            data: [@scheduledCount, @ongoingCount, @endedCount],
            backgroundColor: ['#9BEC00', '#4BB543', '#117554'],
            borderWidth: 2
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } }
    }
});

    // ── Employee Registrations Line Chart ──
   new Chart(document.getElementById('registrationsChart'), {
    type: 'line',
    data: {
        labels: months,
        datasets: [{
            label: 'Registrations',
            data: @Html.Raw(ViewBag.MonthlyRegistrations),
            borderColor: '#117554',
            backgroundColor: 'rgba(75,181,67,0.1)',
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#4BB543',
            pointBorderColor: '#117554',
            pointRadius: 4
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
    }
});

    // ── Pass vs Fail Pie Chart ──
   new Chart(document.getElementById('passFailChart'), {
    type: 'doughnut',
    data: {
        labels: ['Passed', 'Failed'],
        datasets: [{
            data: [@passedCount, @failedCount],
            backgroundColor: ['#4BB543', '#117554'],
            borderWidth: 2
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } }
    }
});

    // ── Employees by Region Bar Chart ──
  new Chart(document.getElementById('regionChart'), {
    type: 'bar',
    data: {
        labels: @Html.Raw(ViewBag.RegionLabels),
        datasets: [{
            label: 'Employees',
            data: @Html.Raw(ViewBag.RegionCounts),
            backgroundColor: function(context) {
                var ctx = context.chart.ctx;
                var gradient = ctx.createLinearGradient(0, 0, 300, 0);
                gradient.addColorStop(0, '#9BEC00');
                gradient.addColorStop(1, '#117554');
                return gradient;
            },
            borderRadius: 4
        }]
    },
    options: {
        responsive: true,
        indexAxis: 'y',
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
    }
});
</script>
}