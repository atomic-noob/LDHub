
@model LDHub.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Login — DENR L&D Hub";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <style>
        body {
            min-height: 100vh;
            background: url('/dist/img/denrbg.jpg') center center / cover no-repeat fixed;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .admin-login-wrapper {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }
        .glass-card {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 16px;
            padding: 40px 35px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }
        .brand-section {
            text-align: center;
            margin-bottom: 30px;
        }
        .brand-section img {
            width: 75px; height: 75px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,.4);
            box-shadow: 0 4px 15px rgba(0,0,0,.3);
            margin-bottom: 12px;
        }
        .brand-section h4 {
            color: white;
            font-weight: 800;
            font-size: 1.3rem;
            margin-bottom: 4px;
        }
        .brand-section p {
            color: rgba(255,255,255,.6);
            font-size: .85rem;
            margin-bottom: 0;
        }
        .admin-badge {
            display: inline-block;
            background: linear-gradient(135deg, #9BEC00, #4BB543);
            color: white;
            border-radius: 20px;
            padding: 4px 16px;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 25px;
        }
        .form-label {
            color: rgba(255,255,255,.7);
            font-size: .82rem;
            margin-bottom: 6px;
        }
        .glass-input {
            background: rgba(255,255,255,0.08) !important;
            border: 1px solid rgba(255,255,255,0.15) !important;
            border-radius: 8px !important;
            color: white !important;
            padding: 11px 14px !important;
            font-size: .9rem !important;
            transition: all .3s;
            width: 100%;
        }
        .glass-input:focus {
            background: rgba(255,255,255,0.12) !important;
            border-color: #4BB543 !important;
            box-shadow: 0 0 0 3px rgba(75,181,67,0.2) !important;
            outline: none !important;
            color: white !important;
        }
        .glass-input::placeholder { color: rgba(255,255,255,.35) !important; }
        .btn-admin-login {
            background: linear-gradient(135deg, #9BEC00, #4BB543, #117554) !important;
            border: none !important;
            border-radius: 10px !important;
            color: white !important;
            font-size: 1rem !important;
            font-weight: 700 !important;
            padding: 12px !important;
            width: 100% !important;
            margin-top: 10px;
            transition: all .3s !important;
            box-shadow: 0 4px 15px rgba(75,181,67,.4) !important;
            cursor: pointer;
        }
        .btn-admin-login:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 25px rgba(75,181,67,.5) !important;
        }
        .error-alert {
            background: rgba(220,53,69,0.15);
            border: 1px solid rgba(220,53,69,.3);
            border-radius: 8px;
            color: #ff6b6b;
            padding: 10px 15px;
            font-size: .85rem;
            margin-bottom: 16px;
        }
        .back-link {
            text-align: center;
            margin-top: 20px;
        }
        .back-link a {
            color: rgba(255,255,255,.5);
            font-size: .82rem;
            text-decoration: none;
            transition: color .2s;
        }
        .back-link a:hover { color: #9BEC00; }
        .form-group { margin-bottom: 16px; }
    </style>
</head>
<body>

<div class="admin-login-wrapper">
    <div class="glass-card">

        @* Brand *@
        <div class="brand-section">
            <img src="~/dist/img/denrlogo.jpg" alt="DENR Logo" />
            <h4>DENR L&amp;D Hub</h4>
            <p>Human Resource Development Service</p>
            <div class="mt-2">
                <span class="admin-badge">
                    <i class="fas fa-shield-alt mr-1"></i> Administrator Portal
                </span>
            </div>
        </div>

        @* Error *@
        @if (ViewBag.Error != null)
        {
            <div class="error-alert">
                <i class="fas fa-exclamation-circle mr-2"></i>@ViewBag.Error
            </div>
        }

        @* Form *@
        <form asp-controller="Admin" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input asp-for="Email" type="email" class="glass-input"
                       placeholder="admin@denr.gov.ph" required />
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <input asp-for="Password" type="password" class="glass-input"
                       placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn-admin-login">
                <i class="fas fa-shield-alt mr-2"></i> Sign In as Administrator
            </button>
        </form>

        <div class="back-link">
            <a href="/">
                <i class="fas fa-arrow-left mr-1"></i> Back to Landing Page
            </a>
        </div>

    </div>
</div>

<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
