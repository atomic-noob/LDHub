 @{Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Training Modules";

    var trainings      = ViewBag.Trainings      as List<LDHub.Models.Training> ?? new List<LDHub.Models.Training>();
    var training       = ViewBag.Training        as LDHub.Models.Training;
    var groupedModules = ViewBag.GroupedModules  as Dictionary<string, List<LDHub.Models.TrainingModule>>
                         ?? new Dictionary<string, List<LDHub.Models.TrainingModule>>();
    var trainingId     = ViewBag.TrainingId      as int? ?? 0;
    var now            = DateTime.Now;

    var ongoingCount  = trainings.Count(t => t.StartDate.HasValue && t.EndDate.HasValue && now >= t.StartDate && now <= t.EndDate);
    var upcomingCount = trainings.Count(t => t.StartDate.HasValue && now < t.StartDate);
    var endedCount    = trainings.Count(t => t.EndDate.HasValue && now > t.EndDate);
}

@section Styles {
    <style>
        body { background: #f4fdf6; }
        .content-wrapper { background: linear-gradient(180deg,#fff 0%,#f4fff7 100%); }
        .success-gradient { background: linear-gradient(225deg,#9BEC00,#4BB543,#117554); color:white; }

        /* ── Training Cards (Page 1) ── */
        .training-card-item {
            border-radius: 12px;
            border: 2px solid #dee2e6;
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            cursor: pointer;
            transition: all .25s;
            text-decoration: none;
            display: block;
            color: inherit;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
        }
        .training-card-item:hover {
            border-color: #4BB543;
            box-shadow: 0 6px 20px rgba(75,181,67,.2);
            transform: translateY(-3px);
            color: inherit;
            text-decoration: none;
        }
        .filter-btn {
            border-radius: 20px; padding: 5px 16px;
            font-size: .83rem; margin-right: 6px; margin-bottom: 8px;
            border: 2px solid transparent; transition: all .2s; cursor: pointer;
            background: transparent;
        }
        .filter-btn-all     { border-color: #6c757d; color: #6c757d; }
        .filter-btn-all.active     { background: #6c757d !important; color: white !important; }
        .filter-btn-ongoing { border-color: #4BB543; color: #4BB543; }
        .filter-btn-ongoing.active { background: #4BB543 !important; color: white !important; }
        .filter-btn-upcoming{ border-color: #0984e3; color: #0984e3; }
        .filter-btn-upcoming.active{ background: #0984e3 !important; color: white !important; }
        .filter-btn-ended   { border-color: #adb5bd; color: #adb5bd; }
        .filter-btn-ended.active   { background: #adb5bd !important; color: white !important; }
    </style>
}

@if (trainingId == 0)
{
    @* ════════════════════════════════════════════════════════════
       PAGE 1 — Training Selection (Full Width Cards)
       ════════════════════════════════════════════════════════════ *@

    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6"><h1 class="m-0">Modules</h1></div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item active">Modules</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">

            @* Search + Filter *@
            <div class="row mb-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <input type="text" id="trainingSearch" class="form-control"
                               placeholder="Search training..." />
                        <div class="input-group-append">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-7">
                    <button class="filter-btn filter-btn-all active" data-filter="all">
                        All <span class="badge badge-secondary ml-1">@trainings.Count</span>
                    </button>
                    <button class="filter-btn filter-btn-ongoing" data-filter="Ongoing">
                        Ongoing <span class="badge badge-success ml-1">@ongoingCount</span>
                    </button>
                    <button class="filter-btn filter-btn-upcoming" data-filter="Scheduled">
                        Scheduled <span class="badge badge-info ml-1">@upcomingCount</span>
                    </button>
                    <button class="filter-btn filter-btn-ended" data-filter="Ended">
                        Ended <span class="badge badge-secondary ml-1">@endedCount</span>
                    </button>
                </div>
            </div>

            @* Training Cards *@
            @if (!trainings.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-inbox fa-3x mb-3" style="color:#c8e6c9;opacity:.6;"></i>
                        <h5 class="text-muted">No trainings available.</h5>
                    </div>
                </div>
            }
            else
            {
                <div class="row" id="trainingCards">
                    @foreach (var t in trainings)
                    {
                        var status    = "Scheduled";
                        var badgeCss  = "badge-info";
                        var tStatus   = "Scheduled";

                        if (t.StartDate.HasValue && t.EndDate.HasValue)
                        {
                            if (now >= t.StartDate && now <= t.EndDate)
                            { status = "Ongoing";   badgeCss = "badge-success"; tStatus = "Ongoing"; }
                            else if (now > t.EndDate)
                            { status = "Ended";     badgeCss = "badge-secondary"; tStatus = "Ended"; }
                        }

                        <div class="col-md-6 col-lg-4 training-card-col"
                             data-status="@tStatus"
                             data-title="@t.TrainingTitle.ToLower()">
                            <a asp-controller="Content" asp-action="Modules"
                               asp-route-trainingId="@t.TrainingId"
                               class="training-card-item">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="font-weight-bold mb-0" style="font-size:1rem; line-height:1.3;">
                                        @t.TrainingTitle
                                    </h5>
                                    <span class="badge @badgeCss ml-2" style="white-space:nowrap;">@status</span>
                                </div>
                                <small class="text-muted d-block mb-2">@t.TrainingCode</small>
                                <div style="font-size:.82rem; color:#6c757d;">
                                    <div class="mb-1">
                                        <i class="fas fa-map-marker-alt mr-1" style="color:#4BB543;"></i>
                                        @(t.Location ?? "No location")
                                    </div>
                                    <div class="mb-1">
                                        <i class="fas fa-calendar mr-1" style="color:#4BB543;"></i>
                                        @(t.StartDate?.ToString("MMM dd") ?? "TBD") –
                                        @(t.EndDate?.ToString("MMM dd, yyyy") ?? "TBD")
                                    </div>
                                    @if (t.Region != null)
                                    {
                                        <div>
                                            <i class="fas fa-map mr-1" style="color:#4BB543;"></i>
                                            @t.Region.RegionName
                                        </div>
                                    }
                                </div>
                                <div class="mt-3 text-right">
                                    <span class="btn btn-sm btn-success">
                                        <i class="fas fa-cubes mr-1"></i> Manage Modules
                                    </span>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}
else
{
    @* ════════════════════════════════════════════════════════════
       PAGE 2 — Module Management for Selected Training
       ════════════════════════════════════════════════════════════ *@

    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">
                        <i class="fas fa-cubes mr-2"></i>@training?.TrainingTitle
                    </h1>
                    <small class="text-muted">@training?.TrainingCode</small>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item">
                            <a asp-controller="Content" asp-action="Modules">
                                <i class="fas fa-th-large mr-1"></i>Modules
                            </a>
                        </li>
                        <li class="breadcrumb-item active">@training?.TrainingTitle</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            }

            @* Training Info Bar *@
            <div class="card shadow-sm mb-3">
                <div class="card-body py-2">
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-muted">Date</small>
                            <strong class="d-block" style="font-size:.88rem;">
                                @(training?.StartDate?.ToString("MMM dd") ?? "TBD") –
                                @(training?.EndDate?.ToString("MMM dd, yyyy") ?? "TBD")
                            </strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Location</small>
                            <strong class="d-block" style="font-size:.88rem;">@(training?.Location ?? "—")</strong>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">Region</small>
                            <strong class="d-block" style="font-size:.88rem;">@(training?.Region?.RegionName ?? "—")</strong>
                        </div>
                        <div class="col-md-3 text-right">
                            <button type="button" class="btn btn-success btn-sm"
                                    data-toggle="modal" data-target="#addModuleModal">
                                <i class="fas fa-plus mr-1"></i> Add Module
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* Modules *@
            @if (!groupedModules.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-folder-open fa-3x mb-3" style="color:#c8e6c9;opacity:.6;"></i>
                        <h5 class="text-muted">No modules yet.</h5>
                        <p class="text-muted small">Click <strong>Add Module</strong> to get started.</p>
                        <button type="button" class="btn btn-success"
                                data-toggle="modal" data-target="#addModuleModal">
                            <i class="fas fa-plus mr-1"></i> Add Module
                        </button>
                    </div>
                </div>
            }
            else
            {
                <ul class="nav nav-tabs mb-3" id="moduleTabs">
                    @{ int tabIdx = 0; }
                    @foreach (var group in groupedModules)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(tabIdx == 0 ? "active" : "")"
                               data-toggle="tab" href="#tab-@tabIdx">
                                <i class="fas fa-folder-open mr-1"></i>@group.Key
                            </a>
                        </li>
                        tabIdx++;
                    }
                </ul>

                <div class="tab-content">
                    @{ int cIdx = 0; }
                    @foreach (var group in groupedModules)
                    {
                        <div class="tab-pane fade @(cIdx == 0 ? "show active" : "")" id="tab-@cIdx">
                            <div class="row">
                                @foreach (var m in group.Value)
                                {
                                    var typeBadge = m.ModuleType switch
                                    {
                                        "Lecture"  => "badge-primary",
                                        "Activity" => "badge-success",
                                        "Quiz"     => "badge-warning",
                                        "Text"     => "badge-secondary",
                                        _          => "badge-secondary"
                                    };
                                    <div class="col-md-4 mb-3">
                                        <div class="card shadow-sm h-100">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="font-weight-bold mb-0" style="line-height:1.3;">
                                                        @m.ModuleDescription
                                                    </h6>
                                                    <span class="badge @typeBadge ml-1">@m.ModuleType</span>
                                                </div>
                                                <ul class="list-unstyled mb-2" style="font-size:.82rem;">
                                                    @if (!string.IsNullOrEmpty(m.FilePath))
                                                    {
                                                        <li>
                                                            <i class="fas fa-file mr-1 text-success"></i>
                                                            <a href="@m.FilePath" target="_blank">View File</a>
                                                        </li>
                                                    }
                                                    @if (!string.IsNullOrEmpty(m.LinkUrl))
                                                    {
                                                        <li>
                                                            <i class="fas fa-link mr-1 text-primary"></i>
                                                            <a href="@m.LinkUrl" target="_blank">Open Link</a>
                                                        </li>
                                                    }
                                                </ul>
                                                <p class="text-muted" style="font-size:.78rem;">
                                                    <i class="far fa-clock mr-1"></i>
                                                    Updated: @m.UpdatedAt.ToString("MMM dd, yyyy")
                                                </p>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @if (m.ModuleType == "Quiz")
                                                    {
                                                        <a asp-controller="Content" asp-action="QuizBuilder"
                                                           asp-route-moduleId="@m.ModuleId"
                                                           class="btn btn-sm btn-warning">
                                                            <i class="fas fa-cog mr-1"></i>
                                                            @(m.Quiz != null ? "Edit Quiz" : "Build Quiz")
                                                        </a>
                                                    }
                                                    @if (m.ModuleType == "Text")
                                                    {
                                                        <a asp-controller="Content" asp-action="TextEditor"
                                                           asp-route-moduleId="@m.ModuleId"
                                                           class="btn btn-sm btn-secondary">
                                                            <i class="fas fa-align-left mr-1"></i>
                                                            @(m.TextContent != null ? "Edit Text" : "Add Text")
                                                        </a>
                                                    }
                                                    <button class="btn btn-sm btn-info edit-module-btn"
                                                            data-toggle="modal" data-target="#editModuleModal"
                                                            data-id="@m.ModuleId"
                                                            data-name="@m.ModuleName"
                                                            data-description="@m.ModuleDescription"
                                                            data-type="@m.ModuleType"
                                                            data-linkurl="@m.LinkUrl"
                                                            data-lecturesource="@m.LectureSource">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <form asp-controller="Content" asp-action="DeleteModule"
                                                          method="post" style="display:inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="moduleId" value="@m.ModuleId" />
                                                        <input type="hidden" name="trainingId" value="@trainingId" />
                                                        <button type="submit" class="btn btn-sm btn-danger"
                                                                onclick="return confirm('Delete this module?')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        cIdx++;
                    }
                </div>
            }
        </div>
    </section>

    @* ── Add Module Modal ── *@
    <div class="modal fade" id="addModuleModal" tabindex="-1" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-plus-circle mr-1"></i> Add Module</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <form asp-controller="Content" asp-action="CreateModule" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="trainingId" value="@trainingId" />
                    <div class="modal-body">

                        <div class="form-group">
                            <label>Module Name <span class="text-danger">*</span></label>
                            <select class="form-control" name="moduleName" required>
                                <option value="">-- Select Module --</option>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <option value="Module @i">Module @i</option>
                                }
                            </select>
                            <small class="text-muted">Items with the same module name are grouped together.</small>
                        </div>

                        <div class="form-group">
                            <label>Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="moduleDescription" rows="2" required
                                      placeholder="Brief description of this module item"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Module Type <span class="text-danger">*</span></label>
                            <select class="form-control" name="moduleType" id="add_module_type" required>
                                <option value="">-- Select Type --</option>
                                <option value="Lecture">Lecture</option>
                                <option value="Activity">Activity</option>
                                <option value="Quiz">Quiz</option>
                                <option value="Text">Text / Reading</option>
                            </select>
                        </div>

                        <div class="form-group" id="add_lecture_source_group" style="display:none;">
                            <label>Source</label>
                            <div class="custom-control custom-radio mb-1">
                                <input type="radio" class="custom-control-input" id="src_file"
                                       name="lectureSource" value="file">
                                <label class="custom-control-label" for="src_file">Upload File</label>
                            </div>
                            <div class="custom-control custom-radio">
                                <input type="radio" class="custom-control-input" id="src_link"
                                       name="lectureSource" value="link">
                                <label class="custom-control-label" for="src_link">External Link</label>
                            </div>
                        </div>

                        <div class="form-group" id="add_file_group" style="display:none;">
                            <label>Upload File <small class="text-muted">(Max 40MB)</small></label>
                            <input type="file" class="form-control-file" name="file" />
                            <small class="text-muted">PDF, DOC, PPT, XLS, MP4, JPG, PNG, etc.</small>
                        </div>

                        <div class="form-group" id="add_link_group" style="display:none;">
                            <label>External Link URL</label>
                            <input type="url" class="form-control" name="linkUrl" placeholder="https://..." />
                        </div>

                        <div id="add_quiz_info" style="display:none;">
                            <div class="alert alert-info py-2 mb-0">
                                <i class="fas fa-info-circle mr-1"></i>
                                After adding, click <strong>Build Quiz</strong> to add questions.
                            </div>
                        </div>

                        <div id="add_text_info" style="display:none;">
                            <div class="alert alert-info py-2 mb-0">
                                <i class="fas fa-info-circle mr-1"></i>
                                After adding, click <strong>Add Text</strong> to add content.
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save mr-1"></i> Add Module
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ── Edit Module Modal ── *@
    <div class="modal fade" id="editModuleModal" tabindex="-1" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-edit mr-1"></i> Edit Module</h5>
                    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                </div>
                <form asp-controller="Content" asp-action="EditModule" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="moduleId" id="edit_module_id" />
                    <input type="hidden" name="trainingId" value="@trainingId" />
                    <div class="modal-body">

                        <div class="form-group">
                            <label>Module Name</label>
                            <input type="text" class="form-control" id="edit_module_name" disabled />
                        </div>

                        <div class="form-group">
                            <label>Type</label>
                            <input type="text" class="form-control" id="edit_module_type_display" disabled />
                        </div>

                        <div class="form-group">
                            <label>Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="moduleDescription"
                                      id="edit_module_description" rows="3" required></textarea>
                        </div>

                        <div class="form-group" id="edit_file_group" style="display:none;">
                            <label>Replace File <small class="text-muted">(optional)</small></label>
                            <input type="file" class="form-control-file" name="file" />
                            <small class="text-muted">Leave blank to keep current file.</small>
                        </div>

                        <div class="form-group" id="edit_link_group" style="display:none;">
                            <label>Link URL</label>
                            <input type="url" class="form-control" name="linkUrl"
                                   id="edit_link_url" placeholder="https://..." />
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
$(document).ready(function () {

    // ── Page 1: Filter buttons ──
    $('.filter-btn').on('click', function () {
        $('.filter-btn').removeClass('active');
        $(this).addClass('active');
        var filter = $(this).data('filter');
        $('.training-card-col').each(function () {
            if (filter === 'all' || $(this).data('status') === filter) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    });

    // ── Page 1: Search ──
    $('#trainingSearch').on('keyup', function () {
        var val = $(this).val().toLowerCase();
        $('.training-card-col').each(function () {
            $(this).toggle($(this).data('title').indexOf(val) > -1);
        });
    });

    // ── Page 2: Add Module Type Toggle ──
    $('#add_module_type').on('change', function () {
        var type = $(this).val();
        $('#add_lecture_source_group, #add_file_group, #add_link_group, #add_quiz_info, #add_text_info').hide();
        $('input[name="lectureSource"]').prop('checked', false);

        if (type === 'Lecture' || type === 'Activity') {
            $('#add_lecture_source_group').show();
        } else if (type === 'Quiz') {
            $('#add_quiz_info').show();
        } else if (type === 'Text') {
            $('#add_text_info').show();
        }
    });

    // ── Page 2: Lecture Source Radio ──
    $('input[name="lectureSource"]').on('change', function () {
        var src = $(this).val();
        $('#add_file_group, #add_link_group').hide();
        if (src === 'file') $('#add_file_group').show();
        else if (src === 'link') $('#add_link_group').show();
    });

    // ── Page 2: Edit Modal ──
    $('.edit-module-btn').on('click', function () {
        var type = $(this).data('type');
        var src  = $(this).data('lecturesource');
        $('#edit_module_id').val($(this).data('id'));
        $('#edit_module_name').val($(this).data('name'));
        $('#edit_module_type_display').val(type);
        $('#edit_module_description').val($(this).data('description'));
        $('#edit_link_url').val($(this).data('linkurl'));
        $('#edit_file_group, #edit_link_group').hide();
        if (type === 'Lecture' || type === 'Activity') {
            if (src === 'file') $('#edit_file_group').show();
            else if (src === 'link') $('#edit_link_group').show();
            else { $('#edit_file_group').show(); $('#edit_link_group').show(); }
        }
    });

    // ── Reset Add Modal on close ──
    $('#addModuleModal').on('hidden.bs.modal', function () {
        $('#add_module_type').val('');
        $('#add_lecture_source_group, #add_file_group, #add_link_group, #add_quiz_info, #add_text_info').hide();
        $('input[name="lectureSource"]').prop('checked', false);
    });

});
</script>
}