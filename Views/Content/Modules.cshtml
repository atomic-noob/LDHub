@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Training Modules";

    var trainings      = ViewBag.Trainings      as List<LDHub.Models.Training> ?? new List<LDHub.Models.Training>();
    var training       = ViewBag.Training        as LDHub.Models.Training;
    var groupedModules = ViewBag.GroupedModules  as Dictionary<string, List<LDHub.Models.TrainingModule>>
                         ?? new Dictionary<string, List<LDHub.Models.TrainingModule>>();
    var trainingId     = ViewBag.TrainingId      as int? ?? 0;
    var now            = DateTime.Now;

    // Categorize trainings for filter
    var ongoingList   = trainings.Where(t => t.StartDate.HasValue && t.EndDate.HasValue && now >= t.StartDate && now <= t.EndDate).ToList();
    var upcomingList  = trainings.Where(t => t.StartDate.HasValue && now < t.StartDate).ToList();
    var endedList     = trainings.Where(t => t.EndDate.HasValue && now > t.EndDate).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" />
    <style>
        body { background: #f4fdf6; }
        .content-wrapper { background: linear-gradient(180deg,#fff 0%,#f4fff7 100%); }
        .success-gradient { background: linear-gradient(225deg,#9BEC00,#4BB543,#117554); color:white; }

        /* Training Cards */
        .training-card {
            border-radius: 10px;
            border: 2px solid #dee2e6;
            padding: 15px;
            margin-bottom: 15px;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            display: block;
            color: inherit;
        }
        .training-card:hover {
            border-color: #4BB543;
            box-shadow: 0 4px 15px rgba(75,181,67,.2);
            transform: translateY(-2px);
            color: inherit;
            text-decoration: none;
        }
        .training-card.active-card {
            border-color: #4BB543;
            background: #f4fdf6;
        }
        .training-card .training-status {
            font-size: .75rem;
            font-weight: 600;
        }

        /* Filter buttons */
        .filter-btn {
            border-radius: 20px;
            padding: 5px 15px;
            font-size: .85rem;
            margin-right: 5px;
            margin-bottom: 8px;
            border: 2px solid transparent;
            transition: all .2s;
        }
        .filter-btn.active { font-weight: 700; }
        .filter-btn-all      { border-color: #6c757d; color: #6c757d; }
        .filter-btn-all.active      { background: #6c757d; color: white; }
        .filter-btn-ongoing  { border-color: #4BB543; color: #4BB543; }
        .filter-btn-ongoing.active  { background: #4BB543; color: white; }
        .filter-btn-upcoming { border-color: #0984e3; color: #0984e3; }
        .filter-btn-upcoming.active { background: #0984e3; color: white; }
        .filter-btn-ended    { border-color: #6c757d; color: #6c757d; }
        .filter-btn-ended.active    { background: #6c757d; color: white; }

        /* Module group */
        .module-group { margin-bottom: 20px; }
        .module-group-header {
            background: linear-gradient(135deg,#4BB543,#117554);
            color: white; padding: 10px 15px;
            border-radius: 8px 8px 0 0;
            font-weight: 700;
            display: flex; align-items: center; justify-content: space-between;
        }
        .module-group-body {
            border: 1px solid #dee2e6;
            border-top: none;
            border-radius: 0 0 8px 8px;
            overflow: hidden;
        }

        /* Employee cards */
        .employee-card {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 12px 15px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all .2s;
        }
        .employee-card:hover { border-color: #4BB543; background: #f4fdf6; }
        .employee-avatar {
            width: 38px; height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg,#9BEC00,#4BB543);
            color: white; font-weight: 700;
            display: flex; align-items: center; justify-content: center;
            font-size: .9rem; flex-shrink: 0; margin-right: 12px;
        }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">Training Modules</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Modules</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        <div class="row">

            @* ── LEFT: Training List ── *@
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header success-gradient">
                        <h3 class="card-title">
                            <i class="fas fa-book mr-2"></i>Trainings
                        </h3>
                    </div>
                    <div class="card-body">

                        @* Search *@
                        <div class="input-group mb-3">
                            <input type="text" id="trainingSearch" class="form-control"
                                   placeholder="Search training..." />
                            <div class="input-group-append">
                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                            </div>
                        </div>

                        @* Filter Buttons *@
                        <div class="mb-3">
                            <button class="filter-btn filter-btn-all active" data-filter="all">
                                All <span class="badge badge-secondary ml-1">@trainings.Count</span>
                            </button>
                            <button class="filter-btn filter-btn-ongoing" data-filter="ongoing">
                                Ongoing <span class="badge badge-success ml-1">@ongoingList.Count</span>
                            </button>
                            <button class="filter-btn filter-btn-upcoming" data-filter="upcoming">
                                Scheduled <span class="badge badge-info ml-1">@upcomingList.Count</span>
                            </button>
                            <button class="filter-btn filter-btn-ended" data-filter="ended">
                                Ended <span class="badge badge-secondary ml-1">@endedList.Count</span>
                            </button>
                        </div>

                        @* Training Cards *@
                        <div id="trainingList" style="max-height:600px; overflow-y:auto;">
                            @if (!trainings.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-2x mb-2" style="opacity:.3;"></i>
                                    <p>No trainings available.</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var t in trainings)
                                {
                                    var status    = "upcoming";
                                    var badgeCss  = "badge-info";
                                    var statusLbl = "Scheduled";

                                    if (t.StartDate.HasValue && t.EndDate.HasValue)
                                    {
                                        if (now >= t.StartDate && now <= t.EndDate)
                                        { status = "ongoing";  badgeCss = "badge-success"; statusLbl = "Ongoing"; }
                                        else if (now > t.EndDate)
                                        { status = "ended";    badgeCss = "badge-secondary"; statusLbl = "Ended"; }
                                    }

                                    <a href="?trainingId=@t.TrainingId"
                                       class="training-card @(trainingId == t.TrainingId ? "active-card" : "")"
                                       data-status="@status"
                                       data-title="@t.TrainingTitle.ToLower()">
                                        <div class="d-flex align-items-start justify-content-between">
                                            <div>
                                                <strong style="font-size:.9rem;">@t.TrainingTitle</strong>
                                                <small class="text-muted d-block">@t.TrainingCode</small>
                                            </div>
                                            <span class="badge @badgeCss training-status">@statusLbl</span>
                                        </div>
                                        <div class="mt-2" style="font-size:.8rem; color:#6c757d;">
                                            <i class="fas fa-calendar mr-1"></i>
                                            @(t.StartDate?.ToString("MMM dd") ?? "TBD") –
                                            @(t.EndDate?.ToString("MMM dd, yyyy") ?? "TBD")
                                            @if (!string.IsNullOrEmpty(t.Region?.RegionName))
                                            {
                                                <span class="ml-2">
                                                    <i class="fas fa-map-marker-alt mr-1"></i>@t.Region.RegionName
                                                </span>
                                            }
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* ── RIGHT: Module Content ── *@
            <div class="col-lg-8">
                @if (training == null)
                {
                    <div class="card shadow-sm">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-hand-point-left fa-3x mb-3" style="color:#c8e6c9; opacity:.6;"></i>
                            <h5 class="text-muted">Select a training to manage its modules.</h5>
                        </div>
                    </div>
                }
                else
                {
                    @* Training Info Header *@
                    <div class="card shadow-sm mb-3">
                        <div class="card-header success-gradient">
                            <h3 class="card-title">
                                <i class="fas fa-book mr-2"></i>@training.TrainingTitle
                            </h3>
                            <div class="card-tools">
                                <span class="badge badge-light text-dark">@training.TrainingCode</span>
                            </div>
                        </div>
                        <div class="card-body py-2">
                            <div class="row">
                                <div class="col-md-4">
                                    <small class="text-muted">Date</small>
                                    <strong class="d-block" style="font-size:.85rem;">
                                        @(training.StartDate?.ToString("MMM dd") ?? "TBD") –
                                        @(training.EndDate?.ToString("MMM dd, yyyy") ?? "TBD")
                                    </strong>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Location</small>
                                    <strong class="d-block" style="font-size:.85rem;">@(training.Location ?? "—")</strong>
                                </div>
                                <div class="col-md-4">
                                    <small class="text-muted">Region</small>
                                    <strong class="d-block" style="font-size:.85rem;">@(training.Region?.RegionName ?? "—")</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Tabs: Modules | Employees *@
                    <ul class="nav nav-tabs mb-3" id="moduleTabs">
                        <li class="nav-item">
                            <a class="nav-link active font-weight-bold" data-toggle="tab" href="#tab-modules">
                                <i class="fas fa-folder mr-1"></i> Modules
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-toggle="tab" href="#tab-employees">
                                <i class="fas fa-users mr-1"></i> Enrolled Employees
                                <span class="badge badge-success ml-1">
                                    @(training.TrainingParticipants?.Count ?? 0)
                                </span>
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content">

                        @* ── MODULES TAB ── *@
                        <div class="tab-pane fade show active" id="tab-modules">

                            @* Add Module Button *@
                            <div class="mb-3">
                                <button type="button" class="btn btn-success"
                                        data-toggle="modal" data-target="#addModuleModal">
                                    <i class="fas fa-plus mr-1"></i> Add Module
                                </button>
                            </div>

                            @if (!groupedModules.Any())
                            {
                                <div class="card shadow-sm">
                                    <div class="card-body text-center py-5">
                                        <i class="fas fa-folder-open fa-3x mb-3" style="color:#c8e6c9;opacity:.6;"></i>
                                        <h5 class="text-muted">No modules yet.</h5>
                                        <p class="text-muted small">Click "Add Module" to get started.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @foreach (var group in groupedModules)
                                {
                                    <div class="module-group">
                                        <div class="module-group-header">
                                            <span><i class="fas fa-layer-group mr-2"></i>@group.Key</span>
                                            <span class="badge badge-light text-dark">@group.Value.Count item(s)</span>
                                        </div>
                                        <div class="module-group-body">
                                            <table class="table table-sm table-hover mb-0">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th>Type</th>
                                                        <th>Description</th>
                                                        <th>File/Link</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var m in group.Value)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @{
                                                                    var typeIcon = m.ModuleType switch
                                                                    {
                                                                        "Lecture"  => "fa-book-open text-success",
                                                                        "Activity" => "fa-tasks text-warning",
                                                                        "Quiz"     => "fa-pencil-alt text-warning",
                                                                        "Text"     => "fa-align-left text-info",
                                                                        _          => "fa-file text-secondary"
                                                                    };
                                                                }
                                                                <i class="fas @typeIcon mr-1"></i>
                                                                <small>@m.ModuleType</small>
                                                            </td>
                                                            <td><small>@m.ModuleDescription</small></td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(m.FilePath))
                                                                {
                                                                    <a href="@m.FilePath" target="_blank"
                                                                       class="btn btn-xs btn-outline-success">
                                                                        <i class="fas fa-file mr-1"></i>File
                                                                    </a>
                                                                }
                                                                @if (!string.IsNullOrEmpty(m.LinkUrl))
                                                                {
                                                                    <a href="@m.LinkUrl" target="_blank"
                                                                       class="btn btn-xs btn-outline-primary">
                                                                        <i class="fas fa-link mr-1"></i>Link
                                                                    </a>
                                                                }
                                                                @if (m.ModuleType == "Quiz")
                                                                {
                                                                    <a asp-controller="Content"
                                                                       asp-action="QuizBuilder"
                                                                       asp-route-moduleId="@m.ModuleId"
                                                                       class="btn btn-xs btn-warning">
                                                                        <i class="fas fa-edit mr-1"></i>Quiz
                                                                    </a>
                                                                }
                                                                @if (m.ModuleType == "Text")
                                                                {
                                                                    <a asp-controller="Content"
                                                                       asp-action="TextEditor"
                                                                       asp-route-moduleId="@m.ModuleId"
                                                                       class="btn btn-xs btn-info">
                                                                        <i class="fas fa-edit mr-1"></i>Edit
                                                                    </a>
                                                                }
                                                            </td>
                                                            <td>
                                                                <button type="button"
                                                                        class="btn btn-xs btn-info edit-module-btn"
                                                                        data-id="@m.ModuleId"
                                                                        data-desc="@m.ModuleDescription"
                                                                        data-link="@m.LinkUrl"
                                                                        data-toggle="modal"
                                                                        data-target="#editModuleModal">
                                                                    <i class="fas fa-edit"></i>
                                                                </button>
                                                                <form asp-controller="Content"
                                                                      asp-action="DeleteModule"
                                                                      method="post" style="display:inline;">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="moduleId"   value="@m.ModuleId" />
                                                                    <input type="hidden" name="trainingId" value="@trainingId" />
                                                                    <button type="submit" class="btn btn-xs btn-danger"
                                                                            onclick="return confirm('Delete this module?')">
                                                                        <i class="fas fa-trash"></i>
                                                                    </button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        @* ── EMPLOYEES TAB ── *@
                        <div class="tab-pane fade" id="tab-employees">
                            @{
                                var participants = training.TrainingParticipants?.ToList()
                                                  ?? new List<LDHub.Models.TrainingParticipant>();
                            }
                            @if (!participants.Any())
                            {
                                <div class="card shadow-sm">
                                    <div class="card-body text-center py-5">
                                        <i class="fas fa-users fa-3x mb-3" style="color:#c8e6c9;opacity:.6;"></i>
                                        <h5 class="text-muted">No employees enrolled yet.</h5>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="mb-2">
                                    <input type="text" id="employeeSearch" class="form-control"
                                           placeholder="Search employee..." />
                                </div>
                                <div id="employeeCards">
                                    @foreach (var tp in participants.OrderBy(tp => tp.User?.LastName))
                                    {
                                        var initials = $"{tp.User?.FirstName?.FirstOrDefault()}{tp.User?.LastName?.FirstOrDefault()}";
                                        var statusBadge = tp.CompletionStatus switch
                                        {
                                            "Completed"   => "badge-success",
                                            "In Progress" => "badge-primary",
                                            "Failed"      => "badge-danger",
                                            _             => "badge-secondary"
                                        };
                                        <div class="employee-card" data-name="@tp.User?.FirstName?.ToLower() @tp.User?.LastName?.ToLower()">
                                            <div class="d-flex align-items-center">
                                                <div class="employee-avatar">@initials</div>
                                                <div>
                                                    <strong>@tp.User?.FirstName @tp.User?.LastName</strong>
                                                    <small class="text-muted d-block">@(tp.User?.Position ?? "—")</small>
                                                    <small class="text-muted">@(tp.User?.Office?.OfficeName ?? "—")</small>
                                                </div>
                                            </div>
                                            <div class="text-right">
                                                <span class="badge @statusBadge">@tp.CompletionStatus</span>
                                                <small class="text-muted d-block mt-1">
                                                    Since @tp.EnrollmentDate.ToString("MMM dd, yyyy")
                                                </small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* ── Add Module Modal ── *@
@if (training != null)
{
    <div class="modal fade" id="addModuleModal" tabindex="-1" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header success-gradient">
                    <h5 class="modal-title"><i class="fas fa-plus mr-2"></i>Add Module</h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <form asp-controller="Content" asp-action="CreateModule"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="trainingId" value="@trainingId" />
                    <div class="modal-body">
                        <div class="form-group">
                            <label>Module Name (Group) <span class="text-danger">*</span></label>
                            <input type="text" name="moduleName" class="form-control"
                                   placeholder="e.g. Module 1" required />
                            <small class="text-muted">Items with the same Module Name will be grouped together.</small>
                        </div>
                        <div class="form-group">
                            <label>Module Type <span class="text-danger">*</span></label>
                            <select name="moduleType" class="form-control" id="moduleTypeSelect"
                                    onchange="toggleModuleFields()" required>
                                <option value="">-- Select Type --</option>
                                <option value="Lecture">Lecture</option>
                                <option value="Activity">Activity</option>
                                <option value="Quiz">Quiz</option>
                                <option value="Text">Text / Reading</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Description <span class="text-danger">*</span></label>
                            <input type="text" name="moduleDescription" class="form-control"
                                   placeholder="Brief description of this module item" required />
                        </div>

                        @* Lecture Source *@
                        <div id="lectureSourceGroup" style="display:none;">
                            <div class="form-group">
                                <label>Lecture Source</label>
                                <select name="lectureSource" class="form-control">
                                    <option value="">-- Select --</option>
                                    <option value="file">Upload File</option>
                                    <option value="link">External Link</option>
                                </select>
                            </div>
                        </div>

                        @* File Upload *@
                        <div class="form-group" id="fileGroup" style="display:none;">
                            <label>Upload File <small class="text-muted">(Max 40MB)</small></label>
                            <input type="file" name="file" class="form-control-file" />
                            <small class="text-muted">Allowed: PDF, DOC, PPT, XLS, MP4, JPG, PNG, etc.</small>
                        </div>

                        @* Link URL *@
                        <div class="form-group" id="linkGroup" style="display:none;">
                            <label>External Link URL</label>
                            <input type="url" name="linkUrl" class="form-control"
                                   placeholder="https://..." />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save mr-1"></i> Add Module
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* ── Edit Module Modal ── *@
    <div class="modal fade" id="editModuleModal" tabindex="-1" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="fas fa-edit mr-2"></i>Edit Module</h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <form asp-controller="Content" asp-action="EditModule"
                      method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="moduleId"   id="edit_moduleId" />
                    <input type="hidden" name="trainingId" value="@trainingId" />
                    <div class="modal-body">
                        <div class="form-group">
                            <label>Description</label>
                            <input type="text" name="moduleDescription" id="edit_desc"
                                   class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>Link URL</label>
                            <input type="url" name="linkUrl" id="edit_link"
                                   class="form-control" placeholder="https://..." />
                        </div>
                        <div class="form-group">
                            <label>Replace File <small class="text-muted">(optional)</small></label>
                            <input type="file" name="file" class="form-control-file" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-info">
                            <i class="fas fa-save mr-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
$(function () {

    // ── Filter buttons ──
    $('.filter-btn').on('click', function () {
        $('.filter-btn').removeClass('active');
        $(this).addClass('active');

        var filter = $(this).data('filter');
        $('.training-card').each(function () {
            if (filter === 'all' || $(this).data('status') === filter) {
                $(this).show();
            } else {
                $(this).hide();
            }
        });
    });

    // ── Search trainings ──
    $('#trainingSearch').on('keyup', function () {
        var val = $(this).val().toLowerCase();
        $('.training-card').each(function () {
            $(this).toggle($(this).data('title').indexOf(val) > -1);
        });
    });

    // ── Search employees ──
    $('#employeeSearch').on('keyup', function () {
        var val = $(this).val().toLowerCase();
        $('.employee-card').each(function () {
            $(this).toggle($(this).data('name').indexOf(val) > -1);
        });
    });

    // ── Edit module modal ──
    $('.edit-module-btn').on('click', function () {
        $('#edit_moduleId').val($(this).data('id'));
        $('#edit_desc').val($(this).data('desc'));
        $('#edit_link').val($(this).data('link'));
    });

    // ── Module type field toggling ──
    window.toggleModuleFields = function () {
        var type = $('#moduleTypeSelect').val();
        $('#lectureSourceGroup').toggle(type === 'Lecture' || type === 'Activity');
        $('#fileGroup').show();
        $('#linkGroup').show();
    };

});
</script>
}