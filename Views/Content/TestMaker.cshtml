            var type = $('#' + prefix + '_qtype').val();

            $('#' + prefix + '_tf, #' +
              prefix + '_id, #' +
              prefix + '_mc').hide();

            if (type === 'true_false') {
                $('#' + prefix + '_tf').show();
            }
            else if (type === 'identification') {
                $('#' + prefix + '_id').show();
            }
            else if (type === 'multiple_choice') {
                $('#' + prefix + '_mc').show();
            }
        };

        // Edit modal populate
        $('.edit-btn').on('click', function () {

            var type = $(this).data('type');

            $('#edit_id').val($(this).data('id'));
            $('#edit_points').val($(this).data('points'));
            $('#edit_type_display').val(
                type.replace(/_/g, ' ')
                    .replace(/\b\w/g, l => l.toUpperCase())
            );
            $('#edit_type_hidden').val(type);
            $('#edit_text').val($(this).data('text'));

            $('#edit_tf, #edit_id_group, #edit_mc').hide();

            if (type === 'true_false') {

                $('#edit_tf').show();

                if ($(this).data('answer') === 'True') {
                    $('#edit_tf_true').prop('checked', true);
                } else {
                    $('#edit_tf_false').prop('checked', true);
