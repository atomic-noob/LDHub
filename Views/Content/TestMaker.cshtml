@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Post and Pre Test Management";
    var trainings = ViewBag.Trainings as List<LDHub.Models.Training>;
    var selectedTraining = ViewBag.SelectedTraining as LDHub.Models.Training;
    var questions = ViewBag.Questions as List<LDHub.Models.Question>;
    var trainingId = ViewBag.TrainingId as int?;
}

@section Styles {
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />

    <style>
        @@media print {
            body * {
                visibility: hidden;
            }

            #printable-grades,
            #printable-grades * {
                visibility: visible;
            }

            #printable-grades {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
            }

            .print-header {
                display: block !important;
            }

            .no-print {
                display: none !important;
            }

            .table {
                font-size: 11px;
            }

            .badge {
                border: 1px solid #000;
                color: #000 !important;
                background: none !important;
            }
        }
    </style>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>Post and Pre Test Management</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Test Maker</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
       
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        <!-- Training Filter -->
        <div class="card card-outline card-info mb-3">
            <div class="card-header"><h3 class="card-title">Select Training</h3></div>
            <div class="card-body">
                <form method="get" id="filterForm">
                                <select class="form-control" name="trainingId"
                        onchange="this.form.submit()"
                        style="min-width:400px; display:inline-block;">
                    <option value="">-- Select Training --</option>
                    @foreach (var t in trainings)
                    {
                      <option value="@t.TrainingId"
                            selected="@(trainingId == t.TrainingId ? "selected" : null)">
                        @t.TrainingTitle —
                        @(t.StartDate?.ToString("MMM dd") ?? "N/A")
                        to
                        @(t.EndDate?.ToString("MMM dd, yyyy") ?? "N/A")
                    </option>
                    }
                </select>
                                </form>
                            </div>
                        </div>

        @if (trainingId != null && selectedTraining != null)
        {
            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4" id="testMakerTabs">
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#tab-questions">
                        <i class="fas fa-list mr-1"></i> Questions (@(questions?.Count ?? 0))
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#tab-add">
                        <i class="fas fa-plus mr-1"></i> Add Question
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#tab-settings">
                        <i class="fas fa-cog mr-1"></i> Test Settings
                    </a>
                </li>
                <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#tab-grades">
        <i class="fas fa-chart-bar mr-1"></i> Grades
    </a>
</li>
            </ul>

            <div class="tab-content">

                <!-- Questions List Tab -->
                <div class="tab-pane fade show active" id="tab-questions">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                Questions for <strong>@selectedTraining.TrainingTitle</strong>
                            </h3>
                            <div class="card-tools">
                                <span class="badge badge-info">
                                    Total: @(questions?.Sum(q => q.Points) ?? 0) pts
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (questions == null || !questions.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-2x mb-2 d-block" style="opacity:.3"></i>
                                    <p>No questions yet. Click <strong>Add Question</strong> tab to start.</p>
                                </div>
                            }
                            else
                            {
                                <table class="table table-bordered table-hover" id="questionsTable">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>#</th>
                                            <th>Type</th>
                                            <th>Question</th>
                                            <th>Answer</th>
                                            <th>Points</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int i = 1; }
                                        @foreach (var q in questions)
                                        {
                                            <tr>
                                                <td>@i</td>
                                                <td>
                                                    @{
                                                        var typeBadge = q.QuestionType switch
                                                        {
                                                            "true_false"      => "badge-primary",
                                                            "identification"  => "badge-info",
                                                            "multiple_choice" => "badge-warning",
                                                            _                 => "badge-secondary"
                                                        };
                                                        var typeLabel = q.QuestionType switch
                                                        {
                                                            "true_false"      => "True/False",
                                                            "identification"  => "Identification",
                                                            "multiple_choice" => "Multiple Choice",
                                                            _                 => q.QuestionType
                                                        };
                                                    }
                                                    <span class="badge @typeBadge">@typeLabel</span>
                                                </td>
                                                <td>@(q.QuestionText.Length > 80 ? q.QuestionText.Substring(0, 80) + "..." : q.QuestionText)</td>
                                                <td>@(q.CorrectAnswer ?? "N/A")</td>
                                                <td><strong>@q.Points pts</strong></td>
                                                <td>
                                                    <button class="btn btn-sm btn-info edit-btn"
                                                            data-id="@q.Id"
                                                            data-type="@q.QuestionType"
                                                            data-text="@q.QuestionText"
                                                            data-ca="@q.ChoiceA"
                                                            data-cb="@q.ChoiceB"
                                                            data-cc="@q.ChoiceC"
                                                            data-cd="@q.ChoiceD"
                                                            data-answer="@q.CorrectAnswer"
                                                            data-points="@q.Points"
                                                            data-toggle="modal" data-target="#editModal">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <form asp-action="DeleteQuestion2" method="post" style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="questionId" value="@q.Id" />
                                                        <input type="hidden" name="trainingId" value="@trainingId" />
                                                        <button type="submit" class="btn btn-sm btn-danger"
                                                                onclick="return confirm('Delete this question?')">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>

                <!-- Add Question Tab -->
                <div class="tab-pane fade" id="tab-add">
                    <div class="card card-outline card-success">
                        <div class="card-header"><h3 class="card-title">Add New Question</h3></div>
                        <div class="card-body">
                            <form asp-action="SaveQuestion" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="trainingId" value="@trainingId" />
                                <input type="hidden" name="questionId" value="0" />

                                <div class="form-group">
                                    <label>Points <span class="text-danger">*</span></label>
                                    <input type="number" step="0.01" min="0" class="form-control"
                                           name="points" value="1" style="max-width:150px;" required />
                                    <small class="text-muted">How many points this question is worth.</small>
                                </div>

                                <div class="form-group">
                                    <label>Question Type <span class="text-danger">*</span></label>
                                    <select class="form-control" name="questionType"
                                            id="add_qtype" onchange="toggleFields('add')" required
                                            style="max-width:300px;">
                                        <option value="">-- Select Type --</option>
                                        <option value="true_false">True / False</option>
                                        <option value="identification">Identification</option>
                                        <option value="multiple_choice">Multiple Choice</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Question Text <span class="text-danger">*</span></label>
                                    <textarea class="form-control" name="questionText" rows="3" required></textarea>
                                </div>

                                <!-- True/False -->
                                <div class="form-group" id="add_tf" style="display:none;">
                                    <label>Correct Answer</label><br />
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio"
                                               name="correctAnswerTf" value="True" />
                                        <label class="form-check-label">True</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio"
                                               name="correctAnswerTf" value="False" />
                                        <label class="form-check-label">False</label>
                                    </div>
                                </div>

                                <!-- Identification -->
                                <div class="form-group" id="add_id" style="display:none;">
                                    <label>Correct Answer</label>
                                    <input type="text" class="form-control" name="correctAnswerText"
                                           placeholder="Enter the correct answer" />
                                </div>

                                <!-- Multiple Choice -->
                                <div id="add_mc" style="display:none;">
                                    <div class="form-group">
                                        <label>Choices</label>
                                        <input type="text" class="form-control mb-2" name="choiceA" placeholder="Choice A" />
                                        <input type="text" class="form-control mb-2" name="choiceB" placeholder="Choice B" />
                                        <input type="text" class="form-control mb-2" name="choiceC" placeholder="Choice C" />
                                        <input type="text" class="form-control mb-2" name="choiceD" placeholder="Choice D" />
                                    </div>
                                    <div class="form-group">
                                        <label>Correct Answer</label>
                                        <select class="form-control" name="correctAnswer" style="max-width:200px;">
                                            <option value="">-- Select --</option>
                                            <option value="A">Choice A</option>
                                            <option value="B">Choice B</option>
                                            <option value="C">Choice C</option>
                                            <option value="D">Choice D</option>
                                        </select>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-success mt-2">
                                    <i class="fas fa-save mr-1"></i> Save Question
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Test Settings Tab -->
                <div class="tab-pane fade" id="tab-settings">
                    <div class="card card-outline card-warning">
                        <div class="card-header"><h3 class="card-title">Test Settings</h3></div>
                        <div class="card-body">
                            @{
                                var totalPts = questions?.Sum(q => q.Points) ?? 0;
                            }
                            <div class="row mb-4">
                                <div class="col-md-4">
                                    <div class="info-box">
                                        <span class="info-box-icon bg-info"><i class="fas fa-question-circle"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Total Questions</span>
                                            <span class="info-box-number">@(questions?.Count ?? 0)</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="info-box">
                                        <span class="info-box-icon bg-success"><i class="fas fa-star"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Total Points</span>
                                            <span class="info-box-number">@totalPts pts</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="info-box">
                                        <span class="info-box-icon bg-warning"><i class="fas fa-trophy"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Current Min Score</span>
                                            <span class="info-box-number">@selectedTraining.MinimumScore pts</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <form asp-action="SaveTestSettings" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="trainingId" value="@trainingId" />

                                <div class="form-group">
                                    <label>Minimum Passing Score (Points)</label>
                                    <input type="number" class="form-control" name="minimumScore"
                                           value="@selectedTraining.MinimumScore"
                                           min="0" max="@totalPts"
                                           style="max-width:200px;" required />
                                    <small class="text-muted">
                                        Participants must reach this score to earn a certificate.
                                        @if (totalPts > 0)
                                        {
                                            <text>Max allowed: @totalPts pts</text>
                                        }
                                    </small>
                                </div>

                                <div class="form-group">
                                    <label>Post-Test Timer (Minutes)</label>
                                    <input type="number" class="form-control" name="posttestTimer"
                                           value="@selectedTraining.PosttestTimer"
                                           min="0" style="max-width:200px;" required />
                                    <small class="text-muted">Example: 30 = 30 minutes time limit for post-test.</small>
                                </div>

                                <button type="submit" class="btn btn-warning">
                                    <i class="fas fa-save mr-1"></i> Save Settings
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                                    <!-- Grades Tab -->
                    <div class="tab-pane fade" id="tab-grades">
                        @{
                            var grades = ViewBag.Grades as List<LDHub.Models.GradeRow> ?? new List<LDHub.Models.GradeRow>();
                            var totalPtsG = questions?.Sum(q => q.Points) ?? 0;
                        }
                        <div class="card card-outline card-info">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fas fa-chart-bar mr-2"></i>
                                    Grades — <strong>@selectedTraining.TrainingTitle</strong>
                                    <small class="text-muted ml-2">
                                        (@(selectedTraining.StartDate?.ToString("MMM dd") ?? "N/A") –
                                        @(selectedTraining.EndDate?.ToString("MMM dd, yyyy") ?? "N/A"))
                                    </small>
                                </h3>
                                @if (grades.Any())
                                {
                                    <div class="card-tools">
                                        <button class="btn btn-sm btn-success" onclick="printGrades()">
                                            <i class="fas fa-print mr-1"></i> Print
                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="card-body">
                                @if (!grades.Any())
                                {
                                    <div class="text-center text-muted py-4">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block" style="opacity:.3"></i>
                                        <p>No test attempts recorded for this training yet.</p>
                                    </div>
                                }
                                else
                                {
                                    <!-- Summary Cards -->
                                    <div class="row mb-4">
                                        <div class="col-md-3">
                                            <div class="info-box">
                                                <span class="info-box-icon bg-info"><i class="fas fa-users"></i></span>
                                                <div class="info-box-content">
                                                    <span class="info-box-text">Total Participants</span>
                                                    <span class="info-box-number">@grades.Count</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="info-box">
                                                <span class="info-box-icon bg-success"><i class="fas fa-check-circle"></i></span>
                                                <div class="info-box-content">
                                                    <span class="info-box-text">Passed</span>
                                                    <span class="info-box-number">@grades.Count(g => g.PostTestPassed)</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="info-box">
                                                <span class="info-box-icon bg-danger"><i class="fas fa-times-circle"></i></span>
                                                <div class="info-box-content">
                                                    <span class="info-box-text">Failed</span>
                                                    <span class="info-box-number">@grades.Count(g => !g.PostTestPassed && g.PostTestScore.HasValue)</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="info-box">
                                                <span class="info-box-icon bg-warning"><i class="fas fa-clock"></i></span>
                                                <div class="info-box-content">
                                                    <span class="info-box-text">Not Yet Taken</span>
                                                    <span class="info-box-number">@grades.Count(g => !g.PostTestScore.HasValue)</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Printable Table -->
                                    <div id="printable-grades">
                                        <div class="print-header" style="display:none;">
                                            <h4>@selectedTraining.TrainingTitle — Grade Report</h4>
                                            <p>
                                                @(selectedTraining.StartDate?.ToString("MMM dd") ?? "N/A") –
                                                @(selectedTraining.EndDate?.ToString("MMM dd, yyyy") ?? "N/A")
                                                &nbsp;|&nbsp; Min Score: @selectedTraining.MinimumScore pts
                                                &nbsp;|&nbsp; Printed: @DateTime.Now.ToString("MMM dd, yyyy hh:mm tt")
                                            </p>
                                            <hr />
                                        </div>

                                        <table class="table table-bordered table-hover table-sm" id="gradesTable">
                                            <thead class="thead-dark">
                                                <tr>
                                                    <th>#</th>
                                                    <th>Employee Name</th>
                                                    <th>Pre-Test</th>
                                                    <th>Post-Test <small>(Best of 3)</small></th>
                                                    <th>Attempts</th>
                                                    <th>Difference</th>
                                                    <th>Status</th>
                                                    <th class="no-print">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{ int gRow = 1; }
                                                @foreach (var g in grades.OrderBy(g => g.EmployeeName))
                                                {
                                                    var diff = g.PostTestScore.HasValue && g.PreTestScore.HasValue
                                                        ? g.PostTestScore.Value - g.PreTestScore.Value
                                                        : (decimal?)null;
                                                    var diffClass = diff.HasValue
                                                        ? (diff > 0 ? "text-success" : diff < 0 ? "text-danger" : "text-muted")
                                                        : "text-muted";
                                                   var diffText = diff.HasValue
    ? (diff > 0 ? $"+{diff.Value.ToString("0.##")}" : diff.Value.ToString("0.##"))
    : "—";
                                                    var denom = totalPtsG > 0 ? totalPtsG : 1;

                                                    <tr>
                                                        <td>@gRow</td>
                                                        <td><strong>@g.EmployeeName</strong></td>
                                                        <td>
                                                            @if (g.PreTestScore.HasValue)
                                                            {
                                                                <span>@g.PreTestScore.Value.ToString("0.##") / @totalPtsG.ToString("0.##")</span>
                                                                <small class="text-muted">(@Math.Round(g.PreTestScore.Value / denom * 100)%)</small>
                                                            }
                                                            else { <span class="text-muted">Not taken</span> }
                                                        </td>
                                                        <td>
                                                            @if (g.PostTestScore.HasValue)
                                                            {
                                                               <span>@g.PostTestScore.Value.ToString("0.##") / @totalPtsG.ToString("0.##")</span>
                                                                <small class="text-muted">(@Math.Round(g.PostTestScore.Value / denom * 100)%)</small>
                                                            }
                                                            else { <span class="text-muted">Not taken</span> }
                                                        </td>
                                                        <td>
                                                            @if (g.PostTestAttempts > 0)
                                                            {
                                                                <span class="badge @(g.PostTestAttempts >= 3 ? "badge-danger" : "badge-secondary")">
                                                                    @g.PostTestAttempts / 3
                                                                </span>
                                                            }
                                                            else { <span class="text-muted">—</span> }
                                                        </td>
                                                        <td class="@diffClass font-weight-bold">@diffText</td>
                                                        <td>
                                                            @if (!g.PostTestScore.HasValue)
                                                            {
                                                                <span class="badge badge-secondary">Pending</span>
                                                            }
                                                            else if (g.PostTestPassed)
                                                            {
                                                                <span class="badge badge-success">Passed</span>
                                                            }
                                                            else if (g.PostTestAttempts >= 3)
                                                            {
                                                                <span class="badge badge-danger">Failed — Max Attempts</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge badge-warning">Failed (@(3 - g.PostTestAttempts) left)</span>
                                                            }
                                                        </td>
                                                        <td class="no-print">
                                                            @if (g.PostTestAttempts >= 3 && !g.PostTestPassed)
                                                            {
                                                                <form asp-action="ResetAttempts" method="post" style="display:inline;">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="userId" value="@g.UserId" />
                                                                    <input type="hidden" name="trainingId" value="@trainingId" />
                                                                    <button type="submit" class="btn btn-xs btn-warning"
                                                                            onclick="return confirm('Reset attempts for @g.EmployeeName?')">
                                                                        <i class="fas fa-redo"></i> Reset
                                                                    </button>
                                                                </form>
                                                            }
                                                            else { <span class="text-muted">—</span> }
                                                        </td>
                                                    </tr>
                                                    gRow++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>


            </div>
        }

    </div>
</section>

<!-- Edit Question Modal -->
<div class="modal fade" id="editModal" tabindex="-1" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit mr-1"></i> Edit Question</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form asp-action="SaveQuestion" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="trainingId" value="@trainingId" />
                <input type="hidden" name="questionId" id="edit_id" />
                <div class="modal-body">

                    <div class="form-group">
                        <label>Points</label>
                        <input type="number" step="0.01" min="0" class="form-control"
                               name="points" id="edit_points" style="max-width:150px;" required />
                    </div>

                    <div class="form-group">
                        <label>Question Type</label>
                        <input type="text" class="form-control" id="edit_type_display" disabled
                               style="max-width:200px;" />
                        <input type="hidden" name="questionType" id="edit_type_hidden" />
                    </div>

                    <div class="form-group">
                        <label>Question Text</label>
                        <textarea class="form-control" name="questionText" id="edit_text" rows="3" required></textarea>
                    </div>

                    <!-- True/False -->
                    <div class="form-group" id="edit_tf" style="display:none;">
                        <label>Correct Answer</label><br />
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="correctAnswerTf"
                                   id="edit_tf_true" value="True" />
                            <label class="form-check-label">True</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="correctAnswerTf"
                                   id="edit_tf_false" value="False" />
                            <label class="form-check-label">False</label>
                        </div>
                    </div>

                    <!-- Identification -->
                    <div class="form-group" id="edit_id_group" style="display:none;">
                        <label>Correct Answer</label>
                        <input type="text" class="form-control" name="correctAnswerText" id="edit_answer_text" />
                    </div>

                    <!-- Multiple Choice -->
                    <div id="edit_mc" style="display:none;">
                        <div class="form-group">
                            <label>Choices</label>
                            <input type="text" class="form-control mb-2" name="choiceA" id="edit_ca" placeholder="Choice A" />
                            <input type="text" class="form-control mb-2" name="choiceB" id="edit_cb" placeholder="Choice B" />
                            <input type="text" class="form-control mb-2" name="choiceC" id="edit_cc" placeholder="Choice C" />
                            <input type="text" class="form-control mb-2" name="choiceD" id="edit_cd" placeholder="Choice D" />
