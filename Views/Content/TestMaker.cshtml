            } else if (type === 'identification') {

                $('#edit_id_group').show();
                $('#edit_answer_text').val($(this).data('answer'));

            } else if (type === 'multiple_choice') {

                $('#edit_mc').show();

                $('#edit_ca').val($(this).data('ca'));
