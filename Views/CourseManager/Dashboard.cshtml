@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Course Manager Dashboard";

    var trainings             = ViewBag.Trainings             as List<LDHub.Models.Training> ?? new();
    var totalTrainings        = ViewBag.TotalTrainings        as int? ?? 0;
    var ongoingTrainings      = ViewBag.OngoingTrainings      as int? ?? 0;
    var upcomingTrainings     = ViewBag.UpcomingTrainings     as int? ?? 0;
    var completedTrainings    = ViewBag.CompletedTrainings    as int? ?? 0;
    var totalParticipants     = ViewBag.TotalParticipants     as int? ?? 0;
    var completedParticipants = ViewBag.CompletedParticipants as int? ?? 0;
    var enrolledParticipants  = ViewBag.EnrolledParticipants  as int? ?? 0;
    var now                   = DateTime.Now;
}

@section Styles {
    <style>
        body { background: #f4fdf6; }
        .content-wrapper { background: linear-gradient(180deg,#fff 0%,#f4fff7 100%); }
        .success-gradient { background: linear-gradient(225deg,#9BEC00,#4BB543,#117554); color:white; }

        .welcome-banner {
            background: linear-gradient(135deg,#117554,#4BB543);
            color:white; border-radius:10px; padding:22px 28px;
            margin-bottom:25px; box-shadow:0 4px 15px rgba(75,181,67,.3);
        }
        .welcome-banner h4 { font-weight:800; margin-bottom:3px; }
        .welcome-banner p  { opacity:.85; margin-bottom:0; font-size:.92rem; }

       .kpi-card {
    background: #ffffff;
    border-radius:10px; padding:18px 20px;
    box-shadow: 0 4px 16px rgba(17,117,84,0.10), 0 1px 4px rgba(75,181,67,0.08);
    margin-bottom:20px;
    display:flex; align-items:center; justify-content:space-between;
    border-left: 4px solid #4BB543;
    transition: box-shadow 0.25s, transform 0.25s;
    color: inherit;
}
.kpi-card:hover {
    box-shadow: 0 8px 24px rgba(17,117,84,0.15), 0 2px 8px rgba(75,181,67,0.12);
    transform: translateY(-2px);
}
.kpi-card .num   { font-size:2.2rem; font-weight:800; line-height:1; color:#1b3a2d; }
.kpi-card .label { font-size:.82rem; color:#6c757d; margin-top:4px; }
.kpi-card .icon  { font-size:2.8rem; color:#4BB543; opacity:.2; }

        .chart-card { border-radius:10px; box-shadow:0 2px 10px rgba(0,0,0,.08); margin-bottom:20px; }

        .training-status-badge {
            border-radius:20px; padding:3px 12px;
            font-size:.75rem; font-weight:700;
        }
        .badge-ongoing  { background:#d4edda; color:#155724; }
        .badge-upcoming { background:#cce5ff; color:#004085; }
        .badge-ended    { background:#e2e3e5; color:#383d41; }
    </style>
}



<section class="content">
    <div class="container-fluid">

        @* ── Welcome Banner ── *@
        <div class="welcome-banner">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h4><i class="fas fa-chalkboard-teacher mr-2"></i>Welcome, @ViewBag.UserName!</h4>
                    <p>
                        <i class="fas fa-calendar mr-1"></i>
                        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                        &nbsp;|&nbsp; DENR L&amp;D Hub — Course Manager Portal
                    </p>
                </div>
                <i class="fas fa-book fa-3x" style="opacity:.3;"></i>
            </div>
        </div>

      @* ── KPI Cards Row 1 ── *@
<div class="row">
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@totalTrainings</div><div class="label">Total Trainings</div></div>
            <i class="fas fa-book icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@ongoingTrainings</div><div class="label">Ongoing Trainings</div></div>
            <i class="fas fa-spinner icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@upcomingTrainings</div><div class="label">Upcoming Trainings</div></div>
            <i class="fas fa-calendar icon"></i>
        </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@completedTrainings</div><div class="label">Ended Trainings</div></div>
            <i class="fas fa-flag-checkered icon"></i>
        </div>
    </div>
</div>

@* ── KPI Cards Row 2 ── *@
<div class="row">
    <div class="col-lg-4 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@totalParticipants</div><div class="label">Total Participants</div></div>
            <i class="fas fa-users icon"></i>
        </div>
    </div>
    <div class="col-lg-4 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@enrolledParticipants</div><div class="label">Currently Enrolled</div></div>
            <i class="fas fa-user-check icon"></i>
        </div>
    </div>
    <div class="col-lg-4 col-md-4 col-6">
        <div class="kpi-card">
            <div><div class="num">@completedParticipants</div><div class="label">Participants Completed</div></div>
            <i class="fas fa-user-graduate icon"></i>
        </div>
    </div>
</div>

        @* ── Charts Row ── *@
        <div class="row">

            @* Bar chart — participants per training *@
            <div class="col-lg-8">
                <div class="card chart-card">
                   <div class="card-header">
    <h3 class="card-title">
        <i class="fas fa-chart-bar mr-2"></i>Participants per Training (Top 6)
    </h3>
</div>
                    <div class="card-body">
                        <canvas id="participantsChart" height="120"></canvas>
                    </div>
                </div>
            </div>

            @* Doughnut chart — completion status *@
            <div class="col-lg-4">
                <div class="card chart-card">
                    <div class="card-header ">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie mr-2"></i>Participant Status
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="statusChart" height="200"></canvas>
                        <div class="mt-3 text-center" style="font-size:.82rem;">
                            <span class="mr-3"><span style="color:#4BB543;">●</span> Completed (@completedParticipants)</span>
                            <span class="mr-3"><span style="color:#0984e3;">●</span> Enrolled (@enrolledParticipants)</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

       

    </div>
</section>

@section Scripts {
<script src="~/plugins/chart.js/Chart.min.js"></script>
<script>
    var GREEN  = '#4BB543';
    var BLUE   = '#0984e3';
    var ORANGE = '#e17055';

    // ── Bar chart: participants per training ──
    var ptData   = @Html.Raw(ViewBag.ParticipantsPerTraining ?? "[]");
    var ptLabels = ptData.map(function(d) { return d.Title; });
    var ptCounts = ptData.map(function(d) { return d.Count; });

    new Chart(document.getElementById('participantsChart'), {
        type: 'bar',
        data: {
            labels: ptLabels,
            datasets: [{
                label: 'Participants',
                data: ptCounts,
                backgroundColor: GREEN,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });

    // ── Doughnut chart: completion status ──
    var sd = @Html.Raw(ViewBag.StatusBreakdown ?? "{}");

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: ['Completed', 'Enrolled', 'In Progress'],
            datasets: [{
                data: [sd.Completed, sd.Enrolled, sd.InProgress],
                backgroundColor: [GREEN, BLUE, ORANGE],
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } }
        }
    });
</script>
}
