@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Course Manager Dashboard";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">Course Manager Dashboard</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <h5>Welcome, @ViewBag.UserName! 👋</h5>
                <p class="text-muted">
                    This is your Course Manager Dashboard.
                    Trainings and modules will appear here.
                </p>
            </div>
        </div>
    </div>
</section>