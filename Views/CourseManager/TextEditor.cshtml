@model LDHub.Models.TrainingModule

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Text Editor";
    var content = Model.TextContent;
    var topics = content?.Topics?.OrderBy(t => t.SortOrder).ToList()
                 ?? new List<LDHub.Models.ModuleTextTopic>();
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-align-left mr-2"></i>Text Editor</h1>
                <small class="text-muted">
                    @Model.Training?.TrainingTitle — @Model.ModuleName : <strong>@Model.ModuleDescription</strong>
                </small>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a asp-controller="CourseManager" asp-action="Modules"
                           asp-route-trainingId="@Model.TrainingId">Modules</a>
                    </li>
                    <li class="breadcrumb-item active">Text Editor</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <form asp-controller="CourseManager" asp-action="SaveTextContent"
              method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="moduleId" value="@Model.ModuleId" />
            <input type="hidden" name="contentId" value="@(content?.ContentId ?? 0)" />

            <!-- Introduction -->
            <div class="card card-outline card-info mb-4">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-book-open mr-1"></i> Introduction</h3>
                </div>
                <div class="card-body">
                    <textarea class="form-control" name="introduction" rows="6"
                              placeholder="Write the introduction for this module...">@(content?.Introduction ?? "")</textarea>
                </div>
            </div>

            <!-- Topics -->
            <div class="card card-outline card-info mb-4">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-list-ul mr-1"></i> Topics</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-sm btn-outline-info" id="addTopicBtn">
                            <i class="fas fa-plus mr-1"></i> Add Topic
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="topicsContainer">
                        @if (!topics.Any())
                        {
                            <p class="text-muted text-center" id="noTopicsMsg">
                                <i class="fas fa-info-circle mr-1"></i>
                                No topics yet. Click "Add Topic" to start.
                            </p>
                        }
                        else
                        {
                            @for (int i = 0; i < topics.Count; i++)
                            {
                                var topic = topics[i];
                                <div class="topic-card border rounded p-3 mb-3">
                                    <div class="d-flex justify-content-between mb-2">
                                        <strong class="text-muted">Topic @(i + 1)</strong>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-topic">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                    <div class="form-group">
                                        <label>Topic Title <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" name="topicTitles"
                                               value="@topic.TopicTitle" required />
                                    </div>
                                    <div class="form-group">
                                        <label>Topic Body</label>
                                        <textarea class="form-control" name="topicBodies"
                                                  rows="4">@(topic.TopicBody ?? "")</textarea>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- References -->
            <div class="card card-outline card-info mb-4">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-book mr-1"></i> References</h3>
                </div>
                <div class="card-body">
                    <textarea class="form-control" name="referencesText" rows="5"
                              placeholder="List references, sources, or further reading...">@(content?.ReferencesText ?? "")</textarea>
                </div>
            </div>

            <div class="text-right mb-4">
                <a asp-controller="CourseManager" asp-action="Modules"
                   asp-route-trainingId="@Model.TrainingId" class="btn btn-secondary mr-2">
                    <i class="fas fa-arrow-left mr-1"></i> Back
                </a>
                <button type="submit" class="btn btn-info btn-lg">
                    <i class="fas fa-save mr-1"></i> Save Text Content
                </button>
            </div>
        </form>
    </div>
</section>

<!-- Topic Template -->
<template id="topicTemplate">
    <div class="topic-card border rounded p-3 mb-3">
        <div class="d-flex justify-content-between mb-2">
            <strong class="text-muted">Topic #</strong>
            <button type="button" class="btn btn-sm btn-outline-danger remove-topic">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="form-group">
            <label>Topic Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="topicTitles"
                   placeholder="Enter topic title" required />
        </div>
        <div class="form-group">
            <label>Topic Body</label>
            <textarea class="form-control" name="topicBodies" rows="4"
                      placeholder="Write topic content..."></textarea>
        </div>
    </div>
</template>

@section Scripts {
<script>
$(document).ready(function() {

    function renumber() {
        $('#topicsContainer .topic-card').each(function(i) {
            $(this).find('strong').text('Topic ' + (i + 1));
        });
        $('#noTopicsMsg').toggle($('#topicsContainer .topic-card').length === 0);
    }

    $('#addTopicBtn').on('click', function() {
        var template = document.getElementById('topicTemplate');
        var clone = document.importNode(template.content, true);
        $('#topicsContainer').append(clone);
        $('#noTopicsMsg').hide();
        renumber();
    });

    $(document).on('click', '.remove-topic', function() {
        $(this).closest('.topic-card').remove();
        renumber();
    });

});
</script>
}