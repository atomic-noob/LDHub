@model List<LDHub.Models.Training>
@{
    ViewData["Title"] = "Discussion Boards";
    var counts = ViewBag.PostCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<section class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">Discussion Boards</h1>
        <p class="text-muted mb-0">Pick a training to read announcements and join the discussion.</p>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (!Model.Any())
        {
            <div class="card">
                <div class="card-body text-center text-muted p-4">
                    <i class="far fa-comments fa-2x mb-2"></i>
                    <div>No trainings available yet.</div>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var t in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title mb-1">@t.TrainingTitle</h5>
                                <div class="text-muted small mb-2">
                                    @(t.StartDate.HasValue ? t.StartDate.Value.ToString("MMM d, yyyy") : "Date to be announced")
                                </div>
                                <div class="mb-3">
                                    <i class="far fa-comments mr-1"></i>
                                    @(counts.ContainsKey(t.TrainingId) ? counts[t.TrainingId] : 0) topics
                                </div>
                                <a asp-controller="Discussion" asp-action="Board" asp-route-trainingId="@t.TrainingId"
                                   class="btn btn-primary btn-sm">Open board</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
