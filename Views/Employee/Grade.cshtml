@using LDHub.Models.ViewModels
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Grades";
    var gradeRows = ViewBag.GradeRows as List<EmployeeGradeViewModel> ?? new List<EmployeeGradeViewModel>();
}

@section Styles {
    <style>
        body { background: #f4fdf6; }
        .content-wrapper { background: linear-gradient(180deg,#fff 0%,#f4fff7 100%); }
        .success-gradient { background: linear-gradient(225deg,#9BEC00,#4BB543,#117554); color:white; }
        .score-box { background: #e8f5e9; border-radius: 8px; padding: 15px; text-align: center; }
        .score-box h4 { margin-bottom: 2px; font-weight: 800; }
        .diff-pos  { color: #4BB543; font-weight: bold; }
        .diff-neg  { color: #dc3545; font-weight: bold; }
        .diff-zero { color: #6c757d; }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">My Grades</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">My Grades</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (!gradeRows.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="fas fa-graduation-cap fa-3x mb-3" style="color:#c8e6c9;opacity:.6;"></i>
                    <h5 class="text-muted">No training grades yet.</h5>
                    <p class="text-muted small">You will see your grades here after taking tests.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var row in gradeRows)
            {
                var denom      = row.TotalPoints > 0 ? row.TotalPoints : 1;
                var diffClass  = row.Difference.HasValue
                    ? (row.Difference > 0 ? "diff-pos" : row.Difference < 0 ? "diff-neg" : "diff-zero")
                    : "diff-zero";
                var diffText   = row.Difference.HasValue
                    ? (row.Difference >= 0 ? $"+{row.Difference.Value.ToString("0.##")}" : row.Difference.Value.ToString("0.##"))
                    : "—";
                var statusBadge = row.CompletionStatus switch
                {
                    "Completed"   => "badge-success",
                    "In Progress" => "badge-primary",
                    "Failed"      => "badge-danger",
                    _             => "badge-secondary"
                };

                <div class="card shadow-sm mb-4">
                    <div class="card-header success-gradient">
                        <h3 class="card-title">
                            <i class="fas fa-book mr-2"></i>
                            @row.Training?.TrainingTitle
                            <small class="ml-2" style="opacity:.7; font-size:.8rem;">@row.Training?.TrainingCode</small>
                        </h3>
                        <div class="card-tools">
                            <span class="badge @statusBadge">@row.CompletionStatus</span>
                        </div>
                    </div>
                    <div class="card-body">

                        @* Training Info *@
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <small class="text-muted">Date</small>
                                <strong class="d-block" style="font-size:.85rem;">
                                    @(row.Training?.StartDate?.ToString("MMM dd") ?? "TBD") –
                                    @(row.Training?.EndDate?.ToString("MMM dd, yyyy") ?? "TBD")
                                </strong>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Location</small>
                                <strong class="d-block" style="font-size:.85rem;">@(row.Training?.Location ?? "—")</strong>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Total Points</small>
                                <strong class="d-block" style="font-size:.85rem;">@row.TotalPoints.ToString("0.##") pts</strong>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Min Passing Score</small>
                                <strong class="d-block" style="font-size:.85rem;">@(row.Training?.MinimumScore ?? 0) pts</strong>
                            </div>
                        </div>

                        @* Score Summary *@
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <div class="score-box">
                                    <small class="text-muted d-block mb-1">Pre-Test Score</small>
                                    @if (row.PreTestScore.HasValue)
                                    {
                                        <h4 class="text-primary">
                                            @row.PreTestScore.Value.ToString("0.##")
                                            <small class="text-muted" style="font-size:.65rem;">/ @row.TotalPoints.ToString("0.##")</small>
                                        </h4>
                                        <small class="text-muted">(@Math.Round(row.PreTestScore.Value / denom * 100, 1)%)</small>
                                    }
                                    else
                                    {
                                        <h4 class="text-muted">—</h4>
                                        <small class="text-muted">Not taken</small>
                                    }
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="score-box">
                                    <small class="text-muted d-block mb-1">Post-Test Score</small>
                                    @if (row.PostTestScore.HasValue)
                                    {
                                        <h4 class="@(row.PostTestPassed ? "text-success" : "text-danger")">
                                            @row.PostTestScore.Value.ToString("0.##")
                                            <small class="text-muted" style="font-size:.65rem;">/ @row.TotalPoints.ToString("0.##")</small>
                                        </h4>
                                        <small class="text-muted">(@Math.Round(row.PostTestScore.Value / denom * 100, 1)%)</small>
                                    }
                                    else
                                    {
                                        <h4 class="text-muted">—</h4>
                                        <small class="text-muted">Not taken</small>
                                    }
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="score-box">
                                    <small class="text-muted d-block mb-1">Learning Gain</small>
                                    <h4 class="@diffClass">@diffText</h4>
                                    <small class="text-muted">Post − Pre</small>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="score-box">
                                    <small class="text-muted d-block mb-1">Post-Test Status</small>
                                    @if (!row.PostTestScore.HasValue)
                                    {
                                        <span class="badge badge-warning" style="font-size:.85rem;">Pending</span>
                                        <small class="text-muted d-block">@row.PostAttempts / 3 attempts</small>
                                    }
                                    else if (row.PostTestPassed)
                                    {
                                        <span class="badge badge-success" style="font-size:.85rem;">
                                            <i class="fas fa-check mr-1"></i>Passed
                                        </span>
                                        <small class="text-muted d-block">@row.PostAttempts / 3 attempts</small>
                                    }
                                    else if (row.PostAttempts >= 3)
                                    {
                                        <span class="badge badge-danger" style="font-size:.85rem;">Failed</span>
                                        <small class="text-muted d-block">All 3 attempts used</small>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning" style="font-size:.85rem;">Failed</span>
                                        <small class="text-muted d-block">@row.PostAttempts / 3 attempts</small>
                                    }
                                </div>
                            </div>
                        </div>

                        @* Quiz Scores *@
                        @if (row.QuizAttempts.Any())
                        {
                            <hr />
                            <h6 class="font-weight-bold text-muted mb-2">
                                <i class="fas fa-pencil-alt mr-1"></i> Module Quiz Scores
                            </h6>
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Module</th>
                                        <th>Quiz</th>
                                        <th>Score</th>
                                        <th>Passing</th>
                                        <th>Status</th>
                                        <th>Date Taken</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var qa in row.QuizAttempts)
                                    {
                                        <tr style="font-size:.85rem; background:#f8fff8;">
                                            <td>@(qa.Module?.ModuleName ?? "—")</td>
                                            <td>@(qa.Quiz?.QuizTitle ?? "—")</td>
                                            <td>
                                                <strong>@qa.CorrectCount / @qa.TotalQuestions</strong>
                                                <small class="text-muted">(@qa.ScorePercentage%)</small>
                                            </td>
                                            <td>@(qa.Quiz?.PassingScore ?? 0)%</td>
                                            <td>
                                                <span class="badge @(qa.IsPassed ? "badge-success" : "badge-danger")">
                                                    @(qa.IsPassed ? "Passed" : "Failed")
                                                </span>
                                            </td>
                                            <td><small>@qa.TakenAt.ToString("MMM dd, yyyy hh:mm tt")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <hr />
                            <p class="text-muted small mb-0">
                                <i class="fas fa-info-circle mr-1"></i> No module quiz scores yet.
                            </p>
                        }

                    </div>
                </div>
            }
        }

    </div>
</section>
