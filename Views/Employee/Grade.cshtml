@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Grade Dashboard";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Grade Dashboard</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Grade Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h5>Welcome, @ViewBag.UserName! 👋</h5>
                        <p class="text-muted">
                            This is your Grade Dashboard. 
                            Your trainings and progress will appear here.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>