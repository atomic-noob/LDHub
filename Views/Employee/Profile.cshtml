@model LDHub.Models.User
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";
    var trainings = ViewBag.Trainings as List<LDHub.Models.TrainingParticipant> 
                    ?? new List<LDHub.Models.TrainingParticipant>();
}

@section Styles {
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">My Profile</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Profile</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="icon fas fa-check"></i> @TempData["Success"]
            </div>
        }

        <div class="row">

            @* ── Profile Card ── *@
            <div class="col-md-4">
                <div class="card card-primary card-outline">
                    <div class="card-body box-profile">
                        <div class="text-center">
                            @if (!string.IsNullOrEmpty(Model.Photo))
                            {
                                <img src="~/uploads/photos/@Model.Photo"
                                     class="profile-user-img img-fluid img-circle"
                                     alt="Profile Photo" />
                            }
                            else
                            {
                                <img src="~/dist/img/user2-160x160.jpg"
                                     class="profile-user-img img-fluid img-circle"
                                     alt="Default Photo" />
                            }
                        </div>
                        <h3 class="profile-username text-center mt-3">
                            @Model.FirstName @Model.LastName
                        </h3>
                        <p class="text-muted text-center">@(Model.Position ?? "—")</p>

                        <ul class="list-group list-group-unbordered mb-3">
                            <li class="list-group-item">
                                <b>Region</b>
                                <span class="float-right">@(Model.Region?.RegionName ?? "—")</span>
                            </li>
                            <li class="list-group-item">
                                <b>Office</b>
                                <span class="float-right">@(Model.Office?.OfficeName ?? "—")</span>
                            </li>
                            <li class="list-group-item">
                                <b>Division</b>
                                <span class="float-right">@(Model.Division?.DivisionName ?? "—")</span>
                            </li>
                            <li class="list-group-item">
                                <b>Salary Grade</b>
                                <span class="float-right">@(Model.SalaryGrade?.ToString() ?? "—")</span>
                            </li>
                            <li class="list-group-item">
                                <b>Status</b>
                                <span class="float-right">
                                    <span class="badge badge-success">@Model.Status</span>
                                </span>
                            </li>
                        </ul>

                        <div class="text-center">
                            @foreach (var role in Model.UserRoles)
                            {
                                <span class="badge badge-primary mr-1">@role.Role</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* ── Edit Profile Form ── *@
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-edit mr-2"></i> Edit Profile
                        </h3>
                    </div>
                    <form asp-action="UpdateProfile" method="post">
                        @Html.AntiForgeryToken()
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>First Name <span class="text-danger">*</span></label>
                                        <input type="text" name="FirstName"
                                               value="@Model.FirstName"
                                               class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Middle Name</label>
                                        <input type="text" name="MiddleName"
                                               value="@Model.MiddleName"
                                               class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Last Name <span class="text-danger">*</span></label>
                                        <input type="text" name="LastName"
                                               value="@Model.LastName"
                                               class="form-control" required />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Contact Number</label>
                                        <input type="text" name="ContactNumber"
                                               value="@Model.ContactNumber"
                                               class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Gender</label>
                                                                        <select name="Gender" class="form-control">
                                        @if (Model.Gender == "Male")
                                        {
                                            <option value="Male" selected>Male</option>
                                            <option value="Female">Female</option>
                                        }
                                        else
                                        {
                                            <option value="Male">Male</option>
                                            <option value="Female" selected>Female</option>
                                        }
                                    </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Age</label>
                                        <input type="number" name="Age"
                                               value="@Model.Age"
                                               class="form-control" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Email</label>
                                        <input type="text" value="@Model.Email"
                                               class="form-control" readonly />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Position</label>
                                        <input type="text" value="@Model.Position"
                                               class="form-control" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save mr-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>

        @* ── Training List ── *@
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-list mr-2"></i> My Trainings
                </h3>
            </div>
            <div class="card-body">
                <table id="trainingsTable" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Training Code</th>
                            <th>Training Title</th>
                            <th>Location</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Hours</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tp in trainings)
                        {
                            var status     = "Scheduled";
                            var badgeClass = "badge-success";
                            if (DateTime.Now >= tp.Training?.StartDate &&
                                DateTime.Now <= tp.Training?.EndDate)
                            { status = "Ongoing"; badgeClass = "badge-primary"; }
                            else if (DateTime.Now > tp.Training?.EndDate)
                            { status = "Ended"; badgeClass = "badge-danger"; }

                            <tr>
                                <td>@tp.TrainingId</td>
                                <td>@tp.Training?.TrainingCode</td>
                                <td>@tp.Training?.TrainingTitle</td>
                                <td>@(tp.Training?.Location ?? "—")</td>
                                <td>@tp.Training?.StartDate?.ToString("MMM dd, yyyy")</td>
                                <td>@tp.Training?.EndDate?.ToString("MMM dd, yyyy")</td>
                                <td>@tp.Training?.TrainingHrs hrs</td>
                                <td><span class="badge @badgeClass">@status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* ── Certificate Gallery ── *@
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-certificate mr-2"></i> My Certificates
                </h3>
            </div>
            <div class="card-body">
                @if (!trainings.Any(tp => tp.CompletionStatus == "Completed"))
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-certificate fa-3x mb-3"></i>
                        <p>No certificates yet. Complete a training to earn your certificate!</p>
                    </div>
                }
                else
                {
                    <div class="row">
                        @foreach (var tp in trainings.Where(tp => tp.CompletionStatus == "Completed"))
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card card-outline card-success">
                                    <div class="card-body text-center">
                                        <i class="fas fa-award fa-3x text-success mb-2"></i>
                                        <h6 class="font-weight-bold">@tp.Training?.TrainingTitle</h6>
                                        <p class="text-muted" style="font-size:.82rem;">
                                            @tp.Training?.TrainingCode
                                        </p>
                                        <p class="text-muted" style="font-size:.82rem;">
                                            Completed: @tp.Training?.EndDate?.ToString("MMM dd, yyyy")
                                        </p>
                                        <button class="btn btn-success btn-sm" disabled>
                                            <i class="fas fa-download mr-1"></i> Download
                                            <small>(Coming Soon)</small>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(function () {
            $('#trainingsTable').DataTable({ responsive: true, autoWidth: false });
        });
    </script>
}