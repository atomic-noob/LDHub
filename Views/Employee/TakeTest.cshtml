@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var training     = ViewBag.Training  as LDHub.Models.Training;
    var questions    = ViewBag.Questions as List<LDHub.Models.Question> 
                       ?? new List<LDHub.Models.Question>();
    var testType     = ViewBag.TestType  as string ?? "PreTest";
    var attemptNumber = ViewBag.AttemptNumber as int? ?? 1;
    var timerMinutes  = ViewBag.Timer    as int? ?? 0;
    var isPostTest    = testType == "PostTest";

    ViewData["Title"] = isPostTest ? "Post-Test" : "Pre-Test";
}

@section Styles {
    <style>
        body { background: #f4fdf6; }
        .content-wrapper { background: linear-gradient(180deg, #ffffff 0%, #f4fff7 100%); }
        .success-gradient { background: linear-gradient(225deg, #9BEC00, #4BB543, #117554); color: white; }
        .question-card {
            border-left: 4px solid #4BB543;
            margin-bottom: 20px;
            border-radius: 5px;
        }
        .question-number {
            background: linear-gradient(225deg, #9BEC00, #4BB543, #117554);
            color: white;
            width: 32px; height: 32px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 0.85rem;
            margin-right: 10px;
            flex-shrink: 0;
        }
        .timer-box {
            position: sticky;
            top: 60px;
            z-index: 100;
            background: #fff;
            border: 2px solid #dc3545;
            border-radius: 8px;
            padding: 10px 20px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(220,53,69,.2);
        }
        .timer-display {
            font-size: 2rem;
            font-weight: bold;
            color: #dc3545;
            font-family: monospace;
        }
        .timer-warning { color: #ff6b35 !important; animation: pulse 1s infinite; }
        .timer-critical { color: #dc3545 !important; animation: pulse 0.5s infinite; }
        @@keyframes pulse {
            0%   { opacity: 1; }
            50%  { opacity: 0.5; }
            100% { opacity: 1; }
        }
        .identification-warning {
            background: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 4px;
            padding: 6px 10px;
            font-size: 0.8rem;
            color: #856404;
            margin-bottom: 8px;
        }
        .answer-option {
            border: 2px solid #dee2e6;
            border-radius: 6px;
            padding: 10px 15px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .answer-option:hover { border-color: #4BB543; background: #f4fdf6; }
        .answer-option input[type="radio"]:checked + label,
        .answer-option:has(input:checked) {
            border-color: #4BB543;
            background: #f4fdf6;
        }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    @if (isPostTest)
                    {
                        <i class="fas fa-file-signature mr-2 text-success"></i>
                        <text>Post-Test</text>
                        <small class="text-muted ml-2" style="font-size:1rem;">Attempt @attemptNumber of 3</small>
                    }
                    else
                    {
                        <i class="fas fa-file-alt mr-2 text-primary"></i>
                        <text>Pre-Test</text>
                    }
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Dashboard", "Employee")">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active">@(isPostTest ? "Post-Test" : "Pre-Test")</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @* Training Info Banner *@
        <div class="card success-gradient mb-4 shadow-sm">
            <div class="card-body py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0 font-weight-bold">@training?.TrainingTitle</h5>
                        <small class="opacity-75">
                            @(isPostTest ? "Post-Test — must meet minimum score to earn your certificate." : "Pre-Test — diagnostic only, does not affect your certificate.")
                        </small>
                    </div>
                    <div class="text-right">
                        <span class="badge badge-light" style="font-size:.9rem;">
                            @questions.Count Question@(questions.Count != 1 ? "s" : "")
                        </span>
                        <span class="badge badge-light ml-1" style="font-size:.9rem;">
                            @questions.Sum(q => q.Points) pts total
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">

            @* ── LEFT: Questions ── *@
            <div class="col-lg-8">

                @if (!questions.Any())
                {
                    <div class="card shadow-sm">
                        <div class="card-body text-center py-5">
                            <i class="fas fa-inbox fa-3x mb-3" style="color:#c8e6c9; opacity:.6;"></i>
                            <h5 class="text-muted">No questions found for this training.</h5>
                            <a href="@Url.Action("Dashboard", "Employee")" class="btn btn-secondary mt-2">
                                <i class="fas fa-arrow-left mr-1"></i> Back to Dashboard
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <form id="testForm" asp-action="SubmitTest" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="trainingId"    value="@training?.TrainingId" />
                        <input type="hidden" name="testType"      value="@testType" />
                        <input type="hidden" name="attemptNumber" value="@attemptNumber" />

                        @{ int qNum = 1; }
                        @foreach (var q in questions)
                        {
                            <div class="card question-card shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-start mb-3">
                                        <span class="question-number">@qNum</span>
                                        <div class="flex-grow-1">
                                            <p class="mb-1 font-weight-bold">@q.QuestionText</p>
                                            <small class="text-muted">@q.Points pt@(q.Points != 1 ? "s" : "")</small>
                                        </div>
                                    </div>

                                    @* True / False *@
                                    @if (q.QuestionType == "true_false")
                                    {
                                        <div class="answer-option">
                                            <input class="mr-2" type="radio"
                                                   name="answer_@q.Id"
                                                   id="q@(q.Id)_true"
                                                   value="True" required />
                                            <label for="q@(q.Id)_true" class="mb-0" style="cursor:pointer;">
                                                <i class="fas fa-check-circle text-success mr-1"></i> True
                                            </label>
                                        </div>
                                        <div class="answer-option">
                                            <input class="mr-2" type="radio"
                                                   name="answer_@q.Id"
                                                   id="q@(q.Id)_false"
                                                   value="False" />
                                            <label for="q@(q.Id)_false" class="mb-0" style="cursor:pointer;">
                                                <i class="fas fa-times-circle text-danger mr-1"></i> False
                                            </label>
                                        </div>
                                    }

                                    @* Multiple Choice *@
                                    else if (q.QuestionType == "multiple_choice")
                                    {
                                        @foreach (var choice in new[]
                                        {
                                            new { Letter = "A", Text = q.ChoiceA },
                                            new { Letter = "B", Text = q.ChoiceB },
                                            new { Letter = "C", Text = q.ChoiceC },
                                            new { Letter = "D", Text = q.ChoiceD }
                                        })
                                        {
                                            if (!string.IsNullOrEmpty(choice.Text))
                                            {
                                                <div class="answer-option">
                                                    <input class="mr-2" type="radio"
                                                           name="answer_@q.Id"
                                                           id="q@(q.Id)_@choice.Letter"
                                                           value="@choice.Letter" />
                                                    <label for="q@(q.Id)_@choice.Letter" class="mb-0" style="cursor:pointer;">
                                                        <strong>@choice.Letter.</strong> @choice.Text
                                                    </label>
                                                </div>
                                            }
                                        }
                                    }

                                    @* Identification *@
                                    else if (q.QuestionType == "identification")
                                    {
                                        <div class="identification-warning">
                                            <i class="fas fa-exclamation-triangle mr-1"></i>
                                            Answer must match exactly (case-insensitive). Be precise.
                                        </div>
                                        <input type="text"
                                               class="form-control"
                                               name="answer_@q.Id"
                                               placeholder="Type your answer here..."
                                               autocomplete="off" />
                                    }
                                </div>
                            </div>
                            qNum++;
                        }

                        @* Submit Button *@
                        <div class="card shadow-sm mb-4">
                            <div class="card-body d-flex align-items-center justify-content-between">
                                <div>
                                    <strong>Ready to submit?</strong>
                                    <p class="mb-0 text-muted small">
                                        Make sure you have answered all questions before submitting.
                                        @if (!isPostTest)
                                        {
                                            <text>This pre-test can only be taken once.</text>
                                        }
                                        else
                                        {
                                            <text>You have @(3 - attemptNumber + 1) attempt@(3 - attemptNumber + 1 != 1 ? "s" : "") remaining after this.</text>
                                        }
                                    </p>
                                </div>
                                <button type="button" class="btn btn-success btn-lg ml-3"
                                        onclick="confirmSubmit()">
                                    <i class="fas fa-paper-plane mr-2"></i> Submit @(isPostTest ? "Post-Test" : "Pre-Test")
                                </button>
                            </div>
                        </div>

                    </form>
                }
            </div>

            @* ── RIGHT: Sidebar Info ── *@
            <div class="col-lg-4">

                @* Timer (post-test only) *@
                @if (isPostTest && timerMinutes > 0)
                {
                    <div class="timer-box mb-4">
                        <div class="text-muted small mb-1">
                            <i class="fas fa-clock mr-1"></i> Time Remaining
                        </div>
                        <div class="timer-display" id="timerDisplay">
                            @($"{timerMinutes:00}:00")
                        </div>
                        <small class="text-muted">Test will auto-submit when time runs out.</small>
                    </div>
                }

                @* Test Info *@
                <div class="card shadow-sm mb-3">
                    <div class="card-header success-gradient">
                        <strong><i class="fas fa-info-circle mr-2"></i>Test Information</strong>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted">Type</td>
                                <td><strong>@(isPostTest ? "Post-Test" : "Pre-Test")</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Questions</td>
                                <td><strong>@questions.Count</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Total Points</td>
                                <td><strong>@questions.Sum(q => q.Points) pts</strong></td>
                            </tr>
                            @if (isPostTest)
                            {
                                <tr>
                                    <td class="text-muted">Min to Pass</td>
                                    <td><strong>@training?.MinimumScore pts</strong></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Attempt</td>
                                    <td><strong>@attemptNumber of 3</strong></td>
                                </tr>
                                @if (timerMinutes > 0)
                                {
                                    <tr>
                                        <td class="text-muted">Time Limit</td>
                                        <td><strong>@timerMinutes min</strong></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="text-muted">Timer</td>
                                    <td><strong class="text-success">None</strong></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Attempts</td>
                                    <td><strong>1 (one-time only)</strong></td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                @* Progress tracker *@
                <div class="card shadow-sm mb-3">
                    <div class="card-header success-gradient">
                        <strong><i class="fas fa-tasks mr-2"></i>Your Progress</strong>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted">Answered</small>
                            <small><span id="answeredCount">0</span> / @questions.Count</small>
                        </div>
                        <div class="progress" style="height:10px;">
                            <div id="answerProgress"
                                 class="progress-bar bg-success"
                                 role="progressbar" style="width:0%"></div>
                        </div>
                        <small class="text-muted d-block mt-2">
                            <i class="fas fa-info-circle mr-1"></i>
                            Answer all questions before submitting.
                        </small>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
<script src="~/plugins/sweetalert2/sweetalert2.all.min.js"></script>
<script>
$(function () {

    // ── Answer progress tracker ──
    function updateProgress() {
        var radioNames = [];
        $('input[type="radio"]').each(function () {
            var n = $(this).attr('name');
            if (radioNames.indexOf(n) === -1) radioNames.push(n);
        });
        var radioAnswered = radioNames.filter(function(n) {
            return $('input[name="' + n + '"]:checked').length > 0;
        }).length;

        var textAnswered = $('input[type="text"][name^="answer_"]').filter(function() {
            return $(this).val().trim() !== '';
        }).length;

        var answered = radioAnswered + textAnswered;
        var total    = @questions.Count;
        var pct      = total === 0 ? 0 : Math.round((answered / total) * 100);

        $('#answeredCount').text(answered);
        $('#answerProgress').css('width', pct + '%');
    }

    $(document).on('change', 'input[type="radio"]', updateProgress);
    $(document).on('input',  'input[type="text"]',  updateProgress);
    updateProgress();

    // ── Submit confirmation ──
    window.confirmSubmit = function () {
        var total    = @questions.Count;
        var answered = parseInt($('#answeredCount').text());

        if (answered < total) {
            Swal.fire({
                icon: 'warning',
                title: 'Unanswered Questions',
                text: 'You have ' + (total - answered) + ' unanswered question(s). Submit anyway?',
                showCancelButton: true,
                confirmButtonColor: '#4BB543',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, submit anyway',
                cancelButtonText: 'Go back'
            }).then(function(result) {
                if (result.isConfirmed) $('#testForm').submit();
            });
        } else {
            Swal.fire({
                icon: 'question',
                title: 'Submit Test?',
                text: 'You answered all @questions.Count questions. Ready to submit?',
                showCancelButton: true,
                confirmButtonColor: '#4BB543',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, submit!',
                cancelButtonText: 'Review answers'
            }).then(function(result) {
                if (result.isConfirmed) $('#testForm').submit();
            });
        }
    };

    // ── Post-test timer ──
    var isPostTest   = '@testType' === 'PostTest';
    var timerMinutes = @(timerMinutes);

    if (isPostTest && timerMinutes > 0) {
        var remaining = timerMinutes * 60;

        function updateTimer() {
            var mins    = Math.floor(remaining / 60);
            var secs    = remaining % 60;
            var display = String(mins).padStart(2,'0') + ':' + String(secs).padStart(2,'0');
            $('#timerDisplay').text(display);

            if (remaining <= 60) {
                $('#timerDisplay').removeClass('timer-warning').addClass('timer-critical');
            } else if (remaining <= 300) {
                $('#timerDisplay').addClass('timer-warning');
            }

            if (remaining <= 0) {
                clearInterval(countdown);
                Swal.fire({
                    icon: 'warning',
                    title: 'Time is up!',
                    text: 'Your answers are being submitted automatically.',
                    showConfirmButton: false,
                    timer: 2000
                }).then(function() {
                    $('#testForm').submit();
                });
                return;
            }
            remaining--;
        }

        updateTimer();
        var countdown = setInterval(updateTimer, 1000);

        window.onbeforeunload = function() {
            return 'Your test is still in progress. Are you sure you want to leave?';
        };

        $('#testForm').on('submit', function() {
            window.onbeforeunload = null;
        });
    }

});
</script>
}