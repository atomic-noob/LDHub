@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Evaluation Management";

    var trainings        = ViewBag.Trainings as List<LDHub.Models.Training> ?? new();
    var selectedTraining = ViewBag.SelectedTraining as LDHub.Models.Training;
    var questions        = ViewBag.Questions as List<LDHub.Models.EvaluationQuestion>;
    int? trainingId       = ViewBag.TrainingId;
}

@section Styles {
    <style>
        body { background: #f4fdf6; }
        .content-wrapper { background: linear-gradient(180deg,#fff 0%,#f4fff7 100%); }

        .training-card-item {
            border-radius: 12px; border: 2px solid #dee2e6; background: white;
            padding: 16px 18px; margin-bottom: 15px; cursor: pointer;
            transition: all .25s; text-decoration: none; display: block; color: inherit;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
        }
        .training-card-item:hover {
            border-color: #4BB543; box-shadow: 0 6px 20px rgba(75,181,67,.2);
            transform: translateY(-2px); color: inherit; text-decoration: none;
        }
        .filter-btn {
            border-radius: 20px; padding: 5px 16px; font-size: .83rem;
            margin-right: 6px; margin-bottom: 8px; border: 2px solid transparent;
            transition: all .2s; cursor: pointer; background: transparent;
        }
        .filter-btn-all      { border-color: #6c757d; color: #6c757d; }
        .filter-btn-all.active      { background: #6c757d !important; color: white !important; }
        .filter-btn-ongoing   { border-color: #4BB543; color: #4BB543; }
        .filter-btn-ongoing.active  { background: #4BB543 !important; color: white !important; }
        .filter-btn-upcoming  { border-color: #0984e3; color: #0984e3; }
        .filter-btn-upcoming.active { background: #0984e3 !important; color: white !important; }
        .filter-btn-ended     { border-color: #adb5bd; color: #adb5bd; }
        .filter-btn-ended.active    { background: #adb5bd !important; color: white !important; }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">Evaluation Management</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item active">Evaluation</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        @{
            var nowEV = DateTime.Now;
            var ongoingCountEV  = trainings.Count(t => t.StartDate.HasValue && t.EndDate.HasValue && nowEV >= t.StartDate && nowEV <= t.EndDate);
            var upcomingCountEV = trainings.Count(t => t.StartDate.HasValue && nowEV < t.StartDate);
            var endedCountEV    = trainings.Count(t => t.EndDate.HasValue && nowEV > t.EndDate);
        }

        @if (trainingId == null)
        {
            <div class="card card-outline card-success mb-3">
                <div class="card-header"><h3 class="card-title">Select Training</h3></div>
                <div class="card-body">

                    <div class="row mb-3 align-items-center">
                        <div class="col-md-5">
                            <div class="input-group">
                                <input type="text" id="trainingSearch" class="form-control" placeholder="Search training..." />
                                <div class="input-group-append">
                                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <button class="filter-btn filter-btn-all active" data-filter="all">
                                All <span class="badge badge-secondary ml-1">@trainings.Count</span>
                            </button>
                            <button class="filter-btn filter-btn-ongoing" data-filter="Ongoing">
                                Ongoing <span class="badge badge-success ml-1">@ongoingCountEV</span>
                            </button>
                            <button class="filter-btn filter-btn-upcoming" data-filter="Scheduled">
                                Scheduled <span class="badge badge-info ml-1">@upcomingCountEV</span>
                            </button>
                            <button class="filter-btn filter-btn-ended" data-filter="Ended">
                                Ended <span class="badge badge-secondary ml-1">@endedCountEV</span>
                            </button>
                        </div>
                    </div>

                    @if (!trainings.Any())
                    {
                        <p class="text-muted text-center py-3">No trainings available.</p>
                    }
                    else
                    {
                        <div class="row" id="trainingCardsEV">
                            @foreach (var t in trainings)
                            {
                                var tStatus  = "Scheduled";
                                var badgeCss = "badge-info";
                                if (t.StartDate.HasValue && t.EndDate.HasValue)
                                {
                                    if (nowEV >= t.StartDate && nowEV <= t.EndDate)
                                    { tStatus = "Ongoing"; badgeCss = "badge-success"; }
                                    else if (nowEV > t.EndDate)
                                    { tStatus = "Ended"; badgeCss = "badge-secondary"; }
                                }

                                <div class="col-md-6 col-lg-4 training-card-col"
                                     data-status="@tStatus" data-title="@t.TrainingTitle.ToLower()">
                                    <a asp-controller="Evaluation" asp-action="Index"
                                       asp-route-trainingId="@t.TrainingId"
                                       class="training-card-item">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="font-weight-bold mb-0" style="font-size:.95rem;">@t.TrainingTitle</h6>
                                            <span class="badge @badgeCss ml-2">@tStatus</span>
                                        </div>
                                        <small class="text-muted d-block">
                                            @(t.StartDate?.ToString("MMM dd") ?? "TBD") – @(t.EndDate?.ToString("MMM dd, yyyy") ?? "TBD")
                                        </small>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (selectedTraining != null)
        {
            <div class="mb-3">
                <a asp-controller="Evaluation" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Change Training
                </a>
            </div>

            <div class="card shadow-sm mb-4">
               <div class="card-header">
    <h3 class="card-title">
        Evaluation Questions — <strong>@selectedTraining.TrainingTitle</strong>
    </h3>
    <div class="card-tools">
        <a asp-controller="Evaluation" asp-action="Results"
           asp-route-trainingId="@trainingId"
           class="btn btn-sm btn-info mr-1">
            <i class="fas fa-chart-bar mr-1"></i> View Results
        </a>
        <button class="btn btn-sm btn-success" data-toggle="modal" data-target="#addQModal">
            <i class="fas fa-plus mr-1"></i> Add Question
        </button>
    </div>
</div>
                <div class="card-body">
                    @if (questions == null || !questions.Any())
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x mb-2 d-block" style="opacity:.3"></i>
                            <p>No evaluation questions yet.</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-bordered table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th>#</th><th>Type</th><th>Question</th><th>Required</th><th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int i = 1; }
                                @foreach (var q in questions)
                                {
                                    var typeBadge = q.QuestionType switch
                                    {
                                        "rating"          => "badge-warning",
                                        "multiple_choice" => "badge-info",
                                        _                 => "badge-secondary"
                                    };
                                    var typeLabel = q.QuestionType switch
                                    {
                                        "rating"          => "Rating (1–5)",
                                        "multiple_choice" => "Multiple Choice",
                                        _                 => "Open Text"
                                    };
                                    <tr>
                                        <td>@i</td>
                                        <td><span class="badge @typeBadge">@typeLabel</span></td>
                                        <td>@q.QuestionText</td>
                                        <td>@(q.IsRequired ? "Yes" : "No")</td>
                                        <td>
                                            <button class="btn btn-sm btn-info edit-q-btn"
                                                    data-id="@q.Id" data-type="@q.QuestionType"
                                                    data-text="@q.QuestionText"
                                                    data-ca="@q.ChoiceA" data-cb="@q.ChoiceB"
                                                    data-cc="@q.ChoiceC" data-cd="@q.ChoiceD"
                                                    data-required="@q.IsRequired.ToString().ToLower()"
                                                    data-toggle="modal" data-target="#editQModal">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form asp-action="DeleteQuestion" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="questionId" value="@q.Id" />
                                                <input type="hidden" name="trainingId" value="@trainingId" />
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Delete this question?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            @* ── Add Question Modal ── *@
            <div class="modal fade" id="addQModal" tabindex="-1" data-backdrop="static">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Add Evaluation Question</h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <form asp-action="SaveQuestion" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="trainingId" value="@trainingId" />
                            <input type="hidden" name="questionId" value="0" />
                            <div class="modal-body">
                                <div class="form-group">
                                    <label>Question Type</label>
                                    <select class="form-control" name="questionType" id="add_ev_type" required>
                                        <option value="rating">Rating (1–5)</option>
                                        <option value="multiple_choice">Multiple Choice</option>
                                        <option value="text">Open Text</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Question Text</label>
                                    <textarea class="form-control" name="questionText" rows="2" required></textarea>
                                </div>
                                <div id="add_ev_mc" style="display:none;">
                                    <input type="text" class="form-control mb-2" name="choiceA" placeholder="Choice A" />
                                    <input type="text" class="form-control mb-2" name="choiceB" placeholder="Choice B" />
                                    <input type="text" class="form-control mb-2" name="choiceC" placeholder="Choice C" />
                                    <input type="text" class="form-control mb-2" name="choiceD" placeholder="Choice D" />
                                </div>
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" name="isRequired" value="true" checked />
                                    <label class="form-check-label">Required</label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-success">Save Question</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @* ── Edit Question Modal ── *@
            <div class="modal fade" id="editQModal" tabindex="-1" data-backdrop="static">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Edit Evaluation Question</h5>
                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                        </div>
                        <form asp-action="SaveQuestion" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="trainingId" value="@trainingId" />
                            <input type="hidden" name="questionId" id="edit_ev_id" />
                            <div class="modal-body">
                                <div class="form-group">
                                    <label>Question Type</label>
                                    <select class="form-control" name="questionType" id="edit_ev_type" required>
                                        <option value="rating">Rating (1–5)</option>
                                        <option value="multiple_choice">Multiple Choice</option>
                                        <option value="text">Open Text</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Question Text</label>
                                    <textarea class="form-control" name="questionText" id="edit_ev_text" rows="2" required></textarea>
                                </div>
                                <div id="edit_ev_mc" style="display:none;">
                                    <input type="text" class="form-control mb-2" name="choiceA" id="edit_ev_ca" placeholder="Choice A" />
                                    <input type="text" class="form-control mb-2" name="choiceB" id="edit_ev_cb" placeholder="Choice B" />
                                    <input type="text" class="form-control mb-2" name="choiceC" id="edit_ev_cc" placeholder="Choice C" />
                                    <input type="text" class="form-control mb-2" name="choiceD" id="edit_ev_cd" placeholder="Choice D" />
                                </div>
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" name="isRequired" id="edit_ev_required" value="true" />
                                    <label class="form-check-label">Required</label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Update Question</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
<script>
$(function () {
    $('.filter-btn').on('click', function () {
        $('.filter-btn').removeClass('active');
        $(this).addClass('active');
        var filter = $(this).data('filter');
        $('.training-card-col').each(function () {
            $(this).toggle(filter === 'all' || $(this).data('status') === filter);
        });
    });

    $('#trainingSearch').on('keyup', function () {
        var val = $(this).val().toLowerCase();
        $('.training-card-col').each(function () {
            $(this).toggle($(this).data('title').indexOf(val) > -1);
        });
    });

    $('#add_ev_type').on('change', function () {
        $('#add_ev_mc').toggle($(this).val() === 'multiple_choice');
    });

    $('.edit-q-btn').on('click', function () {
        $('#edit_ev_id').val($(this).data('id'));
        $('#edit_ev_type').val($(this).data('type'));
        $('#edit_ev_text').val($(this).data('text'));
        $('#edit_ev_ca').val($(this).data('ca'));
        $('#edit_ev_cb').val($(this).data('cb'));
        $('#edit_ev_cc').val($(this).data('cc'));
        $('#edit_ev_cd').val($(this).data('cd'));
        $('#edit_ev_required').prop('checked', $(this).data('required') === true || $(this).data('required') === 'true');
        $('#edit_ev_mc').toggle($(this).data('type') === 'multiple_choice');
    });
});
</script>
}