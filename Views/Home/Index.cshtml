@{
    Layout = null;
    ViewData["Title"] = "Welcome";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DENR L&D Hub</title>
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/plugins/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
</head>

<body>

    @* Public Navbar *@
    @await Html.PartialAsync("_NavbarPublic")

    @* Hero Section *@
    <div class="container mt-5 text-center">

        <img src="~/dist/img/denrlogo.jpg" alt="DENR Logo" class="img-circle mb-3"
             style="width:100px;height:100px;object-fit:cover;" />

        <h1 class="mt-3">DENR Learning & Development Hub</h1>
        <p class="text-muted mt-2">
            A centralized platform for managing trainings, modules, and
            employee development programs of the Department of Environment
            and Natural Resources.
        </p>

        <a href="/Home/Login" class="btn btn-success btn-lg mt-3">
            <i class="fas fa-sign-in-alt mr-2"></i> Login to your account
        </a>

    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>

</html>