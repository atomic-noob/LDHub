    <script>
       
        // Navbar background on scroll
        window.addEventListener('scroll', function () {
            var navbar = document.getElementById('mainNavbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) target.scrollIntoView({ behavior: 'smooth' });
            });
        });
       
// ── FAQ accordion ──────────────────────────────────────────────────────────
function toggleFaq(btn, bodyId) {
    const body    = document.getElementById(bodyId);
    if (!body) return;
    const chevron = btn.querySelector('.faq-chevron');
    const isOpen  = body.style.display === 'block';

    // Close all
    document.querySelectorAll('[id^="faqBody"]').forEach(function(el) {
        el.style.display = 'none';
    });
    document.querySelectorAll('.faq-chevron').forEach(function(el) {
        el.style.transform = 'rotate(0deg)';
    });

    // Open clicked one if it was closed
    if (!isOpen) {
        body.style.display = 'block';
        if (chevron) chevron.style.transform = 'rotate(180deg)';
    }
}

// ── FAQ search filter ──────────────────────────────────────────────────────
function filterFaqs(query) {
    const q     = query.toLowerCase().trim();
    const items = document.querySelectorAll('.faq-item');
    let   shown = 0;

    items.forEach(function(item) {
        const question = item.getAttribute('data-question') || '';
        const answer   = item.getAttribute('data-answer')   || '';
        const matches  = !q || question.includes(q) || answer.includes(q);
        item.style.display = matches ? '' : 'none';
        if (matches) shown++;
    });

    const noResults = document.getElementById('faqNoResults');
    if (noResults) noResults.style.display = shown === 0 ? 'block' : 'none';
}

// ── Inquiry form submit (AJAX) ─────────────────────────────────────────────
document.getElementById('inquiryForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();

    const btn = document.getElementById('inqSubmitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Sending...';

    const token = document.querySelector('#inquiryForm input[name="__RequestVerificationToken"]')?.value;

    const formData = new FormData(this);

    try {
        const res  = await fetch('/Faq/SubmitInquiry', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        });
        const data = await res.json();

        if (data.success) {
            document.getElementById('inquiryForm').style.display = 'none';
            document.getElementById('inqSuccessMsg').textContent = data.message;
            document.getElementById('inqSuccess').style.display = 'block';
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit Inquiry';
            alert(data.message || 'Something went wrong. Please try again.');
        }
    } catch {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i>Submit Inquiry';
        alert('Could not connect. Please try again.');
    }
});

// ── Cookie consent ─────────────────────────────────────────────────────────
function showCookieDetails() {
    $('#cookieDetailsModal').modal('show');
}

function acceptCookies(type) {
    // Store consent in localStorage
    localStorage.setItem('cookieConsent', type);
    localStorage.setItem('cookieConsentDate', new Date().toISOString());

    // Hide banner
    document.getElementById('cookieBanner').style.display = 'none';

    // If analytics accepted, you can initialize your analytics here
    if (type === 'all') {
        console.log('Analytics cookies accepted.');
        // e.g. initGoogleAnalytics();
    }
}

function initCookieBanner() {
    const consent = localStorage.getItem('cookieConsent');
    if (!consent) {
        // Show banner after a short delay so it doesn't flash immediately
        setTimeout(function() {
            document.getElementById('cookieBanner').style.display = 'block';
        }, 1200);
    }
}

// Run on page load
document.addEventListener('DOMContentLoaded', initCookieBanner);
</script>

  
