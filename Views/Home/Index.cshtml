@{
    var faqs = ViewBag.Faqs as List<LDHub.Models.Faq> ?? new List<LDHub.Models.Faq>();
}

@* ── FAQ SECTION ── *@
<section id="faq" style="padding: 80px 20px; background: #f8fdf9;">
    <div class="container">

        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-subtitle">Can't find what you're looking for? Send us an inquiry below.</p>

        @* ── Search bar ── *@
        <div class="row justify-content-center mb-4">
            <div class="col-md-6">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-white border-right-0">
                            <i class="fas fa-search text-success"></i>
                        </span>
                    </div>
                    <input type="text" id="faqSearch" class="form-control border-left-0"
                           placeholder="Search FAQs..."
                           oninput="filterFaqs(this.value)" />
                </div>
            </div>
        </div>

        @* ── FAQ Accordion ── *@
        <div class="row justify-content-center">
            <div class="col-lg-9">

                @if (!faqs.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-question-circle fa-3x mb-3 d-block" style="color:#c8e6c9;"></i>
                        <p>No FAQs available yet. Check back soon!</p>
                    </div>
                }
                else
                {
                    <div id="faqAccordion">
                        @{ int faqIdx = 0; }
                        @foreach (var faq in faqs)
                        {
                            <div class="faq-item" data-question="@faq.Question.ToLower()" data-answer="@faq.Answer.ToLower()">
                                <div class="card mb-2"
                                     style="border-radius:10px; border:1px solid #e8f5e9; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.05);">

                                    @* Question header *@
                                    <div class="card-header p-0" style="background:white; border:none;">
                                        <button type="button" 
                                                class="btn btn-link w-100 text-left d-flex justify-content-between align-items-center faq-toggle"
                                                style="padding:18px 20px; color:#117554; font-weight:600; font-size:.95rem; text-decoration:none;"
                                                onclick="toggleFaq(this, 'faqBody@(faqIdx)')">
                                            <span>
                                                <i class="fas fa-question-circle mr-2" style="color:#4BB543;"></i>
                                                @faq.Question
                                            </span>
                                            <i class="fas fa-chevron-down faq-chevron" style="transition:transform .3s; flex-shrink:0; margin-left:10px;"></i>
                                        </button>
                                    </div>

                                    @* Answer body *@
                                    <div id="faqBody@(faqIdx)" style="display:none;">
                                        <div class="card-body" style="padding:0 20px 20px 20px; border-top:1px solid #e8f5e9;">
                                            <p style="color:#495057; line-height:1.8; margin-top:14px; margin-bottom:0; white-space:pre-line;">
                                                @faq.Answer
                                            </p>
                                            @if (!string.IsNullOrEmpty(faq.ImagePath))
                                            {
                                                <div class="mt-3 text-center">
                                                    <img src="@faq.ImagePath" alt="FAQ Image"
                                                         style="max-width:100%; max-height:320px; border-radius:8px; border:1px solid #dee2e6;" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            faqIdx++;
                        }
                    </div>

                    @* No results message *@
                    <div id="faqNoResults" style="display:none;" class="text-center py-4 text-muted">
                        <i class="fas fa-search fa-2x mb-2 d-block"></i>
                        No FAQs matched your search.
                    </div>
                }
            </div>
        </div>

        @* ── Inquiry Form ── *@
        <div class="row justify-content-center mt-5">
            <div class="col-lg-7">
                <div class="card"
                     style="border-radius:16px; border:none; box-shadow:0 6px 25px rgba(17,117,84,.12); overflow:hidden;">

                    <div class="card-header text-white text-center py-4"
                         style="background:linear-gradient(135deg,#117554,#4BB543); border:none;">
                        <h4 class="mb-1 font-weight-bold">
                            <i class="fas fa-paper-plane mr-2"></i>Still have questions?
                        </h4>
                        <p class="mb-0" style="opacity:.9; font-size:.9rem;">
                            Send us your inquiry and we'll get back to you.
                        </p>
                    </div>

                    <div class="card-body p-4">
                        <form id="inquiryForm">
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <label for="inqName">Your Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="inqName"
                                       name="Name" placeholder="Juan dela Cruz" required />
                            </div>

                            <div class="form-group">
                                <label for="inqEmail">Email Address <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="inqEmail"
                                       name="Email" placeholder="juan@denr.gov.ph" required />
                            </div>

                            <div class="form-group">
                                <label for="inqMessage">Message <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="inqMessage" name="Message"
                                          rows="4"
                                          placeholder="Type your question or concern here..."
                                          required></textarea>
                            </div>

                            <button type="submit" class="btn btn-success btn-block"
                                    id="inqSubmitBtn"
                                    style="border-radius:25px; padding:12px; font-weight:700;">
                                <i class="fas fa-paper-plane mr-2"></i>Submit Inquiry
                            </button>
                        </form>

                        @* Success message (hidden by default) *@
                        <div id="inqSuccess" style="display:none;"
                             class="alert alert-success mt-3 text-center">
                            <i class="fas fa-check-circle fa-2x mb-2 d-block"></i>
                            <strong>Inquiry submitted!</strong><br />
                            <span id="inqSuccessMsg">We'll get back to you as soon as possible.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
