@model LDHub.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DENR L&D Hub — Login</title>
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/plugins/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css" />
</head>
<body class="hold-transition login-page">

<div class="login-box">

    <div class="login-logo">
        <img src="~/dist/img/denrlogo.jpg" alt="DENR Logo"
             class="img-circle mb-2"
             style="width:80px;height:80px;object-fit:cover;" />
        <br />
        <b>DENR L&amp;D Hub Employee Login</b>
    </div>

    <div class="card">
        <div class="card-body login-card-body">

            <p class="login-box-msg">Sign in to your DENR account</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    <i class="icon fas fa-ban"></i> @ViewBag.Error
                </div>
            }

            <form asp-controller="Home" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div class="input-group mb-3">
                    <input asp-for="Email" type="email"
                           class="form-control"
                           placeholder="Email" required />
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-envelope"></span>
                        </div>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <input asp-for="Password" type="password"
                           class="form-control"
                           placeholder="Password" required />
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <button type="submit" class="btn btn-success btn-block">
                            <i class="fas fa-sign-in-alt mr-2"></i> Sign In
                        </button>
                    </div>
                </div>

            </form>

            <div class="mt-3 text-center">
                <a href="/" class="text-muted">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Home
                </a>
            </div>

        </div>
    </div>

</div>

<script src="~/plugins/jquery/jquery.min.js"></script>
<script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/dist/js/adminlte.min.js"></script>

</body>
</html>