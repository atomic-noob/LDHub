@model List<LDHub.Models.User>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Employees";
}

@section Styles {
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" />
    <style>
        body { background: #f4fdf6; }
        .content-wrapper { background: linear-gradient(180deg, #ffffff 0%, #f4fff7 100%); }
        .success-gradient { background: linear-gradient(225deg, #9BEC00, #4BB543, #117554); color: white; }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">Employees</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a asp-controller="Raam" asp-action="Dashboard">
                            <i class="fas fa-home"></i> Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active">Employees</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

    

        <div class="card shadow-sm">
            <div class="card-header success-gradient d-flex align-items-center justify-content-between flex-wrap" style="gap:10px;">
                <h3 class="card-title mb-0">
                    <i class="fas fa-users mr-2"></i>Employees in Your Region
                </h3>
                <div class="d-flex align-items-center" style="gap:8px;">
                    <label class="mb-0 font-weight-bold text-white text-nowrap">Filter by Role:</label>
                    <select id="roleFilter" class="form-control form-control-sm" style="min-width:180px;">
                        <option value="">All Roles</option>
                        <option value="Employee">Employee</option>
                        <option value="ResourcePerson">Resource Person</option>
                    </select>
                </div>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-inbox fa-3x mb-3" style="opacity:.3;"></i>
                        <h5>No employees found in your region.</h5>
                    </div>
                }
                else
                {
                    <table id="employeesTable" class="table table-bordered table-striped table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Position</th>
                                <th>Office</th>
                                <th>Division</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th>In Training</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int i = 1; }
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>
                                        <strong>@u.FirstName @u.LastName</strong>
                                        @if (!string.IsNullOrEmpty(u.MiddleName))
                                        {
                                            <small class="text-muted d-block">@u.MiddleName</small>
                                        }
                                    </td>
                                    <td>@u.Email</td>
                                    <td>@(u.Position ?? "—")</td>
                                    <td>@(u.Office?.OfficeName ?? "—")</td>
                                    <td>@(u.Division?.DivisionName ?? "—")</td>
                                    <td>
                                        @foreach (var role in u.UserRoles)
                                        {
                                            <span class="badge badge-success">@role.Role</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(u.Status == "Active" ? "badge-success" : "badge-secondary")">
                                            @u.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (u.InTraining)
                                        {
                                            <span class="badge badge-warning">In Training</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-secondary btn-sm dropdown-toggle"
                                                    data-toggle="dropdown">
                                                <i class="fas fa-cog"></i>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-right">
                                                <a class="dropdown-item view-btn" href="#"
                                                   data-toggle="modal" data-target="#detailsModal"
                                                   data-name="@u.FirstName @u.LastName"
                                                   data-email="@u.Email"
                                                   data-position="@u.Position"
                                                   data-designation="@u.Designation"
                                                   data-salary="@u.SalaryGrade"
                                                   data-gender="@u.Gender"
                                                   data-age="@u.Age"
                                                   data-contact="@u.ContactNumber"
                                                   data-office="@(u.Office?.OfficeName ?? "—")"
                                                   data-division="@(u.Division?.DivisionName ?? "—")"
                                                   data-region="@(u.Region?.RegionName ?? "—")"
                                                   data-status="@u.Status"
                                                   data-registered="@u.CreatedAt.ToString("MMM dd, yyyy")">
                                                    <i class="fas fa-eye mr-2"></i> View
                                                </a>
                                                <a class="dropdown-item edit-btn" href="#"
                                                   data-toggle="modal" data-target="#editModal"
                                                   data-id="@u.UserId"
                                                   data-firstname="@u.FirstName"
                                                   data-middlename="@u.MiddleName"
                                                   data-lastname="@u.LastName"
                                                   data-contact="@u.ContactNumber"
                                                   data-position="@u.Position"
                                                   data-designation="@u.Designation"
                                                   data-salarygrade="@u.SalaryGrade">
                                                    <i class="fas fa-edit mr-2"></i> Edit
                                                </a>
                                                <a class="dropdown-item assign-role-btn" href="#"
                                                   data-toggle="modal" data-target="#roleModal"
                                                   data-id="@u.UserId"
                                                   data-name="@u.FirstName @u.LastName"
                                                   data-roles="@string.Join(",", u.UserRoles.Select(r => r.Role))">
                                                    <i class="fas fa-user-tag mr-2"></i> Manage Roles
                                                </a>
                                                <div class="dropdown-divider"></div>
                                                <form asp-controller="Raam" asp-action="ToggleParticipantStatus"
                                                      method="post" style="display:inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@u.UserId" />
                                                    <button type="submit"
                                                            class="dropdown-item @(u.Status == "Active" ? "text-danger" : "text-success")"
                                                            onclick="return confirm('@(u.Status == "Active" ? "Deactivate" : "Activate") @u.FirstName @u.LastName?')">
                                                        <i class="fas @(u.Status == "Active" ? "fa-ban" : "fa-check") mr-2"></i>
                                                        @(u.Status == "Active" ? "Deactivate" : "Activate")
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</section>

@* Details Modal *@
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header success-gradient">
                <h5 class="modal-title">
                    <i class="fas fa-user mr-2"></i>Employee Details
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-sm table-borderless">
                            <tr><td class="text-muted">Full Name</td><td id="d_name" class="font-weight-bold"></td></tr>
                            <tr><td class="text-muted">Email</td><td id="d_email"></td></tr>
                            <tr><td class="text-muted">Gender</td><td id="d_gender"></td></tr>
                            <tr><td class="text-muted">Age</td><td id="d_age"></td></tr>
                            <tr><td class="text-muted">Contact</td><td id="d_contact"></td></tr>
                            <tr><td class="text-muted">Status</td><td id="d_status"></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-sm table-borderless">
                            <tr><td class="text-muted">Position</td><td id="d_position"></td></tr>
                            <tr><td class="text-muted">Designation</td><td id="d_designation"></td></tr>
                            <tr><td class="text-muted">Salary Grade</td><td id="d_salary"></td></tr>
                            <tr><td class="text-muted">Office</td><td id="d_office"></td></tr>
                            <tr><td class="text-muted">Division</td><td id="d_division"></td></tr>
                            <tr><td class="text-muted">Region</td><td id="d_region"></td></tr>
                            <tr><td class="text-muted">Registered</td><td id="d_registered"></td></tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@* Edit Modal *@
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#ffffff,#f0fff4); border-bottom:2px solid #e8f5e9;">
                <h5 class="modal-title" style="color:#1b3a2d;"><i class="fas fa-edit mr-2 text-success"></i>Edit Employee</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <form asp-controller="Raam" asp-action="EmployeeEdit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="UserId" id="editUserId" />
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label>First Name</label>
                            <input type="text" name="FirstName" id="editFirstName" class="form-control" required />
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Middle Name</label>
                            <input type="text" name="MiddleName" id="editMiddleName" class="form-control" />
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Last Name</label>
                            <input type="text" name="LastName" id="editLastName" class="form-control" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Position</label>
                            <input type="text" name="Position" id="editPosition" class="form-control" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Designation</label>
                            <input type="text" name="Designation" id="editDesignation" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label>Contact Number</label>
                            <input type="text" name="ContactNumber" id="editContact" class="form-control" />
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Salary Grade</label>
                            <input type="number" name="SalaryGrade" id="editSalaryGrade" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Assign Role Modal *@
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#ffffff,#f0fff4); border-bottom:2px solid #e8f5e9;">
                <h5 class="modal-title" style="color:#1b3a2d;"><i class="fas fa-user-tag mr-2 text-success"></i>Manage Roles</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p>Managing roles for: <strong id="roleUserName"></strong></p>

                <div class="mb-3">
                    <label><strong>Current Roles:</strong></label>
                    <div id="currentRoles"></div>
                </div>

                <hr />

                <form asp-controller="Raam" asp-action="AssignRole" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" id="roleUserId" />
                    <div class="form-group">
                        <label>Assign New Role</label>
                        <select name="role" class="form-control">
                            <option value="">-- Select Role --</option>
                            <option value="Employee">Employee</option>
                            <option value="ResourcePerson">Resource Person</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success btn-block">
                        <i class="fas fa-plus mr-1"></i> Assign Role
                    </button>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@* Remove Role Form (hidden) *@
<form id="removeRoleForm" asp-controller="Raam" asp-action="RemoveRole" method="post" style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" id="removeUserId" />
    <input type="hidden" name="role" id="removeRole" />
</form>

@section Scripts {
<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
<script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
<script>
$(function () {
    $('#employeesTable').DataTable({ responsive: true, autoWidth: false, order: [[1, 'asc']] });

    // Details modal
    $('.view-btn').on('click', function () {
        $('#d_name').text($(this).data('name'));
        $('#d_email').text($(this).data('email'));
        $('#d_gender').text($(this).data('gender') || '—');
        $('#d_age').text($(this).data('age') || '—');
        $('#d_contact').text($(this).data('contact') || '—');
        $('#d_position').text($(this).data('position') || '—');
        $('#d_designation').text($(this).data('designation') || '—');
        $('#d_salary').text($(this).data('salary') || '—');
        $('#d_office').text($(this).data('office'));
        $('#d_division').text($(this).data('division'));
        $('#d_region').text($(this).data('region'));
        $('#d_status').text($(this).data('status'));
        $('#d_registered').text($(this).data('registered'));
    });

    // Edit modal
    $('.edit-btn').on('click', function () {
        $('#editUserId').val($(this).data('id'));
        $('#editFirstName').val($(this).data('firstname'));
        $('#editMiddleName').val($(this).data('middlename'));
        $('#editLastName').val($(this).data('lastname'));
        $('#editContact').val($(this).data('contact'));
        $('#editPosition').val($(this).data('position'));
        $('#editDesignation').val($(this).data('designation'));
        $('#editSalaryGrade').val($(this).data('salarygrade'));
    });

    // Role modal
    $('.assign-role-btn').on('click', function () {
        var id = $(this).data('id');
        var name = $(this).data('name');
        var roles = $(this).data('roles').split(',');

        $('#roleUserId').val(id);
        $('#roleUserName').text(name);

        var html = '';
        $.each(roles, function (i, role) {
            if (role.trim() === '') return;
            html += '<span class="badge badge-info mr-1 p-2">' + role.trim() +
                    ' <a href="#" class="text-white remove-role-btn" data-userid="' + id +
                    '" data-role="' + role.trim() + '"><i class="fas fa-times"></i></a></span>';
        });
        if (html === '') html = '<span class="text-muted">No roles assigned</span>';
        $('#currentRoles').html(html);
    });

    // Remove role
    $(document).on('click', '.remove-role-btn', function (e) {
        e.preventDefault();
        if (!confirm('Remove this role?')) return;
        $('#removeUserId').val($(this).data('userid'));
        $('#removeRole').val($(this).data('role'));
        $('#removeRoleForm').submit();
    });

    // Role filter — column 6 is Roles
    $('#roleFilter').on('change', function () {
        var role = $(this).val();
        $('#employeesTable').DataTable()
            .column(6)
            .search(role ? role : '', true, false)
            .draw();
    });
});
</script>
}