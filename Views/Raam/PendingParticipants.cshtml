@model List<LDHub.Models.PendingParticipant>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pending Participants";
}

@section Styles {
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" />
    <style>
        body { background: #f4fdf6; }
        .content-wrapper { background: linear-gradient(180deg, #ffffff 0%, #f4fff7 100%); }
        .success-gradient { background: linear-gradient(225deg, #9BEC00, #4BB543, #117554); color: white; }
    </style>
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">Pending Participants</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a asp-controller="Raam" asp-action="Dashboard">
                            <i class="fas fa-home"></i> Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active">Pending Participants</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        @* Summary *@
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="info-box">
                    <span class="info-box-icon bg-warning"><i class="fas fa-user-clock"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">Pending Approvals</span>
                        <span class="info-box-number">@Model.Count</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header success-gradient">
                <h3 class="card-title">
                    <i class="fas fa-user-clock mr-2"></i>Participants Awaiting Approval
                </h3>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-check-circle fa-3x mb-3" style="color:#4BB543; opacity:.5;"></i>
                        <h5>No pending participants!</h5>
                        <p>All registrations in your region have been processed.</p>
                    </div>
                }
                else
                {
                    <table id="pendingTable" class="table table-bordered table-striped table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Position</th>
                                <th>Office</th>
                                <th>Division</th>
                                <th>Registered</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int i = 1; }
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>
                                        <strong>@p.FirstName @p.LastName</strong>
                                        @if (!string.IsNullOrEmpty(p.MiddleName))
                                        {
                                            <small class="text-muted d-block">@p.MiddleName</small>
                                        }
                                    </td>
                                    <td>@p.Email</td>
                                    <td>@(p.Position ?? "—")</td>
                                    <td>@(p.Office?.OfficeName ?? "—")</td>
                                    <td>@(p.Division?.DivisionName ?? "—")</td>
                                    <td>
                                        <small>@p.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </td>
                                    <td>
                                        @* Approve *@
                                        <form asp-controller="Raam"
                                              asp-action="ApproveParticipant"
                                              method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="pendingId" value="@p.ParticipantId" />
                                            <button type="submit" class="btn btn-sm btn-success"
                                                    onclick="return confirm('Approve @p.FirstName @p.LastName?')">
                                                <i class="fas fa-check mr-1"></i> Approve
                                            </button>
                                        </form>

                                        @* View Details *@
                                        <button type="button"
                                                class="btn btn-sm btn-info view-btn"
                                                data-name="@p.FirstName @p.LastName"
                                                data-email="@p.Email"
                                                data-position="@p.Position"
                                                data-designation="@p.Designation"
                                                data-salary="@p.SalaryGrade"
                                                data-gender="@p.Gender"
                                                data-age="@p.Age"
                                                data-contact="@p.ContactNumber"
                                                data-office="@(p.Office?.OfficeName ?? "—")"
                                                data-division="@(p.Division?.DivisionName ?? "—")"
                                                data-region="@(p.Region?.RegionName ?? "—")"
                                                data-toggle="modal"
                                                data-target="#detailsModal">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        @* Reject *@
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                data-id="@p.ParticipantId"
                                                data-name="@p.FirstName @p.LastName"
                                                data-toggle="modal"
                                                data-target="#rejectModal">
                                            <i class="fas fa-times mr-1"></i> Reject
                                        </button>
                                    </td>
                                </tr>
                                i++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</section>

@* Details Modal *@
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header success-gradient">
                <h5 class="modal-title">
                    <i class="fas fa-user mr-2"></i>Participant Details
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-sm table-borderless">
                            <tr><td class="text-muted">Full Name</td><td id="d_name" class="font-weight-bold"></td></tr>
                            <tr><td class="text-muted">Email</td><td id="d_email"></td></tr>
                            <tr><td class="text-muted">Gender</td><td id="d_gender"></td></tr>
                            <tr><td class="text-muted">Age</td><td id="d_age"></td></tr>
                            <tr><td class="text-muted">Contact</td><td id="d_contact"></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-sm table-borderless">
                            <tr><td class="text-muted">Position</td><td id="d_position"></td></tr>
                            <tr><td class="text-muted">Designation</td><td id="d_designation"></td></tr>
                            <tr><td class="text-muted">Salary Grade</td><td id="d_salary"></td></tr>
                            <tr><td class="text-muted">Office</td><td id="d_office"></td></tr>
                            <tr><td class="text-muted">Division</td><td id="d_division"></td></tr>
                            <tr><td class="text-muted">Region</td><td id="d_region"></td></tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@* Reject Modal *@
<div class="modal fade" id="rejectModal" tabindex="-1" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-times-circle mr-2"></i>Reject Participant
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <form asp-controller="Raam" asp-action="RejectParticipant" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="pendingId" id="reject_id" />
                <div class="modal-body">
                    <p>You are about to reject <strong id="reject_name"></strong>.</p>
                    <div class="form-group">
                        <label>Reason <small class="text-muted">(optional)</small></label>
                        <textarea name="reason" class="form-control" rows="3"
                                  placeholder="Enter reason for rejection..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times mr-1"></i> Confirm Reject
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
<script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
<script>
$(function () {
    $('#pendingTable').DataTable({ responsive: true, autoWidth: false, order: [[6, 'desc']] });

    // Details modal
    $('.view-btn').on('click', function () {
        $('#d_name').text($(this).data('name'));
        $('#d_email').text($(this).data('email'));
        $('#d_gender').text($(this).data('gender') || '—');
        $('#d_age').text($(this).data('age') || '—');
        $('#d_contact').text($(this).data('contact') || '—');
        $('#d_position').text($(this).data('position') || '—');
        $('#d_designation').text($(this).data('designation') || '—');
        $('#d_salary').text($(this).data('salary') || '—');
        $('#d_office').text($(this).data('office'));
        $('#d_division').text($(this).data('division'));
        $('#d_region').text($(this).data('region'));
    });

    // Reject modal
    $('[data-target="#rejectModal"]').on('click', function () {
        $('#reject_id').val($(this).data('id'));
        $('#reject_name').text($(this).data('name'));
    });
});
</script>
}
