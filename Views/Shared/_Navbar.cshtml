@* _Navbar.cshtml — Top navigation bar shared by all roles
   Gets user info from Session via ViewBag (set in controllers)
*@

<nav class="main-header navbar navbar-expand navbar-white navbar-light">

    @* Left side — sidebar toggle + brand name *@
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                <i class="fas fa-bars"></i>
            </a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="#" class="nav-link">
                <strong>DENR L&amp;D Hub</strong>
            </a>
        </li>
    </ul>

    @* Right side — role switcher + user info + logout *@
    <ul class="navbar-nav ml-auto">

        @* Role Switcher — only shown if user has more than 1 role *@
        @await Html.PartialAsync("_RoleSwitcher")

        @* User profile dropdown *@
        <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#">
                @* Profile photo or default icon *@
                @if (!string.IsNullOrEmpty(ViewBag.UserPhoto as string))
                {
                    <img src="~/uploads/photos/@ViewBag.UserPhoto" class="img-circle elevation-2" alt="Profile"
                         style="width:30px;height:30px;object-fit:cover;" />
                }
                else
                {
                    <i class="fas fa-user-circle fa-lg"></i>
                }
                <span class="ml-1">@ViewBag.UserName</span>
            </a>
            <div class="dropdown-menu dropdown-menu-right">
              @{
   var currentRole = Context.Session.GetString("UserRole");
  var profileUrl = currentRole switch
{
    "Admin"          => Url.Action("AccountSettings", "Admin"),
    _                => Url.Action("Profile", "Employee")
};
}
<a href="@profileUrl" class="dropdown-item">
    <i class="fas fa-user mr-2"></i> My Profile
</a>
                <div class="dropdown-divider"></div>
                <a asp-controller="Home" asp-action="Logout" class="dropdown-item text-danger">
                    <i class="fas fa-sign-out-alt mr-2"></i> Logout
                </a>
            </div>
        </li>

    </ul>
</nav>
