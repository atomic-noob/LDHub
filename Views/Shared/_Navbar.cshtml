@* _Navbar.cshtml — Top navigation bar shared by all roles
   Gets user info from Session via ViewBag (set in controllers)
*@

<nav class="main-header navbar navbar-expand navbar-white navbar-light">

    @* Left side — sidebar toggle + brand name *@
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                <i class="fas fa-bars"></i>
            </a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="#" class="nav-link">
                <strong>DENR L&amp;D Hub</strong>
            </a>
        </li>
    </ul>

    @* Right side — role switcher + user info + logout *@
    <ul class="navbar-nav ml-auto">

        @* Notification bell *@
        @if (Context.Session.GetInt32("UserId") != null)
        {
            <li class="nav-item dropdown" id="notifBell">
                <a class="nav-link" data-toggle="dropdown" href="#" title="Notifications">
                    <i class="far fa-bell"></i>
                    <span class="badge badge-danger navbar-badge" id="notifCount" style="display:none;"></span>
                </a>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" style="min-width:320px;">
                    <span class="dropdown-item dropdown-header">Notifications</span>
                    <div class="dropdown-divider"></div>
                    <div id="notifList">
                        <span class="dropdown-item text-muted small">Loading...</span>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a href="@Url.Action("Index", "Notification")" class="dropdown-item dropdown-footer">See all notifications</a>
                </div>
            </li>
        }

        @* Role Switcher — only shown if user has more than 1 role *@
        @await Html.PartialAsync("_RoleSwitcher")

        @* User profile dropdown *@
        <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#">
                @* Profile photo or default icon *@
                @if (!string.IsNullOrEmpty(ViewBag.UserPhoto as string))
                {
                    <img src="~/uploads/photos/@ViewBag.UserPhoto" class="img-circle elevation-2" alt="Profile"
                         style="width:30px;height:30px;object-fit:cover;" />
                }
                else
                {
                    <i class="fas fa-user-circle fa-lg"></i>
                }
                <span class="ml-1">@ViewBag.UserName</span>
            </a>
            <div class="dropdown-menu dropdown-menu-right">
              @{
   var currentRole = Context.Session.GetString("UserRole");
  var profileUrl = currentRole switch
{
    "Admin"          => Url.Action("AccountSettings", "Admin"),
    _                => Url.Action("Profile", "Employee")
};
}
<a href="@profileUrl" class="dropdown-item">
    <i class="fas fa-user mr-2"></i> My Profile
</a>
                <div class="dropdown-divider"></div>
                <a asp-controller="Home" asp-action="Logout" class="dropdown-item text-danger">
                    <i class="fas fa-sign-out-alt mr-2"></i> Logout
                </a>
            </div>
        </li>

    </ul>
</nav>

@if (Context.Session.GetInt32("UserId") != null)
{
    <script>
    (function () {
        var summaryUrl = '@Url.Action("Summary", "Notification")';
        var openUrlTemplate = '@Url.Action("Open", "Notification", new { id = "__ID__" })';
        var countEl = document.getElementById('notifCount');
        var listEl = document.getElementById('notifList');
        if (!countEl || !listEl) return;

        function render(data) {
            if (data.unread > 0) {
                countEl.textContent = data.unread > 99 ? '99+' : data.unread;
                countEl.style.display = '';
            } else {
                countEl.style.display = 'none';
            }

            listEl.innerHTML = '';
            if (!data.items || data.items.length === 0) {
                var empty = document.createElement('span');
                empty.className = 'dropdown-item text-muted small';
                empty.textContent = 'No notifications yet.';
                listEl.appendChild(empty);
                return;
            }

            data.items.forEach(function (n) {
                var a = document.createElement('a');
                a.className = 'dropdown-item' + (n.isRead ? '' : ' bg-light');
                a.href = openUrlTemplate.replace('__ID__', n.id);

                var title = document.createElement('div');
                title.className = (n.isRead ? '' : 'font-weight-bold ') + 'text-wrap small';
                title.textContent = n.title;
                a.appendChild(title);

                if (n.message) {
                    var msg = document.createElement('div');
                    msg.className = 'text-muted small text-wrap';
                    msg.textContent = n.message;
                    a.appendChild(msg);
                }

                var time = document.createElement('div');
                time.className = 'text-muted';
                time.style.fontSize = '11px';
                time.textContent = n.time;
                a.appendChild(time);

                listEl.appendChild(a);
                var hr = document.createElement('div');
                hr.className = 'dropdown-divider';
                listEl.appendChild(hr);
            });
        }

        function load() {
            fetch(summaryUrl, { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) { if (d) render(d); })
                .catch(function () { /* ignore network errors */ });
        }

        load();
        setInterval(load, 60000);
    })();
    </script>
}
