@* _RoleSwitcher.cshtml
   Shows a dropdown ONLY if the user has more than 1 role
   Lets internal users switch between Employee, CourseManager, Raam
*@

@{
    // UserRoles is stored in session as comma-separated string
    // e.g. "Employee,CourseManager,Raam"
    var rolesString = Context.Session.GetString("UserRoles") ?? "";
    var userRoles = rolesString.Split(',')
                               .Where(r => !string.IsNullOrEmpty(r))
                               .ToList();
    var activeRole = Context.Session.GetString("UserRole") ?? "";
}

@* Only show if user has more than 1 role *@
@if (userRoles.Count > 1)
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">
            <i class="fas fa-exchange-alt mr-1"></i>
            <span>@activeRole</span>
        </a>
        <div class="dropdown-menu">
            <h6 class="dropdown-header">Switch Role</h6>
            @foreach (var role in userRoles)
            {
                var isActive = role == activeRole ? "font-weight-bold text-success" : "";
                <form asp-controller="Home" asp-action="SwitchRole" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="@role" />
                    <button type="submit" class="dropdown-item @isActive">
                        <i class="fas fa-user-tag mr-2"></i> @role
                        @if (role == activeRole)
                        {
                            <i class="fas fa-check ml-1 text-success"></i>
                        }
                    </button>
                </form>
            }
        </div>
    </li>
}