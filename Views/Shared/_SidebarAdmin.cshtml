@* _SidebarAdmin.cshtml — Admin Left Sidebar *@

<aside class="main-sidebar sidebar-dark-success elevation-4">

    <a href="#" class="brand-link">
        <img src="~/dist/img/denrlogo.jpg" alt="DENR Logo" class="brand-image img-circle elevation-3"
             style="opacity:.8">
            <span class="brand-text font-weight-light">L&amp;D Hub</span>
        </a>

        <div class="sidebar">

            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    @if (!string.IsNullOrEmpty(ViewBag.UserPhoto as string))
                    {
                        <img src="~/uploads/photos/@ViewBag.UserPhoto" class="img-circle elevation-2" alt="User Image"
                             style="width:34px;height:34px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="~/dist/img/user2-160x160.jpg" class="img-circle elevation-2" alt="User Image" />
                    }
                </div>
                <div class="info">
                    <a href="#" class="d-block">@ViewBag.UserName</a>
                    <small class="text-muted">Admin</small>
                </div>
            </div>

            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                    @* Dashboard *@
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link">
                            <i class="nav-icon fas fa-tachometer-alt"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>

                    @* Manage Users *@
                    <li class="nav-item has-treeview">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-users"></i>
                            <p>Manage Users <i class="right fas fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="Employees" class="nav-link">
                                    <i class="fas fa-user-check nav-icon"></i>
                                    <p>Employees</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="PendingEmployees" class="nav-link">
                                    <i class="fas fa-user-clock nav-icon"></i>
                                    <p>Pending Employees</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="ResourcePersons" class="nav-link">
                                    <i class="fas fa-chalkboard-teacher nav-icon"></i>
                                    <p>Subject Matter Expert (Outsource)</p>
                                </a>
                            </li>
                        </ul>
                    </li>

                    @* Locations *@
                    <li class="nav-item has-treeview">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-map-marker-alt"></i>
                            <p>Locations <i class="right fas fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="Regions" class="nav-link">
                                    <i class="fas fa-globe-asia nav-icon"></i>
                                    <p>Manage Regions</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="Offices" class="nav-link">
                                    <i class="fas fa-building nav-icon"></i>
                                    <p>Manage Offices</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="Divisions" class="nav-link">
                                    <i class="fas fa-sitemap nav-icon"></i>
                                    <p>Manage Divisions</p>
                                </a>
                            </li>
                        </ul>
                    </li>

                    @* Trainings *@
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Trainings" class="nav-link">
                            <i class="nav-icon fas fa-book"></i>
                            <p>Trainings</p>
                        </a>
                    </li>

                    @* Free Trainings *@
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="FreeTrainings" class="nav-link">
                            <i class="nav-icon fas fa-certificate"></i>
                            <p>Free Trainings</p>
                        </a>
                    </li>

                    @* Announcements *@
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Announcements" class="nav-link">
                            <i class="nav-icon fas fa-bullhorn"></i>
                            <p>Announcements</p>
                        </a>
                    </li>

                    @* Reports *@
                    <li class="nav-item has-treeview">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-chart-bar"></i>
                            <p>Reports <i class="right fas fa-angle-left"></i></p>
                        </a>
                        <ul class="nav nav-treeview">
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="ReportUsers" class="nav-link">
                                    <i class="fas fa-users nav-icon"></i>
                                    <p>List of Users</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="ReportIdp" class="nav-link">
                                    <i class="fas fa-file-contract nav-icon"></i>
                                    <p>IDP Report</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="ReportTraining" class="nav-link">
                                    <i class="fas fa-file-contract nav-icon"></i>
                                    <p>Training Report</p>
                                </a>
                            </li>
                        </ul>
                    </li>

                    @* FAQs *@
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Faqs" class="nav-link">
                            <i class="nav-icon fas fa-question-circle"></i>
                            <p>FAQs</p>
                        </a>
                    </li>

                </ul>
            </nav>

        </div>
    </aside>