@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside class="main-sidebar sidebar-dark-warning elevation-4">
    <a href="#" class="brand-link">
        <img src="~/dist/img/denrlogo.jpg" alt="DENR Logo"
             class="brand-image img-circle elevation-3" style="opacity:.8">
        <span class="brand-text font-weight-light">L&amp;D Hub</span>
    </a>

    <div class="sidebar">
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column"
                data-widget="treeview" role="menu" data-accordion="false">

                <li class="nav-item">
                    <a asp-controller="CourseManager" asp-action="Dashboard"
                       class="nav-link @(controller == "CourseManager" && action == "Dashboard" ? "active" : "")">
                        <i class="nav-icon fas fa-tachometer-alt"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="CourseManager" asp-action="Trainings"
                       class="nav-link @((controller == "CourseManager" && action == "Trainings") || controller == "Training" ? "active" : "")">
                        <i class="nav-icon fas fa-book"></i>
                        <p>Trainings</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Content" asp-action="Modules"
                       class="nav-link @(controller == "Content" && action == "Modules" ? "active" : "")">
                        <i class="nav-icon fas fa-folder"></i>
                        <p>Modules</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Content" asp-action="TestMaker"
                       class="nav-link @(controller == "Content" && action == "TestMaker" ? "active" : "")">
                        <i class="nav-icon fas fa-question-circle"></i>
                        <p>Post and Pre Test</p>
                    </a>
                </li>


              <li class="nav-item">
    <a asp-controller="Training" asp-action="TrainingReport"
       class="nav-link @(controller == "Training" && action == "TrainingReport" ? "active" : "")">
        <i class="nav-icon fas fa-chart-line"></i>
        <p>Training Report</p>
    </a>
</li>

                <li class="nav-item">
                    <a asp-controller="CourseManager" asp-action="EvaluationDashboard"
                       class="nav-link @(controller == "CourseManager" && action == "EvaluationDashboard" ? "active" : "")">
                        <i class="nav-icon fas fa-chart-line"></i>
                        <p>Evaluation Dashboard</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="CourseManager" asp-action="AutoPdf"
                       class="nav-link @(controller == "CourseManager" && action == "AutoPdf" ? "active" : "")">
                        <i class="nav-icon fas fa-file-pdf"></i>
                        <p>Auto PDF</p>
                    </a>
                </li>

            </ul>
        </nav>
    </div>
</aside>
