<aside class="main-sidebar sidebar-dark-info elevation-4">
    <a href="#" class="brand-link">
        <img src="~/dist/img/denrlogo.jpg" alt="DENR Logo"
             class="brand-image img-circle elevation-3" style="opacity:.8">
        <span class="brand-text font-weight-light">L&amp;D Hub</span>
    </a>
    <div class="sidebar">
        <div class="user-panel mt-3 pb-3 mb-3 d-flex">
            <div class="image">
                @if (!string.IsNullOrEmpty(ViewBag.UserPhoto as string))
                {
                    <img src="~/uploads/photos/@ViewBag.UserPhoto"
                         class="img-circle elevation-2" alt="User Image"
                         style="width:34px;height:34px;object-fit:cover;" />
                }
                else
                {
                    <img src="~/dist/img/user2-160x160.jpg"
                         class="img-circle elevation-2" alt="User Image" />
                }
            </div>
            <div class="info">
                <a href="#" class="d-block">@ViewBag.UserName</a>
                <small class="text-muted">Resource Person</small>
            </div>
        </div>
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column"
                data-widget="treeview" role="menu" data-accordion="false">

                <li class="nav-item">
                    <a asp-controller="ResourcePerson" asp-action="Dashboard" class="nav-link">
                        <i class="nav-icon fas fa-tachometer-alt"></i>
                        <p>Dashboard</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="ResourcePerson" asp-action="Grades" class="nav-link">
                        <i class="nav-icon fas fa-clipboard-list"></i>
                        <p>Assign Grades</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="ResourcePerson" asp-action="TrainingHistory" class="nav-link">
                        <i class="nav-icon fas fa-history"></i>
                        <p>Training History</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="ResourcePerson" asp-action="TestMaker" class="nav-link">
                        <i class="nav-icon fas fa-question-circle"></i>
                        <p>Post and Pre Test</p>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-controller="ResourcePerson" asp-action="TestResult" class="nav-link">
                        <i class="nav-icon fas fa-chart-bar"></i>
                        <p>Test Result</p>
                    </a>
                </li>

            </ul>
        </nav>
    </div>
</aside>