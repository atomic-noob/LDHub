@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Assign Resource Persons";
    var training = ViewBag.Training as LDHub.Models.Training;
    var availableUsers = ViewBag.AvailableUsers as List<LDHub.Models.User>;
    var assignedInstructors = ViewBag.AssignedInstructors as List<LDHub.Models.TrainingInstructor>;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1>Assign Resource Persons</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index">Trainings</a></li>
                    <li class="breadcrumb-item active">Assign Resource Persons</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-book mr-2"></i>@training.TrainingTitle
                    <span class="badge badge-info ml-2">@training.TrainingCode</span>
                </h3>
            </div>
        </div>

        <div class="row">
            <!-- Available Users -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-users mr-2"></i>Available Employees</h3>
                    </div>
                    <div class="card-body">
                        <form asp-action="AssignResourcePerson" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="trainingId" value="@training.TrainingId" />

                            <table class="table table-bordered table-hover table-sm">
                                <thead class="thead-dark">
                                    <tr>
                                        <th width="40px">
                                            <input type="checkbox" id="selectAll" />
                                        </th>
                                        <th>Name</th>
                                        <th>Office</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (availableUsers != null && availableUsers.Count > 0)
                                    {
                                        @foreach (var user in availableUsers)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" name="userIds" value="@user.UserId" class="instructor-check" />
                                                </td>
                                                <td>@user.FirstName @user.LastName</td>
                                                <td>@(user.OfficeId?.ToString() ?? "N/A")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted">No available employees</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="fas fa-chalkboard-teacher mr-1"></i> Assign Selected
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Assigned Resource Persons -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chalkboard-teacher mr-2"></i>Assigned Resource Persons
                            <span class="badge badge-success ml-2">@assignedInstructors?.Count</span>
                        </h3>
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered table-hover table-sm">
                            <thead class="thead-dark">
                                <tr>
                                    <th>#</th>
                                    <th>Name</th>
                                    <th>Assigned Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (assignedInstructors != null && assignedInstructors.Count > 0)
                                {
                                    int i = 1;
                                    @foreach (var inst in assignedInstructors)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@inst.User?.FirstName @inst.User?.LastName</td>
                                            <td>@inst.AssignedDate.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">No resource persons assigned yet</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left mr-1"></i> Back to Trainings
        </a>

    </div>
</section>

@section Scripts {
<script>
    $('#selectAll').on('change', function() {
        $('.instructor-check').prop('checked', $(this).prop('checked'));
    });
</script>
}