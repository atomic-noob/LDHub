@model LDHub.Models.Training
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Training Details";
}

@section Styles {
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Training Details</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index">Trainings</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="icon fas fa-check"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                <i class="icon fas fa-ban"></i> @TempData["Error"]
            </div>
        }

        @* ── Training Info ── *@
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-graduation-cap mr-2"></i> @Model.TrainingTitle
                </h3>
                <div class="card-tools">
                    <a asp-action="Edit" asp-route-id="@Model.TrainingId"
                       class="btn btn-warning btn-sm">
                        <i class="fas fa-edit mr-1"></i> Edit
                    </a>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left mr-1"></i> Back
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th width="40%">Training Code</th>
                                <td>@Model.TrainingCode</td>
                            </tr>
                            <tr>
                                <th>Location</th>
                                <td>@(Model.Location ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Start Date</th>
                                <td>@Model.StartDate?.ToString("MMM dd, yyyy")</td>
                            </tr>
                            <tr>
                                <th>End Date</th>
                                <td>@Model.EndDate?.ToString("MMM dd, yyyy")</td>
                            </tr>
                            <tr>
                                <th>Training Hours</th>
                                <td>@Model.TrainingHrs</td>
                            </tr>
                            <tr>
                                <th>Status</th>
                                <td>
                                    @{
                                        var status = "Scheduled";
                                        var badge  = "badge-success";
                                        if (DateTime.Now >= Model.StartDate && DateTime.Now <= Model.EndDate)
                                        { status = "Ongoing"; badge = "badge-primary"; }
                                        else if (DateTime.Now > Model.EndDate)
                                        { status = "Ended"; badge = "badge-danger"; }
                                    }
                                    <span class="badge @badge">@status</span>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th width="40%">Description</th>
                                <td>@(Model.Description ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Development Act</th>
                                <td>@(Model.DevelopmentAct ?? "—")</td>
                            </tr>
                            <tr>
                                <th>MOVs</th>
                                <td>@(Model.MOVs ?? "—")</td>
                            </tr>
                            <tr>
                                <th>Success Indicator</th>
                                <td>@(Model.SuccessIndicator ?? "—")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        @* ── Add this section at the bottom of Details.cshtml ── *@
@* Place it right before the Back button row *@

<hr />

<div class="row">

    @* Assigned Participants *@
    <div class="col-md-6">
        <div class="card card-outline card-success shadow-sm">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-users mr-2"></i>
                    Participants
                    <span class="badge badge-success ml-2">@Model.TrainingParticipants.Count</span>
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!Model.TrainingParticipants.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-user-slash fa-2x mb-2" style="opacity:.3;"></i>
                        <p class="mb-0">No participants assigned yet.</p>
                    </div>
                }
                else
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int pi = 1; }
                            @foreach (var tp in Model.TrainingParticipants.OrderBy(tp => tp.User?.LastName))
                            {
                                var statusBadge = tp.CompletionStatus switch
                                {
                                    "Completed"   => "badge-success",
                                    "In Progress" => "badge-primary",
                                    "Failed"      => "badge-danger",
                                    _             => "badge-secondary"
                                };
                                <tr>
                                    <td>@pi</td>
                                    <td>
                                        <strong>@tp.User?.FirstName @tp.User?.LastName</strong>
                                        <small class="text-muted d-block">@tp.User?.Email</small>
                                    </td>
                                    <td>
                                        <span class="badge @badge">@tp.CompletionStatus</span>
                                    </td>
                                </tr>
                                pi++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @* Assigned Resource Persons *@
    <div class="col-md-6">
        <div class="card card-outline card-info shadow-sm">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-chalkboard-teacher mr-2"></i>
                    Resource Persons (SME)
                    <span class="badge badge-info ml-2">@Model.TrainingInstructors.Count</span>
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                @if (!Model.TrainingInstructors.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-user-slash fa-2x mb-2" style="opacity:.3;"></i>
                        <p class="mb-0">No resource persons assigned yet.</p>
                    </div>
                }
                else
                {
                    <table class="table table-sm table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Organization / Office</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int ri = 1; }
                            @foreach (var ti in Model.TrainingInstructors.OrderBy(ti => ti.User?.LastName))
                            {
                                <tr>
                                    <td>@ri</td>
                                    <td>
                                        <strong>@ti.User?.FirstName @ti.User?.LastName</strong>
                                        <small class="text-muted d-block">@ti.User?.Email</small>
                                    </td>
                                    <td>
                                        @if (ti.User?.IsExternal == true)
                                        {
                                            <span class="badge badge-secondary">
                                                <i class="fas fa-external-link-alt mr-1"></i>Outsource
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info">
                                                <i class="fas fa-building mr-1"></i>Internal
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (ti.User?.IsExternal == true)
                                        {
                                            @(ti.User?.Organization ?? "—")
                                        }
                                        else
                                        {
                                            @(ti.User?.Office?.OfficeName ?? "—")
                                        }
                                    </td>
                                </tr>
                                ri++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

</div>


       

    </div>
</section>

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(function () {
            $('#participantsTable').DataTable({ responsive: true, autoWidth: false });
            $('#instructorsTable').DataTable({ responsive: true, autoWidth: false });
        });
    </script>
}