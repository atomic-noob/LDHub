@model IEnumerable<LDHub.Models.Training>
@{
  Layout = "~/Views/Shared/_Layout.cshtml";
  ViewData["Title"] = "Trainings";
}
@section Styles
{
  <!-- AdminLTE 3 plugin assets; load these only once per page. -->
  <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css" />
  <link rel="stylesheet" href="~/plugins/datatables-responsive/css/responsive.bootstrap4.min.css" />
  <link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css" />
  <link rel="stylesheet" href="~/plugins/datatables-buttons/css/buttons.bootstrap4.min.css" />
}

<section class="content-header">
  <div class="container-fluid">
    <div class="row mb-2 align-items-center">
      
    </div>
  </div>
</section>
<section class="content">
  <div class="container-fluid">
    @if (TempData["Success"] != null)
    {
      <div id="successAlert"
        class="alert alert-success alert-dismissible fade show shadow-sm"
        role="alert">
        <div class="d-flex align-items-center">
          <div class="mr-3">
            <i class="fas fa-check-circle fa-lg">
            </i>
          </div>
          <div class="flex-grow-1">
            <strong>
              Success!
            </strong>
            <span class="ml-1">
              @TempData["Success"]
            </span>
          </div>
          <button type="button"
              class="close"
              data-dismiss="alert"
              aria-label="Close">
            <span aria-hidden="true">
              &times;
            </span>
          </button>
        </div>
      </div>
    }
    @if (TempData["Error"] != null)
    {
      <div id="errorAlert"
        class="alert alert-danger alert-dismissible fade show shadow-sm"
        role="alert">
        <div class="d-flex align-items-center">
          <div class="mr-3">
            <i class="fas fa-exclamation-circle fa-lg">
            </i>
          </div>
          <div class="flex-grow-1">
            <strong>
              Error!
            </strong>
            <span class="ml-1">
              @TempData["Error"]
            </span>
          </div>
          <button type="button"
              class="close"
              data-dismiss="alert"
              aria-label="Close">
            <span aria-hidden="true">
              &times;
            </span>
          </button>
        </div>
      </div>
    }
    <div class="card card-outline card-success shadow-sm">
      <div class="card-header bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
          <h3 class="card-title font-weight-bold mb-0">
            <i class="fas fa-list mr-2 text-success">
            </i>
            List of Trainings
          </h3>
          <a asp-controller="Training"
            asp-action="Create"
           class="btn btn-success btn-sm">
            <i class="fas fa-plus mr-1">
            </i>
            New Training
          </a>
        </div>
      </div>
      <div class="card-body">
        <div>
          <table id="trainingsTable" class="table table-bordered table-hover table-striped dt-responsive w-100">
            <thead class="bg-light">
              <tr>
                <th scope="col" class="text-center">
                  #
                </th>
                <th scope="col">
                  Training Code
                </th>
                <th scope="col">
                  Training Title
                </th>
                <th scope="col">
                  Location
                </th>
                <th scope="col" class="text-center">
                  Start Date
                </th>
                <th scope="col" class="text-center">
                  End Date
                </th>
                <th scope="col" class="text-center">
                  Training Hrs
                </th>
                <th scope="col" class="text-center">
                  Status
                </th>
                <th scope="col" class="text-center">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody>
              @if (Model != null && Model.Any())
              {
                var rowNumber = 1;
                foreach (var item in Model)
                {
                  var status = "Scheduled";
                  var badgeClass = "badge-success";
                  var statusIcon = "fa-calendar-alt";
                  if (DateTime.Now >= item.StartDate && DateTime.Now <= item.EndDate)
                  {
                    status = "Ongoing";
                    badgeClass = "badge-primary";
                    statusIcon = "fa-play-circle";
                  }
                  else if (DateTime.Now > item.EndDate)
                  {
                    status = "Ended";
                    badgeClass = "badge-danger";
                    statusIcon = "fa-check-circle";
                  }
                  <tr>
                    <td class="text-center align-middle">
                      @rowNumber
                    </td>
                    <td class="align-middle">
                      <span class="font-weight-bold text-success">
                        @item.TrainingCode
                      </span>
                    </td>
                    <td class="align-middle">
                      <strong>
                        @item.TrainingTitle
                      </strong>
                    </td>
                    <td class="align-middle">
                      @if (!string.IsNullOrWhiteSpace(item.Location))
                      {
                        <i class="fas fa-map-marker-alt text-danger mr-1">
                        </i>
                        @item.Location
                      }
                      else
                      {
                        <span class="text-muted">
                          N/A
                        </span>
                      }
                    </td>
                    <td class="text-center align-middle text-nowrap" data-order="@(item.StartDate?.ToString("yyyyMMdd") ?? "0")">
                      @if (item.StartDate.HasValue)
                      {
                        <i class="far fa-calendar-alt text-muted mr-1">
                        </i>
                        @(item.StartDate.Value.ToString("MMM dd, yyyy"))
                      }
                      else
                      {
                        <span class="text-muted">
                          TBD
                        </span>
                      }
                    </td>
                    <td class="text-center align-middle text-nowrap" data-order="@(item.EndDate?.ToString("yyyyMMdd") ?? "0")">
                      @if (item.EndDate.HasValue)
                      {
                        <i class="far fa-calendar-check text-muted mr-1">
                        </i>
                        @(item.EndDate.Value.ToString("MMM dd, yyyy"))
                      }
                      else
                      {
                        <span class="text-muted">
                          TBD
                        </span>
                      }
                    </td>
                    <td class="text-center align-middle" data-order="@item.TrainingHrs">
                      <span class="badge badge-light border px-2 py-1">
                        <i class="far fa-clock mr-1">
                        </i>
                        @item.TrainingHrs hrs
                      </span>
                    </td>
                    <td class="text-center align-middle" data-search="@status">
                      <span class="badge @badgeClass px-2 py-2">
                        <i class="fas @statusIcon mr-1">
                        </i>
                        @status
                      </span>
                    </td>
                    <td class="text-center align-middle">
                      <div class="btn-group" role="group" aria-label="Training actions">
                        <a class="btn btn-outline-info btn-sm"
                         asp-controller="Training" asp-action="Details"
                         asp-route-id="@item.TrainingId" title="View Details">
                          <i class="fas fa-eye" aria-hidden="true"></i>
                          <span class="sr-only">View Details</span>
                        </a>
                        <a class="btn btn-outline-warning btn-sm"
                         asp-controller="Training" asp-action="Edit"
                         asp-route-id="@item.TrainingId" title="Edit Training">
                          <i class="fas fa-edit" aria-hidden="true"></i>
                          <span class="sr-only">Edit Training</span>
                        </a>
                        <a class="btn btn-outline-success btn-sm"
                         asp-controller="Training" asp-action="AssignParticipant"
                         asp-route-id="@item.TrainingId" title="Assign Participant">
                          <i class="fas fa-user-plus" aria-hidden="true"></i>
                          <span class="sr-only">Assign Participant</span>
                        </a>
                        <a class="btn btn-outline-primary btn-sm"
                         asp-controller="Training" asp-action="AssignResourcePerson"
                         asp-route-id="@item.TrainingId" title="Assign Resource Person">
                          <i class="fas fa-chalkboard-teacher" aria-hidden="true"></i>
                          <span class="sr-only">Assign Resource Person</span>
                        </a>
                      </div>
                    </td>
                  </tr>
                  rowNumber++;
                }
              }
            </tbody>
          </table>
        </div>
      </div>
      @if (Model != null && Model.Any())
      {
        <div class="card-footer bg-white">
          <small class="text-muted">
            <i class="fas fa-info-circle mr-1">
            </i>
            Total Trainings:
            <strong>
              @Model.Count()
            </strong>
          </small>
        </div>
      }
    </div>
  </div>
</section>
@section Scripts
{
  <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
  <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
  <script src="~/plugins/datatables-responsive/js/dataTables.responsive.min.js"></script>
  <script src="~/plugins/datatables-responsive/js/responsive.bootstrap4.min.js"></script>

  <script>
    $(function () {
      $('#trainingsTable').DataTable({
        responsive: true,
        autoWidth: false,
        paging: true,
        lengthChange: true,
        searching: true,
        ordering: true,
        info: true,
        pageLength: 10,
        lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'All']],
        order: [],
        pagingType: 'full_numbers',
        dom:
          '<"row align-items-center mb-2"<"col-md-6"l><"col-md-6"f>>' +
          '<"row"<"col-12"tr>>' +
          '<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
        columnDefs: [
          { targets: [0, 8], orderable: false, searchable: false },
          { targets: [4, 5, 6], type: 'num' },
          { targets: 2, responsivePriority: 1 },
          { targets: 8, responsivePriority: 2 },
          { targets: 7, responsivePriority: 3 }
        ],
        language: {
          search: 'Search:',
          searchPlaceholder: 'Search trainings...',
          lengthMenu: 'Show _MENU_ trainings',
          info: 'Showing _START_ to _END_ of _TOTAL_ trainings',
          infoEmpty: 'Showing 0 trainings',
          infoFiltered: '(filtered from _MAX_ total trainings)',
          emptyTable: 'No trainings found. Use New Training to create a record.',
          zeroRecords: 'No matching trainings found.',
          paginate: { first: 'First', previous: 'Previous', next: 'Next', last: 'Last' }
        }
      });

      function closeAlert(selector, delay) {
        if ($(selector).length) {
          setTimeout(function () {
            $(selector).alert('close');
          }, delay);
        }
      }
      closeAlert('#successAlert', 5000);
      closeAlert('#errorAlert', 7000);
    });
  </script>
}